@model Llanteria.Models.Marca

@{
    ViewData["Title"] = "Nueva Marca";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white text-center">
                <h5 class="mb-0">Registrar Fabricante</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Marca</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Michelin, Goodyear..." required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Guardar Marca</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>