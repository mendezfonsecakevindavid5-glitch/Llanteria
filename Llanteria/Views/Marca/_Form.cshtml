@model Llanteria.Models.Marca

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <label asp-for="Nombre" class="form-label">Nombre de la marca</label>
    <input asp-for="Nombre" class="form-control" maxlength="100" placeholder="Ej. Michelin" autofocus />
    <span asp-validation-for="Nombre" class="text-danger small"></span>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
