@model Llanteria.Models.Pqrs
@{
    ViewData["Title"] = "Peticiones, quejas, reclamos y sugerencias";
    ViewData["Subtitulo"] = "Cuéntanos tu caso. Respondemos en máximo " + Llanteria.Models.Pqrs.DiasHabilesRespuesta + " días hábiles.";
}
<partial name="_Inicio" />

<form asp-controller="Legal" asp-action="EnviarPqrs" method="post">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="Tipo">Tipo de solicitud<span class="required-asterisk">*</span></label>
            <select name="Tipo" id="Tipo" class="form-select" required>
                @foreach (var t in Llanteria.Models.Pqrs.Tipos)
                {
                    <option value="@t" selected="@(Model.Tipo == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-8">
            <label class="form-label" for="Nombre">Nombre completo<span class="required-asterisk">*</span></label>
            <input name="Nombre" id="Nombre" value="@Model.Nombre" class="form-control" maxlength="100" required />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="Correo">Correo para responderte<span class="required-asterisk">*</span></label>
            <input name="Correo" id="Correo" value="@Model.Correo" type="email" class="form-control" maxlength="100" required />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="Telefono">Teléfono</label>
            <input name="Telefono" id="Telefono" value="@Model.Telefono" class="form-control" maxlength="25" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="NumeroDocumento">Documento</label>
            <input name="NumeroDocumento" id="NumeroDocumento" value="@Model.NumeroDocumento" class="form-control" maxlength="20" />
        </div>
        <div class="col-12">
            <label class="form-label" for="Asunto">Asunto<span class="required-asterisk">*</span></label>
            <input name="Asunto" id="Asunto" value="@Model.Asunto" class="form-control" maxlength="120" required />
        </div>
        <div class="col-12">
            <label class="form-label" for="Mensaje">Cuéntanos tu caso<span class="required-asterisk">*</span></label>
            <textarea name="Mensaje" id="Mensaje" rows="6" class="form-control" maxlength="1500" minlength="20" required placeholder="Incluye fechas, número de pedido o factura y lo que esperas que hagamos.">@Model.Mensaje</textarea>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="aceptaDatos" id="aceptaDatos" value="true" required />
                <label class="form-check-label small" for="aceptaDatos">Autorizo el tratamiento de mis datos personales para gestionar esta solicitud, según la <a asp-controller="Legal" asp-action="Privacidad" target="_blank">política de tratamiento de datos</a>.<span class="required-asterisk">*</span></label>
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="legal-btn">Radicar solicitud</button>
        </div>
    </div>
</form>

<partial name="_Fin" />
