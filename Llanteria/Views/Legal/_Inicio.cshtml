@* Marco compartido de las páginas legales. Se cierra con _Fin.
   - Términos, tratamiento de datos, garantía y devoluciones se muestran como PDF (LegalController.DocumentoPdf): sin cabecera del sitio.
   - Preguntas frecuentes y PQRS son páginas normales del sitio, sin tabla de contenidos para cambiar entre vistas. *@
@{
    var titulo = ViewData["Title"] as string ?? "";
    var subtitulo = ViewData["Subtitulo"] as string ?? "";
    bool esPdf = Context.Items["LegalPdf"] is true;
}
@if (esPdf)
{
    <h1 class="doc-titulo">@titulo</h1>
    <p class="doc-subtitulo">@subtitulo</p>
    @Html.Raw("<div class=\"doc-cuerpo\">")
}
else
{
    <link rel="stylesheet" href="~/css/paginas/legal.css" asp-append-version="true" />
    @Html.Raw("<div class=\"legal-wrap\">")
    <div class="legal-head">
        <h1>@titulo</h1>
        <p>@subtitulo</p>
    </div>
    @Html.Raw("<div class=\"legal-card\">")
}
