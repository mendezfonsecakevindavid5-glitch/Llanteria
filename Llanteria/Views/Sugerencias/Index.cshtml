@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Sugerencia>

@{
    ViewData["Title"] = "Sugerencias";
    string estado = ViewBag.Estado ?? "";
    string Clase(string e) => e switch { "Nueva" => "tag-warn", "Revisada" => "tag-neutral", _ => "tag-ok" };
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Sugerencias", "Lo que los visitantes proponen para mejorar el sitio."))

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><span class="stat-icon"><i class="fa-solid fa-lightbulb"></i></span><div class="label">Nuevas</div><div class="value">@ViewBag.Nuevas</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><span class="stat-icon"><i class="fa-solid fa-star"></i></span><div class="label">Calificación promedio</div><div class="value">@(((double)ViewBag.Promedio).ToString("0.0"))</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <select name="estado" class="form-select form-select-sm" style="max-width:170px">
                <option value="">Todos los estados</option>
                @foreach (var e in Llanteria.Models.Sugerencia.Estados) { <option value="@e" selected="@(estado == e)">@e</option> }
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead><tr><th>Fecha</th><th>Área</th><th>Sugerencia</th><th>Calif.</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td class="money">@s.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@s.Area</td>
                        <td style="white-space:pre-line;min-width:280px">@s.Mensaje<div class="cell-sub">@(s.Nombre ?? "Anónimo")@(s.Correo != null ? " · " + s.Correo : "")</div></td>
                        <td class="money">@s.Calificacion/5</td>
                        <td>
                            <form asp-action="CambiarEstado" method="post" class="d-flex gap-1 align-items-center">
                                <input type="hidden" name="id" value="@s.Id" />
                                <select name="estado" class="form-select form-select-sm" style="min-width:110px" onchange="this.form.submit()" aria-label="Estado de la sugerencia">
                                    @foreach (var e in Llanteria.Models.Sugerencia.Estados) { <option value="@e" selected="@(s.Estado == e)">@e</option> }
                                </select>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="empty-state">Aún no hay sugerencias.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>
