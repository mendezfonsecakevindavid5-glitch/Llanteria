@* Paginación para los listados. Conserva los filtros de la URL (buscar, estado, etc.). *@
@model (int Pagina, int TotalPaginas, int Total)

@if (Model.TotalPaginas > 1)
{
    string Enlace(int p)
    {
        var q = Context.Request.Query
            .Where(k => !string.Equals(k.Key, "pagina", StringComparison.OrdinalIgnoreCase))
            .Select(k => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(k.Value.ToString())}")
            .Append($"pagina={p}");
        return Context.Request.Path + "?" + string.Join("&", q);
    }

    var desde = Math.Max(1, Model.Pagina - 2);
    var hasta = Math.Min(Model.TotalPaginas, Model.Pagina + 2);

    <nav class="pager" aria-label="Paginación">
        <span class="pager-info">Página @Model.Pagina de @Model.TotalPaginas · @Model.Total registros</span>
        <ul>
            <li class="@(Model.Pagina == 1 ? "disabled" : "")"><a href="@Enlace(Math.Max(1, Model.Pagina - 1))" aria-label="Anterior"><i class="fa-solid fa-chevron-left"></i></a></li>
            @for (var p = desde; p <= hasta; p++)
            {
                <li class="@(p == Model.Pagina ? "active" : "")"><a href="@Enlace(p)">@p</a></li>
            }
            <li class="@(Model.Pagina == Model.TotalPaginas ? "disabled" : "")"><a href="@Enlace(Math.Min(Model.TotalPaginas, Model.Pagina + 1))" aria-label="Siguiente"><i class="fa-solid fa-chevron-right"></i></a></li>
        </ul>
    </nav>
}
