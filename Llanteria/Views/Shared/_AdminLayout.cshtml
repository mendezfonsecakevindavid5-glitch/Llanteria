@{
    var ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var act = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var isAdmin = User.IsInRole("Administrador");
    var nombre = User.Identity?.Name ?? "Usuario";

    var items = new List<(string C, string A, string Icon, string Text, bool AdminOnly, string Group)>
    {
        ("Dashboard", "Index", "fa-chart-line", "Panel", false, "General"),
        // Al entrar con "Cuenta" desde el menú del avatar, este ítem queda marcado como si lo hubieran elegido aquí.
        ("User", "Perfil", "fa-circle-user", "Mi perfil", false, "General"),
        ("Factura", "Index", "fa-file-invoice-dollar", "Ventas", false, "Operación"),
        ("Cliente", "Index", "fa-users", "Clientes", false, "Operación"),
        ("Cliente", "GestionPuntos", "fa-star", "Puntos de clientes", false, "Operación"),
        ("Vehiculo", "Index", "fa-car", "Vehículos", false, "Operación"),
        ("Citas", "Index", "fa-calendar-check", "Citas", false, "Operación"),
        ("Empresas", "Solicitudes", "fa-building", "Solicitudes de empresas", false, "Operación"),
        ("Resenias", "Index", "fa-comments", "Opiniones", false, "Operación"),
        ("Inventario", "Index", "fa-boxes-stacked", "Existencias", false, "Inventario"),
        ("Producto", "Index", "fa-box", "Productos", true, "Inventario"),
        ("Marca", "Index", "fa-tag", "Marcas", true, "Inventario"),
        ("Bodega", "Index", "fa-warehouse", "Bodegas", true, "Inventario"),
        ("Proveedore", "Index", "fa-industry", "Proveedores", true, "Inventario"),
        ("TipoServicio", "Index", "fa-screwdriver-wrench", "Servicios", true, "Inventario"),
        ("Gasto", "Index", "fa-money-bill-wave", "Gastos", true, "Administración"),
        ("CatalogoIncentivo", "Index", "fa-gift", "Incentivos", true, "Administración"),
        ("Empleado", "Index", "fa-id-card", "Empleados", true, "Administración"),
        ("Usuario", "Index", "fa-user-gear", "Usuarios", true, "Administración"),
        ("Log", "Index", "fa-clipboard-list", "Registro de actividad", true, "Administración"),
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/avatar-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        :root {
            --llanteria-primary: #C92B0A;
            --llanteria-dark: #09090B;
        }
        body.admin {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8F9FA;
        }
    </style>
</head>
<body class="admin">
    <header class="topbar bg-white shadow-sm py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <button class="toggle d-lg-none btn btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Menú">
                <i class="fa-solid fa-bars"></i>
            </button>
            <span class="brand-matrix">Llantería<small class="ms-1">Valledupar</small></span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="d-none d-md-block text-end lh-sm user-meta">
                <strong>@nombre</strong><br />
                <small class="text-muted">@(isAdmin ? "Administrador" : "Empleado")</small>
            </span>
            @await Component.InvokeAsync("AvatarMenu", new { tamano = 40 })
        </div>
    </header>

    <div class="layout d-flex">
        <aside class="sidebar collapse d-lg-block bg-white border-end p-3" id="sidebar" style="width: 260px; min-height: calc(100vh - 70px);">
            @foreach (var g in items.Where(i => !i.AdminOnly || isAdmin).GroupBy(i => i.Group))
            {
                <div class="sidebar-group text-uppercase text-muted fw-bold small mt-3 mb-2 px-2">@g.Key</div>
                foreach (var i in g)
                {
                    var activo = ctrl == i.C && (act == i.A || (i.A == "Index" && act != "GestionPuntos"));
                    <a class="sidebar-link d-flex align-items-center gap-2 py-2 px-3 rounded-2 text-decoration-none @(activo ? "active bg-danger text-white fw-bold" : "text-dark")" asp-controller="@i.C" asp-action="@i.A">
                        <i class="fa-solid @i.Icon" style="width: 20px;"></i>@i.Text
                    </a>
                }
            }
            <div class="sidebar-group text-uppercase text-muted fw-bold small mt-4 mb-2 px-2">Sitio</div>
            <a class="sidebar-link d-flex align-items-center gap-2 py-2 px-3 rounded-2 text-decoration-none text-dark" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-globe" style="width: 20px;"></i>Ver página web
            </a>
        </aside>

        <main class="content flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <partial name="_SiteFooter" />

    <form id="delete-form" method="post" class="d-none">@Html.AntiForgeryToken()</form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/protect-forms.js" asp-append-version="true"></script>
    <script src="~/js/avatar-menu.js" asp-append-version="true"></script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>