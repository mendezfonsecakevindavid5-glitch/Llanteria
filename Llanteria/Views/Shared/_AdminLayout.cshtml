@{
    var ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var act = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var isAdmin = User.IsInRole("Administrador");
    var nombre = User.Identity?.Name ?? "Usuario";
    var inicial = nombre.Substring(0, 1).ToUpper();

    var items = new List<(string C, string A, string Icon, string Text, bool AdminOnly, string Group)>
    {
        ("Dashboard", "Index", "fa-chart-line", "Panel", false, "General"),
        ("Factura", "Index", "fa-file-invoice-dollar", "Ventas", false, "Operación"),
        ("Cliente", "Index", "fa-users", "Clientes", false, "Operación"),
        ("Cliente", "GestionPuntos", "fa-star", "Puntos de clientes", false, "Operación"),
        ("Vehiculo", "Index", "fa-car", "Vehículos", false, "Operación"),
        ("Citas", "Index", "fa-calendar-check", "Citas", false, "Operación"),
        ("Inventario", "Index", "fa-boxes-stacked", "Existencias", false, "Inventario"),
        ("Producto", "Index", "fa-box", "Productos", true, "Inventario"),
        ("Marca", "Index", "fa-tag", "Marcas", true, "Inventario"),
        ("Bodega", "Index", "fa-warehouse", "Bodegas", true, "Inventario"),
        ("Proveedore", "Index", "fa-industry", "Proveedores", true, "Inventario"),
        ("TipoServicio", "Index", "fa-screwdriver-wrench", "Servicios", true, "Inventario"),
        ("Gasto", "Index", "fa-money-bill-wave", "Gastos", true, "Administración"),
        ("CatalogoIncentivo", "Index", "fa-gift", "Incentivos", true, "Administración"),
        ("Empleado", "Index", "fa-id-card", "Empleados", true, "Administración"),
        ("Usuario", "Index", "fa-user-gear", "Usuarios", true, "Administración"),
        ("Log", "Index", "fa-clipboard-list", "Registro de actividad", true, "Administración"),
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <header class="topbar">
        <div class="d-flex align-items-center gap-2">
            <button class="toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar" aria-label="Menú">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="brand">LLANTERÍA<span>VALLEDUPAR</span></a>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="User" asp-action="Perfil" class="user">
                <span class="d-none d-md-block text-end">
                    @nombre
                    <small>@(isAdmin ? "Administrador" : "Empleado")</small>
                </span>
                <span class="avatar-initial">@inicial</span>
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn-exit"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i>Salir</a>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar collapse d-lg-block" id="sidebar">
            @foreach (var g in items.Where(i => !i.AdminOnly || isAdmin).GroupBy(i => i.Group))
            {
                <div class="sidebar-group">@g.Key</div>
                foreach (var i in g)
                {
                    var activo = ctrl == i.C && (act == i.A || (i.A == "Index" && act != "GestionPuntos"));
                    <a class="sidebar-link @(activo ? "active" : "")" asp-controller="@i.C" asp-action="@i.A">
                        <i class="fa-solid @i.Icon"></i>@i.Text
                    </a>
                }
            }
            <div class="sidebar-group">Sitio</div>
            <a class="sidebar-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-globe"></i>Ver página web</a>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <form id="delete-form" method="post" class="d-none">@Html.AntiForgeryToken()</form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
