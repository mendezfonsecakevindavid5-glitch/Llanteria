@* Paginador de los catálogos (Llantas, Lubricantes, Baterías): máximo 20 productos por página, abajo a la derecha.
   Estructura:  [página actual] ◁ página(s) de ▷ [total]
   - Números y textos en rojo y sin clic.
   - Triángulos: solo el borde en rojo; al pasar el mouse se rellenan de rojo. Son lo único que se puede pulsar.
   - Triángulo izquierdo: página anterior (deshabilitado en la página 1).
   - Triángulo derecho: página siguiente (deshabilitado en la última página).
   - "página" va en singular cuando la página actual es la 1; en las demás, "páginas". Después del total no hay texto. *@
@model (int Pagina, int TotalPaginas)

@{
    string Enlace(int p)
    {
        var q = Context.Request.Query
            .Where(k => !string.Equals(k.Key, "pagina", StringComparison.OrdinalIgnoreCase))
            .SelectMany(k => k.Value.Select(v => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .Append($"pagina={p}");
        return Context.Request.Path + "?" + string.Join("&", q);
    }

    var enPrimera = Model.Pagina <= 1;
    var enUltima = Model.Pagina >= Model.TotalPaginas;
    var textoActual = Model.Pagina == 1 ? "página" : "páginas";
}

<nav class="cat-pager" aria-label="Paginación del catálogo">
    <span class="cat-pager-txt">@Model.Pagina</span>

    @if (enPrimera)
    {
        <span class="cat-pager-btn is-disabled" aria-disabled="true" aria-label="Página anterior">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="4,12 19.6,3 19.6,21" /></svg>
        </span>
    }
    else
    {
        <a class="cat-pager-btn" href="@Enlace(Model.Pagina - 1)" aria-label="Página anterior">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="4,12 19.6,3 19.6,21" /></svg>
        </a>
    }

    <span class="cat-pager-txt">@textoActual de</span>

    @if (enUltima)
    {
        <span class="cat-pager-btn is-disabled" aria-disabled="true" aria-label="Página siguiente">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="20,12 4.4,3 4.4,21" /></svg>
        </span>
    }
    else
    {
        <a class="cat-pager-btn" href="@Enlace(Model.Pagina + 1)" aria-label="Página siguiente">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="20,12 4.4,3 4.4,21" /></svg>
        </a>
    }

    <span class="cat-pager-txt">@Model.TotalPaginas</span>
</nav>
