@* Estilos comunes de los PDF. wkhtmltopdf usa un WebKit antiguo: se maqueta con tablas (sin flexbox ni grid). *@
<style>
    * { -webkit-box-sizing: border-box; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Arial, Helvetica, sans-serif; font-size: 12px; color: #1F2328; margin: 0; line-height: 1.35; }
    table { border-collapse: collapse; width: 100%; }
    td, th { vertical-align: top; }
    .muted { color: #6B7280; }
    .small { font-size: 10.5px; }
    .num { text-align: right; white-space: nowrap; }
    .c { text-align: center; }
    .b { font-weight: bold; }

    /* Encabezado del documento */
    .doc-head td { vertical-align: top; }
    .brand { font-size: 21px; font-weight: bold; letter-spacing: .6px; text-transform: uppercase; line-height: 1.05; }
    .brand span { color: #C92B0A; }
    .doc-title { text-align: right; }
    .doc-title .t { font-size: 17px; font-weight: bold; text-transform: uppercase; line-height: 1.15; }
    .meta { width: auto; margin-left: auto; margin-top: 6px; }
    .meta td { padding: 1px 0 1px 12px; font-size: 10.5px; text-align: right; }
    .meta td.k { color: #6B7280; }
    .rule { height: 3px; background: #C92B0A; margin: 12px 0 16px; }

    /* Indicadores */
    .kpis { margin-bottom: 4px; }
    .kpis td { width: 25%; border: 1px solid #DDE1E6; padding: 9px 11px; }
    .kpis td.hl { background: #1F2328; border-color: #1F2328; color: #fff; }
    .kpi-l { font-size: 9.5px; text-transform: uppercase; letter-spacing: .7px; color: #6B7280; }
    .hl .kpi-l { color: #C9CDD3; }
    .kpi-v { font-size: 17px; font-weight: bold; margin-top: 3px; white-space: nowrap; }
    .kpi-s { font-size: 9.5px; color: #6B7280; margin-top: 1px; }
    .hl .kpi-s { color: #C9CDD3; }
    .pos { color: #15803D; }
    .neg { color: #B42318; }
    .hl .pos { color: #86EFAC; }
    .hl .neg { color: #FCA5A5; }

    /* Secciones */
    h2.sec { font-size: 12px; text-transform: uppercase; letter-spacing: .8px; margin: 22px 0 8px; padding-bottom: 5px; border-bottom: 1px solid #1F2328; page-break-after: avoid; }
    h2.sec small { font-size: 10px; font-weight: normal; letter-spacing: 0; text-transform: none; color: #6B7280; margin-left: 6px; }

    /* Tablas de datos */
    table.dt th { background: #1F2328; color: #fff; font-size: 9.5px; text-transform: uppercase; letter-spacing: .5px; padding: 7px 8px; text-align: left; }
    table.dt th.num { text-align: right; }
    table.dt td { padding: 6px 8px; border-bottom: 1px solid #E6E8EC; }
    table.dt tr.alt td { background: #F7F8FA; }
    table.dt tfoot td { font-weight: bold; background: #EBEDF0; border-top: 2px solid #1F2328; border-bottom: 0; }
    table.dt tr.grp td { background: #EBEDF0; font-weight: bold; border-top: 1px solid #1F2328; border-bottom: 1px solid #C5CAD1; font-size: 11px; }
    table.dt tr.sub td { font-weight: bold; background: #F7F8FA; border-bottom: 1px solid #C5CAD1; }
    thead { display: table-header-group; }
    tfoot { display: table-row-group; }
    tr { page-break-inside: avoid; }

    /* Estado de resultados */
    table.er td { padding: 5px 8px; border-bottom: 1px solid #E6E8EC; }
    table.er td.ind { padding-left: 22px; }
    table.er tr.sec td { background: #EBEDF0; font-weight: bold; text-transform: uppercase; font-size: 10.5px; letter-spacing: .5px; border-top: 1px solid #1F2328; }
    table.er tr.sub td { font-weight: bold; border-top: 1px solid #1F2328; }
    table.er tr.tot td { font-weight: bold; font-size: 13px; background: #1F2328; color: #fff; border-bottom: 0; padding: 8px; }
    table.er tr.note td { font-size: 10px; color: #6B7280; border-bottom: 0; }

    /* Barras de porcentaje */
    .bar { height: 7px; background: #E6E8EC; width: 100%; }
    .bar i { display: block; height: 7px; background: #C92B0A; }

    /* Etiquetas de estado (llevan texto, no solo color) */
    .tag { font-size: 9.5px; font-weight: bold; text-transform: uppercase; letter-spacing: .4px; padding: 2px 6px; border: 1px solid #C5CAD1; color: #374151; white-space: nowrap; }
    .tag.ok { border-color: #86C99B; color: #15803D; }
    .tag.warn { border-color: #E4B66A; color: #92600A; }
    .tag.bad { border-color: #E89A93; color: #B42318; background: #FEF3F2; }

    /* Firmas y notas */
    .firmas { margin-top: 38px; page-break-inside: avoid; }
    .firmas td { width: 33%; padding: 0 14px; }
    .firmas .linea { border-top: 1px solid #1F2328; padding-top: 4px; font-size: 10px; text-align: center; color: #374151; }
    .nota { margin-top: 18px; padding: 8px 10px; border-left: 3px solid #C92B0A; background: #F7F8FA; font-size: 10px; color: #4B5563; page-break-inside: avoid; }
    .avoid { page-break-inside: avoid; }
    .gap { height: 14px; }
</style>
