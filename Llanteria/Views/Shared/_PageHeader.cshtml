@model Llanteria.Models.PageHeader

<div class="page-header">
    <div>
        <a asp-controller="@Model.VolverController" asp-action="@Model.VolverAction" class="back-link">
            <i class="fa-solid fa-arrow-left me-1"></i>Volver
        </a>
        <h1>@Model.Titulo</h1>
        <p>@Model.Subtitulo</p>
    </div>

    @if (Model.BotonTexto != null)
    {
        <a asp-controller="@Model.BotonController" asp-action="@Model.BotonAction" class="btn btn-brand">
            <i class="fa-solid fa-plus me-1"></i>@Model.BotonTexto
        </a>
    }
</div>
