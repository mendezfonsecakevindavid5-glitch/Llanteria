@* Vehículos del cliente con su historial y próximo mantenimiento. Se usa en "Mi cuenta" y en el perfil. *@
@model List<Llanteria.Models.VehiculoHistorial>

@if (Model.Any())
{
    <style>
        .hv-card { border: 1px solid #e3e6ea; border-radius: .6rem; padding: 1rem 1.1rem; margin-bottom: .9rem; background: #fff; }
        .hv-card:last-child { margin-bottom: 0; }
        .hv-placa { font-weight: 800; letter-spacing: .06em; font-size: 1.05rem; }
        .hv-chip { display: inline-flex; align-items: center; gap: .4rem; background: rgba(201, 43, 10, .08); color: #8f1f07; border-radius: 999px; padding: .2rem .7rem; font-size: .82rem; font-weight: 600; margin: .15rem .3rem .15rem 0; }
        .hv-chip.vencido { background: #fde8e6; color: #a32008; }
    </style>
    foreach (var h in Model)
    {
        <div class="hv-card">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <div>
                    <span class="hv-placa">@h.Vehiculo.Placa</span>
                    <span class="text-muted ms-2">@h.Vehiculo.Marca @h.Vehiculo.Modelo@(h.Vehiculo.Anio.HasValue ? " " + h.Vehiculo.Anio : "")</span>
                </div>
                @if (h.Vehiculo.Kilometraje.HasValue)
                {
                    <span class="text-muted small">@h.Vehiculo.Kilometraje.Value.ToString("N0") km</span>
                }
            </div>

            @if (h.Proximos.Any())
            {
                <div class="mt-2">
                    <div class="small fw-semibold mb-1">Próximo mantenimiento</div>
                    @foreach (var p in h.Proximos)
                    {
                        var vencido = p.ProximaFecha.HasValue && p.ProximaFecha.Value.Date < DateTime.Today;
                        <span class="hv-chip @(vencido ? "vencido" : "")">
                            <i class="fa-solid fa-wrench"></i>@p.Tipo:
                            @(p.ProximaFecha.HasValue ? p.ProximaFecha.Value.ToString("dd/MM/yyyy") : "")@(p.ProximaFecha.HasValue && p.ProximoKm.HasValue ? " o " : "")@(p.ProximoKm.HasValue ? p.ProximoKm.Value.ToString("N0") + " km" : "")
                        </span>
                    }
                </div>
            }

            @if (h.Ordenes.Any())
            {
                <table class="table table-sm align-middle mb-0 mt-2">
                    <thead><tr><th>Fecha</th><th>Trabajo</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var o in h.Ordenes.Take(5))
                        {
                            <tr>
                                <td class="text-nowrap">@o.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>@o.Descripcion</td>
                                <td>@o.Estado</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small mb-0 mt-2">Aún no hay trabajos registrados para este vehículo.</p>
            }
        </div>
    }
}
else
{
    <p class="text-muted mb-0">Todavía no tienes vehículos registrados. Cuando visites el taller, los verás aquí con su historial.</p>
}
