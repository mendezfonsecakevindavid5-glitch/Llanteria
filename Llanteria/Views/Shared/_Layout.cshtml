@inject Llanteria.Infrastructure.NegocioInfo Negocio
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isHomeIndex = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);

    bool isInicio = isHomeIndex;
    bool isBaterias = currentController.Equals("Baterias", StringComparison.OrdinalIgnoreCase);
    bool isPromociones = currentController.Equals("Promociones", StringComparison.OrdinalIgnoreCase);
    bool isEmpresas = currentController.Equals("Empresas", StringComparison.OrdinalIgnoreCase);
    bool isBlog = currentController.Equals("Blog", StringComparison.OrdinalIgnoreCase);
    bool isContacto = currentController.Equals("Contacto", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Llantas, baterías, aceites y servicio automotriz en Valledupar: montaje, balanceo, alineación 3D y mantenimiento de flotas.")" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Llanteria.styles.css" asp-append-version="true" />

    <style>
        :root {
            --llanteria-primary: #C92B0A;
            --llanteria-dark: #09090B;
            --llanteria-light: #FFFFFF;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8F9FA;
            color: var(--llanteria-dark);
            display: flex;
            flex-direction: column;
        }

        .michelin-nav-global {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1100;
            background: transparent;
            backdrop-filter: blur(10px);
            padding: 1.25rem 0;
            transition: background 0.3s ease, box-shadow 0.3s ease;
        }

        .michelin-nav-global.solid-bg,
        .michelin-nav-global.scrolled,
        .michelin-nav-global:hover {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .brand-matrix {
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            text-decoration: none;
            color: #FFFFFF !important;
            font-size: 1.4rem;
            text-shadow: 2px 2px 6px rgba(0,0,0,0.6);
            transition: color 0.3s ease;
            cursor: pointer;
        }

        .michelin-nav-global.solid-bg .brand-matrix,
        .michelin-nav-global.scrolled .brand-matrix,
        .michelin-nav-global:hover .brand-matrix {
            color: #000000 !important;
            text-shadow: none;
        }

        .brand-matrix small {
            color: var(--llanteria-primary) !important;
        }

        /* Nav Links estilo base (Transparent Header) */
        .michelin-nav-global .navbar-nav .nav-link {
            color: #FFFFFF !important;
            font-weight: 600;
            transition: color 0.15s ease-in-out;
            text-decoration: none !important;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
            position: relative;
            padding-bottom: 4px;
            margin: 0 6px; /* Separación nítida entre cada nav item */
        }

        /* Nav Links cuando el header es sólido */
        .michelin-nav-global.solid-bg .navbar-nav .nav-link,
        .michelin-nav-global.scrolled .navbar-nav .nav-link,
        .michelin-nav-global:hover .navbar-nav .nav-link {
            color: #000000 !important;
            text-shadow: none;
        }

        /* Subrayado independiente al pasar el mouse (separado y definido) */
        .michelin-nav-global.solid-bg .navbar-nav .nav-link::after,
        .michelin-nav-global.scrolled .navbar-nav .nav-link::after,
        .michelin-nav-global:hover .navbar-nav .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background-color: #000000;
            transition: width 0.2s ease, left 0.2s ease;
        }

        .michelin-nav-global.solid-bg .navbar-nav .nav-link:hover::after,
        .michelin-nav-global.scrolled .navbar-nav .nav-link:hover::after,
        .michelin-nav-global:hover .navbar-nav .nav-link:hover::after {
            width: 80%;
            left: 10%;
        }

        /* Color rojo al hacer clic en el nav item */
        .navbar-nav .nav-link.clicked-red {
            color: var(--llanteria-primary) !important;
        }

        /* Botón Iniciar Sesión (Negro, semirredondeado, con ícono de usuario) */
        .btn-matrix-action {
            background: #000000 !important;
            color: #FFFFFF !important;
            border: 1px solid #000000 !important;
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem; /* Semirredondeado */
            font-weight: 700;
            transition: background-color 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px; /* Separación entre el ícono y el texto */
        }

        .btn-matrix-action:hover {
            background: #212529 !important;
            border-color: #212529 !important;
            color: #FFFFFF !important;
        }

        .main-matrix-container {
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }

        .matrix-footer {
            flex-shrink: 0;
            background: #000000;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--llanteria-light);
        }

        .footer-links {
            padding: 0;
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @@media (min-width: 768px) {
            .footer-links li {
                justify-content: flex-start;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
    <script type="application/ld+json">@Html.Raw(Negocio.JsonLd($"{Context.Request.Scheme}://{Context.Request.Host}/"))</script>
</head>
<body class="public">
    <header>
        <nav class="navbar navbar-expand-lg site-nav michelin-nav-global @(!isHomeIndex ? "solid-bg" : "")" id="mainNavbar">
            <div class="container">
                <a class="navbar-brand brand-matrix" href="javascript:void(0);">
                    Llantería<small class="ms-1">Valledupar</small>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto align-items-lg-center ms-lg-4 gap-lg-2" id="navMenuList">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Baterias" asp-action="Index">Baterías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Promociones" asp-action="Index">Promociones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Empresas" asp-action="Index">Empresas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contacto" asp-action="Index">Contacto</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-3 mt-3 mt-lg-0">
                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-matrix-action header-interactable" asp-controller="Account" asp-action="Login">
                                    <i class="fa-regular fa-user"></i> Iniciar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            var fotoClaim = User.FindFirst("Foto")?.Value;
                            var username = User.Identity.Name ?? "Usuario";
                            var defaultAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(username)}&background=C92B0A&color=fff&rounded=true";
                            var avatarUrl = !string.IsNullOrEmpty(fotoClaim) ? fotoClaim : defaultAvatar;

                            <li class="nav-item d-flex align-items-center me-1">
                                <a asp-controller="User" asp-action="Perfil" title="Mi Perfil" class="header-interactable">
                                    <img src="@avatarUrl" alt="Foto de perfil" class="rounded-circle border border-2 border-white shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3 header-interactable">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-matrix-container">
        @RenderBody()
    </main>

    <footer class="matrix-footer py-4">
        <div class="container">
            <div class="row g-4 mb-3">
                <div class="col-md-4">
                    <h5 class="text-white fw-bold">Llantería Valledupar</h5>
                    <p class="small mb-0 text-white-50">Venta de llantas, aceites y servicios de mantenimiento automotriz.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white fw-bold">Contacto</h5>
                    <ul class="footer-links">
                        <li><i class="fa-solid fa-phone me-2 text-danger"></i><a href="tel:@Negocio.TelefonoLimpio" class="text-reset text-decoration-none">@Negocio.Telefono</a></li>
                        <li><i class="fa-solid fa-envelope me-2 text-danger"></i>@Negocio.Correo</li>
                        <li><i class="fa-solid fa-location-dot me-2 text-danger"></i><a href="@Negocio.ComoLlegar" target="_blank" rel="noopener" class="text-reset text-decoration-none">@Negocio.Direccion</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white fw-bold">Horario</h5>
                    <ul class="footer-links">
                        <li><i class="fa-solid fa-clock me-2 text-danger"></i><span class="text-white-50">Lunes a viernes: @Negocio.HorarioSemana</span></li>
                        <li><i class="fa-solid fa-clock me-2 text-danger"></i><span class="text-white-50">Sábados: @Negocio.HorarioSabado</span></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center small mb-0 text-white-50">&copy; @DateTime.Now.Year Llantería Valledupar. Todos los derechos reservados.</p>
        </div>
    </footer>

    <a class="wa-float" href="@Negocio.LinkWhatsApp(null)" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
        <i class="fa-brands fa-whatsapp"></i><span>WhatsApp</span>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.addEventListener('scroll', function () {
            const nav = document.getElementById('mainNavbar');
            @if (isHomeIndex)
            {
                <text>
                if (window.scrollY > 40) {
                    nav.classList.add('scrolled');
                } else {
                    nav.classList.remove('scrolled');
                }
                </text>
            }
        });

        // Lógica para cambiar color a rojo al hacer clic en un nav-link
        document.querySelectorAll('#navMenuList .nav-link').forEach(link => {
            link.addEventListener('click', function () {
                document.querySelectorAll('#navMenuList .nav-link').forEach(l => l.classList.remove('clicked-red'));
                this.classList.add('clicked-red');
            });
        });
    </script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>