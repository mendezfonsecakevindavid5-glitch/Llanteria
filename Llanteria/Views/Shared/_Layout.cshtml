@using Microsoft.AspNetCore.Http
@inject Llanteria.Infrastructure.NegocioInfo Negocio
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isHomeIndex = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);

    bool isInicio = isHomeIndex;
    bool isLlantas = currentController.Equals("Llantas", StringComparison.OrdinalIgnoreCase);
    bool isBaterias = currentController.Equals("Baterias", StringComparison.OrdinalIgnoreCase);
    bool isPromociones = currentController.Equals("Promociones", StringComparison.OrdinalIgnoreCase);
    bool isEmpresas = currentController.Equals("Empresas", StringComparison.OrdinalIgnoreCase);
    bool isBlog = currentController.Equals("Blog", StringComparison.OrdinalIgnoreCase);
    bool isContacto = currentController.Equals("Contacto", StringComparison.OrdinalIgnoreCase);

    // Contador del carrito: se lee de la sesión ("CarritoCantidad"). Mientras no exista un carrito que lo llene, muestra 0.
    int cartCount = 0;
    try { cartCount = Context.Session.GetInt32("CarritoCantidad") ?? 0; } catch { }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Llantas, baterías, aceites y servicio automotriz en Valledupar: montaje, balanceo, alineación 3D y mantenimiento de flotas.")" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/avatar-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Llanteria.styles.css" asp-append-version="true" />

    <style>
        :root {
            --llanteria-primary: #C92B0A;
            --llanteria-dark: #09090B;
            --llanteria-light: #FFFFFF;
            --cart-red: #E11D2A;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8F9FA;
            color: var(--llanteria-dark);
            display: flex;
            flex-direction: column;
        }

        /* ---------- Header ---------- */
        .michelin-nav-global {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1100;
            background: transparent;
            backdrop-filter: blur(10px);
            padding: 1.1rem 0;
            transition: background 0.3s ease, box-shadow 0.3s ease;
        }

        .michelin-nav-global.solid-bg,
        .michelin-nav-global.scrolled,
        .michelin-nav-global:hover {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        /* Los elementos del header arrancan más a la izquierda: sin el tope del .container */
        .michelin-nav-global .header-shell {
            max-width: none; /* site.css limita .container-fluid a 1500px y lo centraba */
            padding-left: clamp(1rem, 3.5vw, 4rem);
            padding-right: clamp(1rem, 3.5vw, 4rem);
        }

        /* Nombre del proyecto: enlace al inicio, con el MISMO estilo que el del pie de página (brand.css:
           Orbitron 900, mayúsculas, 1.4rem, "Valledupar" en rojo). Aquí solo cambia el color según el estado del header. */
        .michelin-nav-global .brand-matrix {
            color: #FFFFFF !important;
            cursor: pointer;
            margin-right: clamp(1rem, 2.4vw, 2.75rem);
            white-space: nowrap;
        }

        .michelin-nav-global.solid-bg .brand-matrix,
        .michelin-nav-global.scrolled .brand-matrix,
        .michelin-nav-global:hover .brand-matrix {
            color: #000000 !important;
            text-shadow: none;
        }

        /* Nav links: Roboto medio, un poco más grande (referencia: interllantas.com) */
        .michelin-nav-global .navbar-nav .nav-link {
            color: #FFFFFF !important;
            font-family: 'Roboto', 'Plus Jakarta Sans', sans-serif;
            font-weight: 500;
            font-size: 1.18rem;
            letter-spacing: .01em;
            transition: color 0.15s ease-in-out;
            text-decoration: none !important;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
            position: relative;
            padding-bottom: 4px;
            margin: 0 4px; /* Separación nítida entre cada nav item */
            white-space: nowrap;
        }

        /* site.css mueve y pinta de gris los .nav-link al pasar el mouse: en el header no */
        .michelin-nav-global .navbar-nav .nav-link,
        .michelin-nav-global .navbar-nav .nav-link:hover {
            background: transparent;
            transform: none;
            border-bottom: 0 !important; /* public.css pintaba un borde al pasar el mouse */
        }

        /* Subrayado de los nav items: SIEMPRE negro (también sobre el hero, donde el header se vuelve blanco al pasar el mouse) */
        .michelin-nav-global .navbar-nav .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background-color: #000000 !important;
            transition: width 0.2s ease, left 0.2s ease;
        }

        .michelin-nav-global .navbar-nav .nav-link:hover::after {
            width: 80%;
            left: 10%;
        }

        .michelin-nav-global.solid-bg .navbar-nav .nav-link,
        .michelin-nav-global.scrolled .navbar-nav .nav-link,
        .michelin-nav-global:hover .navbar-nav .nav-link {
            color: #000000 !important;
            text-shadow: none;
        }

        /* Página actual / clic: rojo (más específico que el color del header sólido) */
        .michelin-nav-global .navbar-nav .nav-item .nav-link.clicked-red {
            color: var(--llanteria-primary) !important;
        }

        /* Carrito con contador en la esquina superior derecha */
        .header-cart {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.5rem;
            line-height: 1;
            text-decoration: none;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
            transition: color .2s ease;
        }

        .michelin-nav-global.solid-bg .header-cart,
        .michelin-nav-global.scrolled .header-cart,
        .michelin-nav-global:hover .header-cart {
            color: #000000;
            text-shadow: none;
        }

        .header-cart:hover { color: var(--llanteria-primary) !important; }

        .cart-badge {
            position: absolute;
            top: -9px;
            right: -11px;
            min-width: 19px;
            height: 19px;
            padding: 0 5px;
            border-radius: 999px;
            background: var(--cart-red);
            color: #FFFFFF;
            font-family: 'Roboto', sans-serif;
            font-size: .72rem;
            font-weight: 700;
            line-height: 19px;
            text-align: center;
            text-shadow: none;
            box-shadow: 0 0 0 2px rgba(255,255,255,.9);
        }

        /* Botón Iniciar Sesión (Negro, semirredondeado, con ícono de usuario) */
        .btn-matrix-action {
            background: #000000 !important;
            color: #FFFFFF !important;
            border: 1px solid #000000 !important;
            padding: 0.55rem 1.25rem;
            border-radius: 0.5rem;
            font-family: 'Roboto', 'Plus Jakarta Sans', sans-serif;
            font-weight: 500;
            font-size: 1.02rem;
            letter-spacing: .01em;
            white-space: nowrap;
            transition: background-color 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-matrix-action:hover {
            background: #212529 !important;
            border-color: #212529 !important;
            color: #FFFFFF !important;
        }

        /* Carrito + sesión: más aire entre el carrito y el botón */
        .header-actions { gap: 1.9rem; }

        .main-matrix-container {
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }

        /* Entre 1200 y 1399 px se compacta un poco para que todo quepa en una línea */
        @@media (min-width: 1200px) and (max-width: 1399.98px) {
            .michelin-nav-global .navbar-nav .nav-link { font-size: 1.05rem; margin: 0 1px; }
            .btn-matrix-action { font-size: .96rem; padding: .5rem 1rem; }
        }

        @@media (max-width: 1199.98px) {
            /* El ícono del menú es oscuro por defecto: se invierte mientras el header es transparente */
            .michelin-nav-global:not(.solid-bg):not(.scrolled):not(:hover) .navbar-toggler-icon { filter: invert(1); }
            .michelin-nav-global .navbar-collapse { padding: .5rem 0 .25rem; }
            .header-cart { align-self: flex-start; margin: .25rem .75rem; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
    <script type="application/ld+json">@Html.Raw(Negocio.JsonLd($"{Context.Request.Scheme}://{Context.Request.Host}/"))</script>
</head>
<body class="public">
    <header>
        <nav class="navbar navbar-expand-xl site-nav michelin-nav-global @(!isHomeIndex ? "solid-bg" : "")" id="mainNavbar">
            <div class="container-fluid header-shell">
                <a class="navbar-brand brand-matrix" asp-controller="Home" asp-action="Index" aria-label="Llantería Valledupar, inicio">Llantería<small class="ms-1">Valledupar</small></a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto align-items-xl-center gap-xl-1" id="navMenuList">
                        <li class="nav-item">
                            <a class="nav-link @(isInicio ? "clicked-red" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isLlantas ? "clicked-red" : "")" asp-controller="Llantas" asp-action="Index">Llantas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isBaterias ? "clicked-red" : "")" asp-controller="Baterias" asp-action="Index">Baterías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPromociones ? "clicked-red" : "")" asp-controller="Promociones" asp-action="Index">Promociones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isEmpresas ? "clicked-red" : "")" asp-controller="Empresas" asp-action="Index">Empresas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isBlog ? "clicked-red" : "")" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isContacto ? "clicked-red" : "")" asp-controller="Contacto" asp-action="Index">Contacto</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-xl-center header-actions mt-3 mt-xl-0">
                        <li class="nav-item">
                            <a class="header-cart header-interactable" asp-controller="Llantas" asp-action="Index" title="Carrito" aria-label="Carrito de compras, @cartCount productos">
                                <i class="fa-solid fa-cart-shopping"></i>
                                <span class="cart-badge" id="cartCount">@cartCount</span>
                            </a>
                        </li>
                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-matrix-action header-interactable" asp-controller="Account" asp-action="Login">
                                    <i class="fa-regular fa-user"></i> Iniciar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-flex align-items-center">
                                @await Component.InvokeAsync("AvatarMenu", new { tamano = 44 })
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-matrix-container">
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    <a class="wa-float" href="@Negocio.LinkWhatsApp(null)" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
        <i class="fa-brands fa-whatsapp"></i><span>WhatsApp</span>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/protect-forms.js" asp-append-version="true"></script>
    <script src="~/js/avatar-menu.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('scroll', function () {
            const nav = document.getElementById('mainNavbar');
            @if (isHomeIndex)
            {
                <text>
                if (window.scrollY > 40) {
                    nav.classList.add('scrolled');
                } else {
                    nav.classList.remove('scrolled');
                }
                </text>
            }
        });

        // Lógica para cambiar color a rojo al hacer clic en un nav-link
        document.querySelectorAll('#navMenuList .nav-link').forEach(link => {
            link.addEventListener('click', function () {
                document.querySelectorAll('#navMenuList .nav-link').forEach(l => l.classList.remove('clicked-red'));
                this.classList.add('clicked-red');
            });
        });

        // Punto de enganche para el carrito: window.actualizarContadorCarrito(3) actualiza el número del ícono.
        window.actualizarContadorCarrito = function (n) {
            const el = document.getElementById('cartCount');
            if (el) el.textContent = n;
        };
    </script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
