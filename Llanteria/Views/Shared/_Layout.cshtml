<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>
<body class="public">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-nav">
            <div class="container">
                <a class="site-brand" asp-controller="Home" asp-action="Index">
                    Llantería<small>Valledupar</small>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto align-items-lg-center ms-lg-4">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Llantas" asp-action="Index">Llantas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Baterias" asp-action="Index">Baterías</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Empresas" asp-action="Index">Empresas</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#promociones">Promociones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contacto" asp-action="Index">Contacto</a></li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Club de puntos</a></li>
                            <li class="nav-item"><a class="btn btn-nav" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                        }
                        else
                        {
                            var nombre = User.Identity?.Name ?? "U";
                            if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Panel</a></li>
                            }
                            <li class="nav-item">
                                @if (User.IsInRole("Cliente"))
                                {
                                    <a asp-controller="MiCuenta" asp-action="Index" title="Mi cuenta" class="nav-avatar text-decoration-none">@nombre.Substring(0, 1).ToUpper()</a>
                                }
                                else
                                {
                                    <a asp-controller="User" asp-action="Perfil" title="Mi perfil" class="nav-avatar text-decoration-none">@nombre.Substring(0, 1).ToUpper()</a>
                                }
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">
                                    <i class="fa-solid fa-right-from-bracket me-1"></i>Salir
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 mb-3">
                <div class="col-md-4">
                    <h5>Llantería Valledupar</h5>
                    <p class="small mb-0">Venta de llantas, aceites y servicios de mantenimiento automotriz.</p>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <ul>
                        <li><i class="fa-solid fa-phone"></i><a href="tel:+573117723978" class="text-reset text-decoration-none">+57 311 772 3978</a></li>
                        <li><i class="fa-solid fa-envelope"></i>superllantasmedellinsas@hotmail.com</li>
                        <li><i class="fa-solid fa-location-dot"></i>Valledupar, Cesar</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Horario</h5>
                    <ul>
                        <li><i class="fa-solid fa-clock"></i>Lunes a viernes: 7:30 a.m. a 5:30 p.m.</li>
                        <li><i class="fa-solid fa-clock"></i>Sábados: 8:00 a.m. a 4:00 p.m.</li>
                    </ul>
                </div>
            </div>
            <hr />
            <p class="text-center small mb-0">&copy; @DateTime.Now.Year Llantería Valledupar. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
