<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Llanteria.styles.css" asp-append-version="true" />

    <style>
        :root {
            --llanteria-primary: #C92B0A;
            --llanteria-dark: #09090B;
            --llanteria-light: #FFFFFF;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8F9FA;
            color: var(--llanteria-dark);
            display: flex;
            flex-direction: column;
        }

        .michelin-nav-global {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1100;
            background: transparent; /* Transparente por defecto */
            backdrop-filter: blur(10px);
            padding: 1.25rem 0;
            transition: background 0.3s ease, box-shadow 0.3s ease;
        }

        /* Cambia a color sólido al hacer scroll o al pasar el mouse por encima */
        .michelin-nav-global.scrolled,
        .michelin-nav-global:hover {
            background: rgba(255, 255, 255, 0.98) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .brand-matrix {
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            text-decoration: none;
            color: #FFFFFF !important;
            font-size: 1.4rem;
            text-shadow: 2px 2px 6px rgba(0,0,0,0.6);
            transition: color 0.3s ease;
        }

        .michelin-nav-global.scrolled .brand-matrix,
        .michelin-nav-global:hover .brand-matrix {
            color: #000000 !important;
            text-shadow: none;
        }

        .brand-matrix small {
            color: var(--llanteria-primary) !important;
        }

        .navbar-nav .nav-link {
            color: #FFFFFF !important;
            font-weight: 600;
            transition: color 0.2s ease;
            text-decoration: none !important;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
        }

        .michelin-nav-global.scrolled .navbar-nav .nav-link,
        .michelin-nav-global:hover .navbar-nav .nav-link {
            color: #000000 !important;
            text-shadow: none;
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link.active:not([href$="#inicio"]) {
            color: var(--llanteria-primary) !important;
        }

        .btn-matrix-action {
            background: var(--llanteria-primary) !important;
            color: #FFFFFF !important;
            border: 1px solid var(--llanteria-primary) !important;
            padding: 0.5rem 1.5rem;
            border-radius: 50rem;
            font-weight: 700;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .btn-matrix-action:hover {
            background: #000000 !important;
            border-color: #000000 !important;
        }

        .main-matrix-container {
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }

        .matrix-footer {
            flex-shrink: 0;
            background: #000000;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--llanteria-light);
        }

        .footer-links {
            padding: 0;
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @@media (min-width: 768px) {
            .footer-links li {
                justify-content: flex-start;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public">
    <header>
        <nav class="navbar navbar-expand-lg site-nav michelin-nav-global">
            <div class="container">
                <a class="navbar-brand brand-matrix" asp-controller="Home" asp-action="Index">
                    Llantería<small class="ms-1">Valledupar</small>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto align-items-lg-center ms-lg-4 gap-lg-3">
                        <li class="nav-item"><a class="nav-link" href="/#inicio">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#promociones">Promociones</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#productos">Productos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contacto" asp-action="Index">Contacto</a></li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-3 mt-3 mt-lg-0">
                        @if (!User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-matrix-action header-interactable" asp-controller="Account" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            var fotoClaim = User.FindFirst("Foto")?.Value;
                            var username = User.Identity.Name ?? "Usuario";
                            var defaultAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(username)}&background=C92B0A&color=fff&rounded=true";
                            var avatarUrl = !string.IsNullOrEmpty(fotoClaim) ? fotoClaim : defaultAvatar;

                            <li class="nav-item d-flex align-items-center me-1">
                                <a asp-controller="User" asp-action="Perfil" title="Mi Perfil" class="header-interactable">
                                    <img src="@avatarUrl" alt="Foto de perfil" class="rounded-circle border border-2 border-white shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3 header-interactable">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-matrix-container">
        @RenderBody()
    </main>

    <footer class="matrix-footer py-4">
        <div class="container">
            <div class="row g-4 mb-3">
                <div class="col-md-4">
                    <h5 class="text-white fw-bold">Llantería Valledupar</h5>
                    <p class="small mb-0 text-white-50">Venta de llantas, aceites y servicios de mantenimiento automotriz.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white fw-bold">Contacto</h5>
                    <ul class="footer-links">
                        <li><i class="fa-solid fa-phone me-2 text-danger"></i><a href="tel:+573117723978" class="text-reset text-decoration-none">+57 311 772 3978</a></li>
                        <li><i class="fa-solid fa-envelope me-2 text-danger"></i>superllantasmedellinsas@hotmail.com</li>
                        <li><i class="fa-solid fa-location-dot me-2 text-danger"></i>Valledupar, Cesar</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white fw-bold">Horario</h5>
                    <ul class="footer-links">
                        <li><i class="fa-solid fa-clock me-2 text-danger"></i><span class="text-white-50">Lunes a viernes: 7:30 a.m. a 5:30 p.m.</span></li>
                        <li><i class="fa-solid fa-clock me-2 text-danger"></i><span class="text-white-50">Sábados: 8:00 a.m. a 4:00 p.m.</span></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center small mb-0 text-white-50">&copy; @DateTime.Now.Year Llantería Valledupar. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.addEventListener('scroll', function () {
            const nav = document.querySelector('.michelin-nav-global');
            if (window.scrollY > 40) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });
    </script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>