<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Llantería Valledupar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Llanteria.styles.css" asp-append-version="true" />

    <style>
        :root {
            --llanteria-primary: #C92B0A;
            --llanteria-dark: #09090B;
            --llanteria-light: #FFFFFF;
            --glass-nav-bg: rgba(201, 43, 10, 0.95);
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8F9FA;
            color: var(--llanteria-dark);
            display: flex;
            flex-direction: column;
        }

        .michelin-nav-global {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1100;
            background: var(--glass-nav-bg);
            backdrop-filter: blur(16px);
            padding: 1.25rem 0;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        }

        .brand-matrix {
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
        }

        .nav-matrix-link {
            color: #FFFFFF !important;
            font-weight: 600;
            font-size: 1.05rem;
            padding: 0.5rem 0.65rem !important;
            cursor: pointer;
            position: relative;
        }

        .nav-matrix-link:hover {
            background-color: transparent !important;
        }

        .nav-matrix-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: #FFFFFF;
            transition: width 0.2s ease-out;
        }

        .nav-matrix-link:hover::after {
            width: 100%;
        }

        .btn-matrix-action {
            background: #000000 !important;
            color: #FFFFFF !important;
            border: 1px solid #000000 !important;
            padding: 0.4rem 1.4rem;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .main-matrix-container {
            margin-top: 85px;
            flex: 1 0 auto;
            padding-bottom: 2rem;
        }

        .matrix-footer {
            flex-shrink: 0;
            background: #000000;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--llanteria-light);
        }

        .footer-heading {
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            font-size: 1.4rem;
            color: #FFFFFF;
            margin-bottom: 1.2rem;
        }

        .footer-links {
            padding: 0;
            list-style: none;
        }

            .footer-links li {
                margin-bottom: 0.8rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

        @@media (min-width: 768px) {
            .footer-links li {
                justify-content: flex-start;
            }
        }

        .footer-links span {
            color: #FFFFFF;
            font-weight: 500;
            font-size: 0.95rem;
        }
    </style>
</head>
<body class="public">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-nav">
            <div class="container">
                <a class="site-brand" asp-controller="Home" asp-action="Index">
                    Llantería<small>Valledupar</small>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto align-items-lg-center ms-lg-4">
                        <li class="nav-item"><a class="nav-link" href="/#inicio">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#promociones">Promociones</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#productos">Productos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contacto" asp-action="Index">Contacto</a></li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-3 mt-3 mt-lg-0">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-matrix-action rounded-pill header-interactable" asp-controller="Account" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            var fotoClaim = User.FindFirst("Foto")?.Value;
                            var username = User.Identity.Name ?? "Usuario";
                            var defaultAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(username)}&background=C92B0A&color=fff&rounded=true";
                            var avatarUrl = !string.IsNullOrEmpty(fotoClaim) ? fotoClaim : defaultAvatar;

                            <li class="nav-item d-flex align-items-center me-1">
                                <a asp-controller="User" asp-action="Perfil" title="Mi Perfil" class="header-interactable">
                                    <img src="@avatarUrl" alt="Foto de perfil" class="rounded-circle border border-2 border-white shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3 header-interactable">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 mb-3">
                <div class="col-md-4">
                    <h5>Llantería Valledupar</h5>
                    <p class="small mb-0">Venta de llantas, aceites y servicios de mantenimiento automotriz.</p>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <ul>
                        <li><i class="fa-solid fa-phone"></i><a href="tel:+573117723978" class="text-reset text-decoration-none">+57 311 772 3978</a></li>
                        <li><i class="fa-solid fa-envelope"></i>superllantasmedellinsas@hotmail.com</li>
                        <li><i class="fa-solid fa-location-dot"></i>Valledupar, Cesar</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Horario</h5>
                    <ul>
                        <li><i class="fa-solid fa-clock"></i>Lunes a viernes: 7:30 a.m. a 5:30 p.m.</li>
                        <li><i class="fa-solid fa-clock"></i>Sábados: 8:00 a.m. a 4:00 p.m.</li>
                    </ul>
                </div>
            </div>
            <hr />
            <p class="text-center small mb-0">&copy; @DateTime.Now.Year Llantería Valledupar. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_Alertas" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
