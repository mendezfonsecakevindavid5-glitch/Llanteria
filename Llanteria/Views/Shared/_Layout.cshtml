<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Llantería</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Llanteria.styles.css" asp-append-version="true" />

    <style>
            :root {
                --llanteria-primary: #C92B0A;
                --llanteria-dark: #09090B;
                --llanteria-light: #FFFFFF;
                --glass-nav-bg: rgba(201, 43, 10, 0.95);
            }

            html, body {
                height: 100%;
                margin: 0;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #F8F9FA;
                color: var(--llanteria-dark);
                display: flex;
                flex-direction: column;
            }

            .michelin-nav-global {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1100;
                background: var(--glass-nav-bg);
                backdrop-filter: blur(16px);
                padding: 1.25rem 0;
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
            }

            .brand-matrix {
                font-family: 'Orbitron', sans-serif;
                font-weight: 900;
                text-transform: uppercase;
                text-decoration: none;
                cursor: pointer;
            }

            .nav-matrix-link {
                color: #FFFFFF !important;
                font-weight: 600;
                font-size: 1.05rem;
                padding: 0.5rem 0.65rem !important;
                cursor: pointer;
                position: relative;
            }

            .nav-matrix-link:hover {
                background-color: transparent !important;
            }

            .nav-matrix-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background: #FFFFFF;
                transition: width 0.2s ease-out;
            }

            .nav-matrix-link:hover::after {
                width: 100%;
            }

            /* Estilos del Botón con Brillo Ligero y Nítido */
            .btn-matrix-action {
                background: #000000 !important;
                color: #FFFFFF !important;
                border: 1px solid #000000 !important;
                padding: 0.4rem 1.4rem;
                position: relative;
                overflow: hidden;
                cursor: pointer;
            }

            .btn-matrix-action:active,
            .btn-matrix-action:focus,
            .btn-matrix-action:visited {
                background: #000000 !important;
                border-color: #000000 !important;
            }

            /* Animación de Brillo Rápida e Imperceptible */
            .btn-matrix-action::before {
                content: '';
                position: absolute;
                top: 0;
                left: -150%;
                width: 40%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
                transform: skewX(-20deg);
                z-index: 1;
                pointer-events: none;
            }

            .animate-shine::before {
                animation: shine-slide 0.25s linear forwards;
            }

            @@keyframes shine-slide {
                0% {
                    left: -150%;
                }
                100% {
                    left: 250%;
                }
            }

            .click-disabled {
                pointer-events: none !important;
                opacity: 0.8;
                cursor: not-allowed !important;
            }

            .main-matrix-container {
                margin-top: 85px;
                flex: 1 0 auto;
                padding-bottom: 2rem;
            }

            .matrix-footer {
                flex-shrink: 0;
                background: #000000;
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                color: var(--llanteria-light);
            }

            .footer-heading {
                font-family: 'Orbitron', sans-serif;
                font-weight: 700;
                font-size: 1.4rem;
                color: #FFFFFF;
                margin-bottom: 1.2rem;
            }

            .footer-links {
                padding: 0;
                list-style: none;
            }

            .footer-links li {
                margin-bottom: 0.8rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            @@media (min-width: 768px) {
                .footer-links li {
                    justify-content: flex-start;
                }
            }

            .footer-links span {
                color: #FFFFFF;
                font-weight: 500;
                font-size: 0.95rem;
            }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg michelin-nav-global">
            <div class="container-fluid px-4 px-lg-5">
                <a class="brand-matrix d-flex align-items-center me-lg-5 header-interactable" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-radar me-3" style="color: var(--llanteria-light); font-size: 1.8rem;"></i>
                    <div class="d-flex flex-column text-start">
                        <span style="color:white; font-size: 1.45rem;">LLantería</span>
                        <span style="color:rgba(255,255,255,0.9); font-size: 0.85rem;">Valledupar</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <i class="fa-solid fa-bars-staggered fs-4"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto align-items-center gap-1">
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" href="/#inicio">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" href="/#categorias">Categorías</a></li>
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" href="/#nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" href="/#promociones">Promociones</a></li>
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" href="/#servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" href="/#productos">Productos</a></li>
                        <li class="nav-item"><a class="nav-link nav-matrix-link header-interactable" asp-controller="Contacto" asp-action="Index">Contacto</a></li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-3 mt-3 mt-lg-0">
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <!-- 🔓 VISIBLE SOLO PARA VISITANTES -->
                            <li class="nav-item">
                                <a class="nav-link nav-matrix-link header-interactable" asp-controller="Account" asp-action="Register">Puntos</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-matrix-action rounded-pill header-interactable" asp-controller="Account" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            var fotoClaim = User.FindFirst("Foto")?.Value;
                            var username = User.Identity.Name ?? "Usuario";
                            var defaultAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(username)}&background=09090B&color=fff&rounded=true";
                            var avatarUrl = !string.IsNullOrEmpty(fotoClaim) ? fotoClaim : defaultAvatar;

                            <li class="nav-item">
                                <a class="nav-link nav-matrix-link header-interactable text-white fw-bold" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fa-solid fa-star text-warning me-1"></i> Mis Puntos
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center me-1">
                                <a asp-controller="Account" asp-action="MiPerfil" title="Mi Perfil" class="header-interactable">
                                    <img src="@avatarUrl" alt="Foto de perfil" class="rounded-circle border border-2 border-white shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3 header-interactable">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-matrix-container">
        @RenderBody()
    </main>

    <footer class="matrix-footer py-5">
        <div class="container">
            <div class="row text-center text-md-start mb-4">
                <div class="col-md-3 col-sm-6 mb-4">
                    <h5 class="footer-heading">Garantías</h5>
                    <ul class="footer-links">
                        <li><span>Políticas de Devolución</span></li>
                        <li><span>Términos de Garantía</span></li>
                        <li><span>Registro de Neumáticos</span></li>
                        <li><span>Soporte Post-venta</span></li>
                    </ul>
                </div>
                <div class="col-md-3 col-sm-6 mb-4">
                    <h5 class="footer-heading">Comunidad</h5>
                    <ul class="footer-links">
                        <li><span>Eventos Locales</span></li>
                        <li><span>Club de Beneficios</span></li>
                        <li><span>Blog y Consejos</span></li>
                        <li><span>Testimonios</span></li>
                    </ul>
                </div>
                <div class="col-md-3 col-sm-6 mb-4">
                    <h5 class="footer-heading">Productos</h5>
                    <ul class="footer-links">
                        <li><span>Catálogo Completo</span></li>
                        <li><span>Llantas para Auto</span></li>
                        <li><span>Llantas para Camioneta</span></li>
                        <li><span>Accesorios</span></li>
                    </ul>
                </div>
                <div class="col-md-3 col-sm-6 mb-4">
                    <h5 class="footer-heading">Contacto</h5>
                    <ul class="footer-links">
                        <li><span><i class="fa-solid fa-location-dot me-2 text-white"></i>Cra. 19 # 14-25, Valledupar</span></li>
                        <li><span><i class="fa-solid fa-phone-volume me-2 text-white"></i>+57 320 123 4567</span></li>
                        <li><span><i class="fa-solid fa-envelope-circle-check me-2 text-white"></i>soporte@llanteria.com</span></li>
                        <li><span><i class="fa-solid fa-clock me-2 text-white"></i>Lun - Sáb: 8:00 AM - 6:00 PM</span></li>
                    </ul>
                </div>
            </div>

            <hr class="mb-4" style="border-color: rgba(255,255,255,0.2);">

            <div class="text-center">
                <a class="brand-matrix d-inline-flex align-items-center justify-content-center text-decoration-none mb-2" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-radar me-2" style="color: var(--llanteria-primary); font-size: 1.6rem;"></i>
                    <span style="color: #FFFFFF; font-size: 1.4rem; margin-right: 6px;">LLantería</span>
                    <span style="color: var(--llanteria-primary); font-size: 1.4rem;">Valledupar</span>
                </a>
                <p class="text-white small mb-0">&copy; 2026 - Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const interactables = document.querySelectorAll('.header-interactable');

                interactables.forEach(element => {
                    element.addEventListener("click", function (e) {
                        if (this.classList.contains("click-disabled")) {
                            e.preventDefault();
                            return;
                        }

                        this.classList.add("click-disabled");

                        if (this.classList.contains("btn-matrix-action")) {
                            this.classList.add("animate-shine");
                        }

                        setTimeout(() => {
                            this.classList.remove("click-disabled");
                            this.classList.remove("animate-shine");
                        }, 400);
                    });
                });
            });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>