@inject IWebHostEnvironment Env
@{
    string Foto(string slug)
    {
        foreach (var ext in new[] { ".jpg", ".jpeg", ".webp", ".png" })
            if (System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", "servicios", slug + ext)))
                return $"/images/servicios/{slug}{ext}";
        return "/images/servicios/default-servicio.png";
    }
}
<section id="servicios" class="section">
    <div class="container">
        <div class="mb-4">
            <span class="eyebrow">Servicios</span>
            <h2 class="section-title mt-1">Todo para tu vehículo en un solo lugar</h2>
        </div>
        <div class="row g-4">
            @foreach (var s in ServiciosCatalogo.Todos)
            {
                <div class="col-md-6 col-lg-4">
                    <a asp-controller="Servicios" asp-action="Detalle" asp-route-slug="@s.Slug" class="service-photo-card">
                        <img src="@Foto(s.Slug)" alt="@s.Titulo" loading="lazy" />
                        <div class="body">
                            <h3>@s.Titulo</h3>
                            <p>@s.Subtitulo</p>
                            <span class="more">Ver servicio &rarr;</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
