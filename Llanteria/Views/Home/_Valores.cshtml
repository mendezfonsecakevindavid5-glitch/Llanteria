@* Valores de la empresa: sección propia, separada de "Quiénes somos". Una tarjeta por valor, con ícono rojo centrado arriba y el valor en negro debajo. *@
@{
    var valores = new (string Icono, string Nombre)[]
    {
        ("fa-solid fa-truck-fast", "Montaje el mismo día"),
        ("fa-solid fa-shield-halved", "Garantía de fábrica"),
        ("fa-solid fa-sack-dollar", "Precios claros"),
        ("fa-solid fa-user-gear", "Asesoría técnica")
    };
}
<section id="valores" class="section valores-sec">
    <div class="container">
        <div class="valores-head">
            <span class="eyebrow">Nuestros valores</span>
            <h2 class="section-title mt-1">Lo que <span class="rojo">nos respalda</span></h2>
        </div>
        <div class="valores-grid">
            @foreach (var v in valores)
            {
                <div class="valor-card">
                    <i class="@v.Icono" aria-hidden="true"></i>
                    <h3>@v.Nombre</h3>
                </div>
            }
        </div>
    </div>
</section>
