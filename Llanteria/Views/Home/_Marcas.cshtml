@model List<Llanteria.Models.MarcaVitrina>
@if (Model.Count > 0)
{
    <section id="marcas" class="section pb-0">
        <div class="container">
            <div class="text-center mb-4">
                <span class="eyebrow">Marcas</span>
                <h2 class="section-title mt-1">Trabajamos con las mejores marcas</h2>
                <p class="section-sub mb-0">Toca una marca para ver sus productos disponibles.</p>
            </div>
            <div class="brand-strip">
                @foreach (var m in Model)
                {
                    <a class="brand-tile" asp-controller="@m.Catalogo" asp-action="Index" asp-route-marca="@m.Nombre"
                       title="Ver @(m.Catalogo == "Llantas" ? "llantas" : "baterías") @m.Nombre">
                        @if (m.Logo != null)
                        {
                            <img src="@m.Logo" alt="@m.Nombre" loading="lazy" />
                        }
                        else
                        {
                            <span class="brand-word">@m.Nombre</span>
                        }
                        <small>@(m.Catalogo == "Llantas" ? "Llantas" : "Baterías")</small>
                    </a>
                }
            </div>
        </div>
    </section>
}
