@model IEnumerable<Llanteria.Models.Producto>

@{
    ViewData["Title"] = "Inicio";
    var productos = Model.ToList();
}

<section id="inicio" class="hero">
    <div class="container">
        <span class="eyebrow text-white-50">Valledupar, Cesar</span>
        <h1 class="display-4 mt-2 mb-3">Llantas, aceites y servicio<br />para tu vehículo</h1>
        <p class="lead mb-4">Encuentra la medida que necesitas y agenda tu servicio sin filas.</p>
        <a href="#productos" class="btn btn-hyper-action px-4 py-2 me-2">Ver productos</a>
        <a href="#servicios" class="btn btn-outline-light px-4 py-2">Servicios</a>
    </div>
</section>

<div class="container search-wrap">
    <form class="search-matrix-panel" method="get" asp-controller="Llantas" asp-action="Index">
        <h2 class="h6 text-white text-uppercase mb-3" style="letter-spacing:.8px">Buscar llantas por medida</h2>
        <div class="row g-3 form-floating-dark">
            <div class="col-md-3">
                <label class="small text-white-50" for="anchoSelect">Ancho</label>
                <select id="anchoSelect" name="ancho" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var a in (List<string>)ViewBag.Anchos) { <option value="@a">@a</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="small text-white-50" for="perfilSelect">Perfil</label>
                <select id="perfilSelect" name="perfil" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var p in (List<string>)ViewBag.Perfiles) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="small text-white-50" for="diametroSelect">Rin</label>
                <select id="diametroSelect" name="diametro" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var d in (List<string>)ViewBag.Diametros) { <option value="@d">@d</option> }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-hyper-action w-100 py-2">Buscar</button>
            </div>
        </div>
        <div class="mt-3 small">
            <a asp-controller="Llantas" asp-action="Index" class="text-white-50">Ver todas las llantas</a>
            <span class="text-white-50 mx-2">·</span>
            <a asp-controller="Baterias" asp-action="Index" class="text-white-50">Ver baterías</a>
        </div>
    </form>
</div>

<partial name="_Nosotros" />
<partial name="_Servicios" />
<partial name="_Promociones" />

<section id="productos" class="section">
    <div class="container">
        <div class="mb-4">
            <span class="eyebrow">Catálogo</span>
            <h2 class="section-title mt-1">Productos disponibles</h2>
        </div>

        <div class="d-flex gap-2 mb-4 flex-wrap">
            <button type="button" class="btn btn-outline-dark filter-btn active" data-filter="todos">Todos</button>
            <button type="button" class="btn btn-outline-dark filter-btn" data-filter="Llantas">Llantas</button>
            <button type="button" class="btn btn-outline-dark filter-btn" data-filter="Aceites">Aceites</button>
            <button type="button" class="btn btn-outline-dark filter-btn" data-filter="Baterías">Baterías</button>
        </div>

        <div class="row g-3" id="gridCatalogoProductos">
            @foreach (var p in productos)
            {
                var categoria = string.IsNullOrEmpty(p.Categoria) ? "Llantas" : p.Categoria;
                var d = p.DetalleProducto;
                <div class="col-sm-6 col-lg-4 item-producto" data-categoria="@categoria">
                    <div class="premium-product-card h-100 d-flex flex-column">
                        <img class="product-img" src="~/images/productoos/@(string.IsNullOrEmpty(p.RutaImagen) ? "default-producto.png" : p.RutaImagen)" alt="@p.Nombre" loading="lazy" />
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <span class="small text-muted text-uppercase">@categoria</span>
                            <h3 class="h6 fw-bold mb-1">@p.Nombre</h3>
                            @if (d != null && !string.IsNullOrEmpty(d.Ancho) && !string.IsNullOrEmpty(d.Perfil) && !string.IsNullOrEmpty(d.Diametro))
                            {
                                <div class="small text-muted">Medida: @d.Ancho/@d.Perfil R@(d.Diametro)</div>
                            }
                            else if (d != null && !string.IsNullOrEmpty(d.Viscosidad))
                            {
                                <div class="small text-muted">Viscosidad: @d.Viscosidad @d.TipoAceite</div>
                            }
                            <div class="fs-5 fw-bold text-llanteria-primary mt-2 mb-3">@p.PrecioVenta.ToString("C0")</div>
                            <a asp-controller="Contacto" asp-action="Index" class="btn btn-hyper-action btn-sm mt-auto">Cotizar</a>
                        </div>
                    </div>
                </div>
            }
            @if (!productos.Any())
            {
                <div class="col-12 text-center text-muted py-5">Pronto publicaremos nuestro catálogo.</div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Filtro por categoría
        document.querySelectorAll('.filter-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const f = btn.dataset.filter;
                document.querySelectorAll('.item-producto').forEach(function (el) {
                    el.style.display = (f === 'todos' || el.dataset.categoria === f) ? '' : 'none';
                });
            });
        });
    </script>
}
