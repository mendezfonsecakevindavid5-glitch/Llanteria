@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Inicio";
    // Imágenes del banner de vehículos: wwwroot/images/banner-auto.* y banner-moto.* (si no existen, queda un fondo oscuro).
    var imgAuto = Llanteria.Infrastructure.ImagenSitio.Url(Env, "banner-auto", "Auto-target");
    var imgMoto = Llanteria.Infrastructure.ImagenSitio.Url(Env, "banner-moto", "moto");
    var logos = (List<Llanteria.Models.MarcaVitrina>)ViewBag.Logos;
}

<link rel="stylesheet" href="~/css/paginas/inicio.css" asp-append-version="true" />

<!-- Banner principal -->
<section class="banner-hero-matrix">
    <div class="container">
        <div class="banner-content-box">
            <a asp-controller="Llantas" asp-action="Index" class="btn btn-banner-explorar">Explorar</a>
        </div>
    </div>
</section>

<!-- Banner de vehículos: autos y motocicletas se alternan (imagen y texto) -->
<section class="vb-sec" aria-label="Llantas para autos y motocicletas">
    <div class="container">
        <div class="vb" id="vbSlider" role="region" aria-roledescription="carrusel" aria-label="Autos y motocicletas">
            <div class="vb-slide is-active" data-tipo="Auto" style="@(imgAuto != null ? $"--vb-img:url({imgAuto})" : "")">
                <div class="vb-texto">
                    <a asp-controller="Llantas" asp-action="Index" asp-route-tipo="Auto" class="vb-btn">Explorar</a>
                </div>
            </div>
            <div class="vb-slide" data-tipo="Moto" aria-hidden="true" style="@(imgMoto != null ? $"--vb-img:url({imgMoto})" : "")">
                <div class="vb-texto">
                    <a asp-controller="Llantas" asp-action="Index" asp-route-tipo="Moto" class="vb-btn" tabindex="-1">Explorar</a>
                </div>
            </div>
            <div class="vb-dots" role="tablist" aria-label="Elegir banner">
                <button type="button" class="vb-dot is-active" role="tab" aria-selected="true" aria-label="Autos" data-i="0"><i class="fa-solid fa-car-side"></i></button>
                <button type="button" class="vb-dot" role="tab" aria-selected="false" aria-label="Motocicletas" data-i="1"><i class="fa-solid fa-motorcycle"></i></button>
            </div>
        </div>
    </div>
</section>

<!-- Llantas destacadas -->
@{
    var destacadas = ViewBag.Destacadas as List<Llanteria.Models.Producto> ?? new List<Llanteria.Models.Producto>();
    var agotados = ViewBag.Agotados as HashSet<int> ?? new HashSet<int>();
}
@if (destacadas.Count > 0)
{
    <section class="section pb-0">
        <div class="container">
            <div class="home-section-head">
                <div>
                    <span class="eyebrow">Catálogo</span>
                    <h2 class="section-title mt-1 mb-0">Llantas para tu vehículo</h2>
                </div>
                <a asp-controller="Llantas" asp-action="Index">Ver todas las llantas</a>
            </div>
            <div class="cat-grid">
                @foreach (var p in destacadas)
                {
                    <partial name="_TarjetaProducto" model="(p, agotados.Contains(p.Id))" />
                }
            </div>
        </div>
    </section>
}

<!-- Partials adicionales -->
<partial name="_Marcas" model="logos" />
<partial name="_Categorias" />
<partial name="_Servicios" />
<partial name="_Nosotros" />
<partial name="_Resenias" />

@section Scripts {
    <script src="~/js/tienda.js" asp-append-version="true"></script>
    <script>
        // Banner de vehículos: se alterna solo cada 7 s (imagen y texto); se detiene al pasar el cursor o enfocarlo.
        (function () {
            var cont = document.getElementById('vbSlider');
            if (!cont) return;
            var slides = cont.querySelectorAll('.vb-slide'), dots = cont.querySelectorAll('.vb-dot');
            var actual = 0, timer = null;
            var reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function mostrar(i) {
                actual = (i + slides.length) % slides.length;
                slides.forEach(function (s, n) {
                    var on = n === actual;
                    s.classList.toggle('is-active', on);
                    s.setAttribute('aria-hidden', on ? 'false' : 'true');
                    var a = s.querySelector('a'); if (a) a.tabIndex = on ? 0 : -1;
                });
                dots.forEach(function (d, n) { d.classList.toggle('is-active', n === actual); d.setAttribute('aria-selected', n === actual ? 'true' : 'false'); });
            }
            function iniciar() { if (reducir || timer) return; timer = setInterval(function () { mostrar(actual + 1); }, 7000); }
            function detener() { clearInterval(timer); timer = null; }

            dots.forEach(function (d) { d.addEventListener('click', function () { mostrar(parseInt(d.dataset.i, 10)); detener(); iniciar(); }); });
            cont.addEventListener('mouseenter', detener);
            cont.addEventListener('mouseleave', iniciar);
            cont.addEventListener('focusin', detener);
            cont.addEventListener('focusout', iniciar);
            document.addEventListener('visibilitychange', function () { document.hidden ? detener() : iniciar(); });
            iniciar();
        })();
    </script>
}
