@{
    ViewData["Title"] = "Inicio";
    var marcas = (List<Llanteria.Models.MarcaVitrina>)ViewBag.Marcas;
}

<section id="inicio" class="hero">
    <div class="container">
        <span class="eyebrow text-white-50">Valledupar, Cesar</span>
        <h1 class="display-4 mt-2 mb-3">Encuentra las llantas<br />exactas para tu vehículo</h1>
        <p class="lead mb-0">Busca por la medida que trae tu llanta y mira solo lo que te sirve.</p>
    </div>
</section>

<div class="container search-wrap">
    <form class="search-matrix-panel" method="get" asp-controller="Llantas" asp-action="Index">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-3 gap-2">
            <h2 class="h6 text-white text-uppercase mb-0" style="letter-spacing:.8px">Buscar llantas por medida</h2>
            <a asp-controller="Blog" asp-action="Detalle" asp-route-slug="como-leer-la-medida-de-tu-llanta" class="small text-white-50">¿Dónde veo la medida de mi llanta?</a>
        </div>
        <div class="row g-3 form-floating-dark">
            <div class="col-md-3 col-6">
                <label class="small text-white-50" for="anchoSelect">Ancho (mm)</label>
                <select id="anchoSelect" name="ancho" class="form-select">
                    <option value="">Cualquiera</option>
                    @foreach (var a in (List<string>)ViewBag.Anchos) { <option value="@a">@a</option> }
                </select>
            </div>
            <div class="col-md-3 col-6">
                <label class="small text-white-50" for="perfilSelect">Perfil (%)</label>
                <select id="perfilSelect" name="perfil" class="form-select">
                    <option value="">Cualquiera</option>
                    @foreach (var p in (List<string>)ViewBag.Perfiles) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="col-md-3 col-6">
                <label class="small text-white-50" for="diametroSelect">Rin (pulgadas)</label>
                <select id="diametroSelect" name="diametro" class="form-select">
                    <option value="">Cualquiera</option>
                    @foreach (var d in (List<string>)ViewBag.Diametros) { <option value="@d">@d</option> }
                </select>
            </div>
            <div class="col-md-3 col-6 d-flex align-items-end">
                <button type="submit" class="btn btn-hyper-action w-100 py-2"><i class="fa-solid fa-magnifying-glass me-2"></i>Buscar llantas</button>
            </div>
        </div>
        <div class="mt-3 small text-white-50">Ejemplo: una llanta 205/55 R16 se busca con ancho 205, perfil 55 y rin 16.</div>
    </form>
</div>

<partial name="_Marcas" model="marcas" />
<partial name="_Servicios" />
<partial name="_Resenias" />
<partial name="_Nosotros" />
