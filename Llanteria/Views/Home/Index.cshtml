@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Inicio";
    // Fotos del banner de vehículos (ver wwwroot/images/banners/LEEME.txt con los prompts para generarlas).
    // Se buscan, en este orden, en wwwroot/images/banners/ y en wwwroot/images/ (banner-auto.*, banner-moto.*).
    // Si no hay foto, el fondo es un degradado oscuro liso: nunca un dibujo ni un ícono.
    var imgAuto = Llanteria.Infrastructure.ImagenSitio.Url(Env, "banners/banner-auto", "banner-auto", "Auto-target");
    var imgMoto = Llanteria.Infrastructure.ImagenSitio.Url(Env, "banners/banner-moto", "banner-moto", "moto");
    var logos = (List<Llanteria.Models.MarcaVitrina>)ViewBag.Logos;
}

<link rel="stylesheet" href="~/css/paginas/inicio.css" asp-append-version="true" />

<div class="home-idx">

<!-- Banner principal -->
<section class="banner-hero-matrix">
    <div class="container">
        <div class="banner-content-box">
            <span class="banner-eyebrow"><i class="fa-solid fa-location-dot"></i> Valledupar, Cesar</span>
            <h1>Llantas, baterías y lubricantes<br>con montaje el mismo día</h1>
            <p>Catálogo completo para carro y moto, asesoría técnica real y precios claros. Pide tu cotización en minutos.</p>
            <div class="banner-actions">
                <a asp-controller="Llantas" asp-action="Index" class="btn btn-banner-explorar">Ver catálogo</a>
                <a asp-controller="Contacto" asp-action="Index" class="btn btn-banner-contacto">Hablar con el taller</a>
            </div>
        </div>
    </div>
</section>

<!-- Búsqueda de llantas: autos y motocicletas se alternan (imagen y texto). Bordes redondeados y corte curvo como el de las tarjetas de servicios. -->
<section class="vb-sec" aria-label="Llantas para autos y motocicletas">
    <div class="container">
        <div class="vb" id="vbSlider" role="region" aria-roledescription="carrusel" aria-label="Autos y motocicletas">
            <div class="vb-slide is-active" data-tipo="Auto" style="@(imgAuto != null ? $"--vb-img:url({imgAuto})" : "")">
                <div class="vb-texto">
                    <h2>Llantas para <strong>automóviles</strong><span>todas las marcas y medidas</span></h2>
                    <p>Encuentra la medida exacta para tu carro, con stock verificado y garantía de fábrica.</p>
                    <a asp-controller="Llantas" asp-action="Index" asp-route-tipo="Auto" class="vb-btn">Ver llantas de auto</a>
                </div>
            </div>
            <div class="vb-slide" data-tipo="Moto" aria-hidden="true" style="@(imgMoto != null ? $"--vb-img:url({imgMoto})" : "")">
                <div class="vb-texto">
                    <h2>Llantas para <strong>motocicleta</strong><span>rendimiento y seguridad</span></h2>
                    <p>Variedad de cauchos para uso urbano y de alto desempeño, con instalación incluida.</p>
                    <a asp-controller="Llantas" asp-action="Index" asp-route-tipo="Moto" class="vb-btn" tabindex="-1">Ver llantas de moto</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Partials del inicio (el catálogo de productos ya no va aquí) -->
<partial name="_Marcas" model="logos" />
<partial name="_Categorias" />
<partial name="_Servicios" />
<partial name="_Nosotros" />
<partial name="_Valores" />
<partial name="_Resenias" />

</div>

@section Scripts {
    <script src="~/js/tienda.js" asp-append-version="true"></script>
    <script src="~/js/resenias-carrusel.js" asp-append-version="true"></script>
    <script>
        // Banner de vehículos: se alterna solo cada 7 s (imagen y texto); se detiene al pasar el cursor o enfocarlo.
        (function () {
            var cont = document.getElementById('vbSlider');
            if (!cont) return;
            var slides = cont.querySelectorAll('.vb-slide');
            var actual = 0, timer = null;
            var reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function mostrar(i) {
                actual = (i + slides.length) % slides.length;
                slides.forEach(function (s, n) {
                    var on = n === actual;
                    s.classList.toggle('is-active', on);
                    s.setAttribute('aria-hidden', on ? 'false' : 'true');
                    var a = s.querySelector('a'); if (a) a.tabIndex = on ? 0 : -1;
                });
            }
            function iniciar() { if (reducir || timer) return; timer = setInterval(function () { mostrar(actual + 1); }, 7000); }
            function detener() { clearInterval(timer); timer = null; }

            cont.addEventListener('mouseenter', detener);
            cont.addEventListener('mouseleave', iniciar);
            cont.addEventListener('focusin', detener);
            cont.addEventListener('focusout', iniciar);
            document.addEventListener('visibilitychange', function () { document.hidden ? detener() : iniciar(); });
            iniciar();
        })();
    </script>
}
