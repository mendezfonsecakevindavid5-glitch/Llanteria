@* Tarjetas de categoría con ícono en círculo (estilo franja de servicios de interllantas.com). *@
@{
    var categorias = new (string Nombre, string Icono, string Controlador)[]
    {
        ("Llantas", "fa-solid fa-record-vinyl", "Llantas"),
        ("Lubricantes", "fa-solid fa-oil-can", "Lubricantes"),
        ("Baterías", "fa-solid fa-car-battery", "Baterias"),
        ("Accesorios", "fa-solid fa-screwdriver-wrench", "Accesorios"),
        ("Mantenimiento de flotas", "fa-solid fa-truck-front", "Empresas")
    };
}
<section id="categorias" class="tc-cats">
    <div class="container">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 justify-content-center">
            @for (var i = 0; i < categorias.Length; i++)
            {
                var c = categorias[i];
                <div class="col">
                    <a class="tc-cat" asp-controller="@c.Controlador" asp-action="Index">
                        <span class="tc-cat-art">
                            <span class="tc-cat-icon"><i class="@c.Icono"></i></span>
                        </span>
                        <span class="tc-cat-label">@c.Nombre</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
