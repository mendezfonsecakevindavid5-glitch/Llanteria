@* Imágenes: wwwroot/images/tienda/{llantas,lubricantes,baterias,accesorios,flotas}.png (todas del mismo tamaño). Si falta una, el recuadro queda gris. *@
@{
    var categorias = new (string Nombre, string Imagen, string Controlador)[]
    {
        ("Llantas", "llantas", "Llantas"),
        ("Lubricantes", "lubricantes", "Lubricantes"),
        ("Baterías", "baterias", "Baterias"),
        ("Accesorios", "accesorios", "Accesorios"),
        ("Mantenimiento de flotas", "flotas", "Empresas")
    };
}
<section id="categorias" class="tc-cats">
    <div class="container">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 justify-content-center">
            @for (var i = 0; i < categorias.Length; i++)
            {
                var c = categorias[i];
                <div class="col">
                    <a class="tc-cat" asp-controller="@c.Controlador" asp-action="Index">
                        <span class="tc-cat-art">
                            <img src="~/images/tienda/@(c.Imagen).png" alt="@c.Nombre" loading="lazy" onerror="this.style.visibility='hidden'" />
                        </span>
                        <span class="tc-cat-label">@c.Nombre</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
