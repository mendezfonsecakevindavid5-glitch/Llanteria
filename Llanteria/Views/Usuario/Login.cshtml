@model Llanteria.Models.Usuario
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - Llantería Valledupar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <style>
        :root { --llanteria-primary: #C92B0A; }
        body { min-height: 100vh; margin: 0; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; background: #F8F9FA; font-family: 'Plus Jakarta Sans', sans-serif; }
        .login-card { width: 100%; max-width: 440px; background: #fff; border-radius: 1.5rem; padding: 2.5rem; box-shadow: 0 15px 35px rgba(0, 0, 0, .1), 0 5px 15px rgba(0, 0, 0, .05); }
        .login-card .brand-matrix { display: block; text-align: center; color: #000 !important; text-shadow: none; margin-bottom: 1.75rem; }
        .login-card label { font-weight: 700; margin-bottom: .4rem; }
        .login-card .form-control { height: 52px; border-radius: .5rem; font-size: 1.05rem; }
        .login-card .form-control:focus { border-color: var(--llanteria-primary); box-shadow: 0 0 0 .22rem rgba(201, 43, 10, .14); }
        .btn-entrar { width: 100%; padding: .9rem; border: 0; border-radius: .5rem; background: var(--llanteria-primary); color: #fff; font-family: 'Roboto', sans-serif; font-weight: 700; font-size: 1.05rem; transition: background-color .2s ease; }
        .btn-entrar:hover { background: #A32008; }
    </style>
</head>
<body>
    <div class="login-card">
        <span class="brand-matrix">Llantería<small class="ms-1">Valledupar</small></span>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="username">Usuario</label>
                <input id="username" name="username" class="form-control" required />
            </div>
            <div class="mb-4">
                <label for="password">Contraseña</label>
                <input id="password" type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn-entrar">Entrar</button>
        </form>
    </div>
</body>
</html>
