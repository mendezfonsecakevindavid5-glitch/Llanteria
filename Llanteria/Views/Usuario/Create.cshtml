@model Llanteria.Models.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Registrar Nuevo Acceso</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold"></label>
                        <input asp-for="Username" class="form-control" placeholder="Ej: kmendez" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordHash" class="form-label fw-bold">Contraseña</label>
                        <input asp-for="PasswordHash" type="password" class="form-control" />
                        <span asp-validation-for="PasswordHash" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Empleado</label>
                            <select asp-for="IdEmpleado" class="form-select" asp-items="ViewBag.IdEmpleado"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Rol</label>
                            <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol"></select>
                        </div>
                    </div>

                    <div class="text-end mt-3">
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                        <button type="submit" class="btn btn-primary">Crear Usuario</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>