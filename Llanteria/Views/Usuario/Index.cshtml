@model IEnumerable<Llanteria.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Usuarios", "Accesos al sistema y su estado.", BotonTexto: "Nuevo usuario", BotonAction: "Create", BotonController: "Usuario"))

<div class="panel">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Empleado</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Última conexión</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="cell-title">@u.Username</div>
                            <div class="cell-sub">@u.Correo</div>
                        </td>
                        <td>@u.IdEmpleadoNavigation?.Nombres @u.IdEmpleadoNavigation?.Apellidos</td>
                        <td><span class="tag tag-neutral">@u.IdRolNavigation?.NombreRol</span></td>
                        <td>
                            @if (u.Estado == "Activo") { <span class="tag tag-ok">Activo</span> }
                            else if (u.Estado == "Baneado") { <span class="tag tag-bad" title="@u.MotivoSancion">Baneado</span> }
                            else { <span class="tag tag-warn">@(u.Estado ?? "Inactivo")</span> }
                        </td>
                        <td>@(u.UltimaConexion?.ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = u.Id })" data-nombre="@u.Username"
                                        data-aviso="Se perderá el acceso de este usuario."><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="empty-state">Aún no hay usuarios registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
