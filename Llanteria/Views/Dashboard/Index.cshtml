@model Llanteria.Models.DashboardViewModel
@inject Llanteria.Services.PowerBiService PowerBi

@{
    ViewData["Title"] = "Panel";
    var esAdmin = User.IsInRole("Administrador");
    var maximo = Math.Max(1m, Model.Meses.Max(m => Math.Max(m.Ventas, m.Gastos)));
}

<div class="page-header">
    <div>
        <h1>Panel</h1>
        <p>Resumen de @DateTime.Today.ToString("MMMM 'de' yyyy").</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Factura" asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Nueva factura</a>
        <a asp-controller="Cliente" asp-action="Create" class="btn btn-line">Nuevo cliente</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3"><div class="stat accent"><span class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></span><div class="label">Ventas del mes</div><div class="value money">@Model.VentasMes.ToString("C0")</div></div></div>
    <div class="col-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span><div class="label">Facturas del mes</div><div class="value">@Model.FacturasMes</div></div></div>
    <div class="col-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="fa-solid fa-users"></i></span><div class="label">Clientes</div><div class="value">@Model.TotalClientes</div></div></div>
    @if (esAdmin)
    {
        <div class="col-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="fa-solid fa-money-bill-wave"></i></span><div class="label">Gastos del mes</div><div class="value money">@Model.GastosMes.ToString("C0")</div></div></div>
    }
    else
    {
        <div class="col-6 col-xl-3"><div class="stat"><span class="stat-icon"><i class="fa-solid fa-box"></i></span><div class="label">Productos</div><div class="value">@Model.TotalProductos</div></div></div>
    }
</div>

@if (esAdmin)
{
    <div class="panel mb-3" id="panelPowerBi">
        <div class="panel-head">
            <span><i class="fa-solid fa-chart-pie me-2"></i>Análisis interactivo (Power BI)</span>
            @if (PowerBi.Configurado)
            {
                <button type="button" class="btn btn-line btn-sm" id="pbiPantallaCompleta"><i class="fa-solid fa-expand me-1"></i>Pantalla completa</button>
            }
        </div>
        <div class="panel-body p-0">
            @if (PowerBi.Configurado && !PowerBi.EsEmbebido)
            {
                <iframe id="pbiMarco" title="Informe de Power BI" src="@PowerBi.UrlIframe" loading="lazy" allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin" style="width:100%;height:640px;border:0;display:block"></iframe>
            }
            else if (PowerBi.Configurado)
            {
                <div id="pbiContenedor" data-url="@Url.Action("PowerBi", "Dashboard")" style="width:100%;height:640px"></div>
                <div id="pbiEstado" class="empty-state">Cargando informe…</div>
            }
            else
            {
                <div class="empty-state">
                    Power BI todavía no está configurado. Agrega la sección <code>PowerBI</code> en <code>Privado/appsettings.json</code>
                    (y <code>PowerBI:ClientSecret</code> en la bóveda) y vuelve a firmar con <code>boveda firmar</code>.
                </div>
            }
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel h-100">
            <div class="panel-head">
                <span>Últimos 6 meses</span>
                <span class="small text-muted">
                    <span class="legend-dot" style="background:var(--brand)"></span>Ventas
                    @if (esAdmin) { <span class="legend-dot ms-2" style="background:#16181c"></span><span>Gastos</span> }
                </span>
            </div>
            <div class="panel-body">
                <div class="bars">
                    @foreach (var m in Model.Meses)
                    {
                        <div class="bar-col" title="@m.Etiqueta: ventas @m.Ventas.ToString("C0")@(esAdmin ? ", gastos " + m.Gastos.ToString("C0") : "")">
                            <div class="bar-pair">
                                <div class="bar bar-v" style="height:@((int)(m.Ventas / maximo * 100))%"></div>
                                @if (esAdmin)
                                {
                                    <div class="bar bar-g" style="height:@((int)(m.Gastos / maximo * 100))%"></div>
                                }
                            </div>
                            <div class="bar-label">@m.Etiqueta</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel h-100">
            <div class="panel-head">
                <span>Stock bajo</span>
                <span class="tag @(Model.StockBajo.Any() ? "tag-bad" : "tag-ok")">@Model.StockBajo.Count</span>
            </div>
            @if (Model.StockBajo.Any())
            {
                <table class="data-table">
                    <tbody>
                        @foreach (var i in Model.StockBajo)
                        {
                            <tr>
                                <td>
                                    <div class="cell-title">@i.IdProductoNavigation?.Nombre</div>
                                    <div class="cell-sub">@i.IdBodegaNavigation?.NombreBodega</div>
                                </td>
                                <td class="text-end"><strong>@i.StockActual</strong> <span class="cell-sub">/ mín. @i.StockMinimo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Ningún producto por debajo del mínimo.</div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="panel">
            <div class="panel-head">
                <span>Más vendidos (últimos 90 días)</span>
            </div>
            @if (Model.MasVendidos.Any())
            {
                <table class="data-table">
                    <thead><tr><th>Producto o servicio</th><th class="text-end">Unidades</th><th class="text-end">Total vendido</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.MasVendidos)
                        {
                            <tr><td class="cell-title">@t.Nombre</td><td class="text-end">@t.Unidades</td><td class="text-end money">@t.Total.ToString("C0")</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Aún no hay ventas en este período.</div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="panel">
            <div class="panel-head">
                <span>Últimas ventas</span>
                <a asp-controller="Factura" asp-action="Index" class="small">Ver todas</a>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>N.º</th><th>Fecha</th><th>Cliente</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.UltimasFacturas)
                        {
                            <tr>
                                <td class="cell-title"><a asp-controller="Factura" asp-action="Details" asp-route-id="@f.Id">#@f.Id</a></td>
                                <td>@f.Fecha?.ToString("dd/MM/yyyy")</td>
                                <td>@f.IdClienteNavigation?.Nombres @f.IdClienteNavigation?.Apellidos</td>
                                <td class="text-end money">@f.TotalPagar.ToString("C0")</td>
                            </tr>
                        }
                        @if (!Model.UltimasFacturas.Any())
                        {
                            <tr><td colspan="4" class="empty-state">Todavía no hay ventas registradas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (esAdmin)
    {
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-head"><span>Gastos por pagar</span></div>
                <div class="panel-body">
                    <div class="value money fs-4 fw-bold">@Model.GastosPendientes.ToString("C0")</div>
                    <p class="text-muted mb-2">@Model.GastosPorVencer gasto(s) vencen en los próximos 7 días o ya vencieron.</p>
                    <a asp-controller="Gasto" asp-action="Index" class="btn btn-line btn-sm">Ver gastos</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-head"><span>Reportes y exportaciones</span></div>
                <div class="panel-body">
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="fechaInicio">Desde</label>
                            <input id="fechaInicio" type="date" class="form-control" value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="fechaFin">Hasta</label>
                            <input id="fechaFin" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <table class="data-table">
                        <thead><tr><th>Reporte</th><th class="text-end">Descargar</th></tr></thead>
                        <tbody>
                            <tr>
                                <td><div class="cell-title">General de ingresos y egresos</div><div class="cell-sub">Estado de resultados, flujo, categorías y detalle</div></td>
                                <td class="text-end text-nowrap">
                                    <a data-reporte download href="@Url.Action("GenerarGeneral", "Reporte")" class="btn btn-brand btn-sm"><i class="fa-solid fa-file-pdf me-1"></i>PDF</a>
                                    <a data-reporte download href="@Url.Action("ExcelGeneral", "Reporte")" class="btn btn-line btn-sm"><i class="fa-solid fa-file-excel me-1"></i>Excel</a>
                                </td>
                            </tr>
                            <tr>
                                <td><div class="cell-title">Ventas</div><div class="cell-sub">Facturas, IVA, retenciones y mejores clientes</div></td>
                                <td class="text-end text-nowrap">
                                    <a data-reporte download href="@Url.Action("GenerarIndividual", "Reporte", new { tipo = "Factura" })" class="btn btn-brand btn-sm"><i class="fa-solid fa-file-pdf me-1"></i>PDF</a>
                                    <a data-reporte download href="@Url.Action("ExcelIndividual", "Reporte", new { tipo = "Factura" })" class="btn btn-line btn-sm"><i class="fa-solid fa-file-excel me-1"></i>Excel</a>
                                </td>
                            </tr>
                            <tr>
                                <td><div class="cell-title">Gastos y egresos</div><div class="cell-sub">Por categoría, pagados, pendientes y vencidos</div></td>
                                <td class="text-end text-nowrap">
                                    <a data-reporte download href="@Url.Action("GenerarIndividual", "Reporte", new { tipo = "Gasto" })" class="btn btn-brand btn-sm"><i class="fa-solid fa-file-pdf me-1"></i>PDF</a>
                                    <a data-reporte download href="@Url.Action("ExcelIndividual", "Reporte", new { tipo = "Gasto" })" class="btn btn-line btn-sm"><i class="fa-solid fa-file-excel me-1"></i>Excel</a>
                                </td>
                            </tr>
                            <tr>
                                <td><div class="cell-title">Inventario</div><div class="cell-sub">Existencias por bodega, alertas y valorización (al día de hoy)</div></td>
                                <td class="text-end text-nowrap">
                                    <a download href="@Url.Action("GenerarIndividual", "Reporte", new { tipo = "Inventario" })" class="btn btn-brand btn-sm"><i class="fa-solid fa-file-pdf me-1"></i>PDF</a>
                                    <a download href="@Url.Action("ExcelIndividual", "Reporte", new { tipo = "Inventario" })" class="btn btn-line btn-sm"><i class="fa-solid fa-file-excel me-1"></i>Excel</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <script>
                        (function () {
                            var desde = document.getElementById('fechaInicio'), hasta = document.getElementById('fechaFin');
                            document.querySelectorAll('[data-reporte]').forEach(function (a) {
                                a.addEventListener('click', function (e) {
                                    if (!desde.value || !hasta.value) { e.preventDefault(); desde.focus(); return; }
                                    var u = new URL(a.getAttribute('href'), window.location.origin);
                                    u.searchParams.set('fechaInicio', desde.value);
                                    u.searchParams.set('fechaFin', hasta.value);
                                    a.setAttribute('href', u.pathname + u.search);
                                });
                            });
                        })();
                    </script>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (esAdmin && PowerBi.Configurado)
    {
        if (PowerBi.EsEmbebido)
        {
            <script src="https://cdn.jsdelivr.net/npm/powerbi-client@2.23.1/dist/powerbi.min.js"></script>
        }
        <script src="~/js/powerbi-panel.js" asp-append-version="true"></script>
    }
}
