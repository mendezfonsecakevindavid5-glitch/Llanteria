@model Llanteria.Models.DashboardViewModel

@{
    ViewData["Title"] = "Panel";
    var esAdmin = User.IsInRole("Administrador");
    var maximo = Math.Max(1m, Model.Meses.Max(m => Math.Max(m.Ventas, m.Gastos)));
}

<div class="page-header">
    <div>
        <h1>Panel</h1>
        <p>Resumen de @DateTime.Today.ToString("MMMM 'de' yyyy").</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Factura" asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Nueva factura</a>
        <a asp-controller="Cliente" asp-action="Create" class="btn btn-line">Nuevo cliente</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3"><div class="stat accent"><div class="label">Ventas del mes</div><div class="value money">@Model.VentasMes.ToString("C0")</div></div></div>
    <div class="col-6 col-xl-3"><div class="stat"><div class="label">Facturas del mes</div><div class="value">@Model.FacturasMes</div></div></div>
    <div class="col-6 col-xl-3"><div class="stat"><div class="label">Clientes</div><div class="value">@Model.TotalClientes</div></div></div>
    @if (esAdmin)
    {
        <div class="col-6 col-xl-3"><div class="stat"><div class="label">Gastos del mes</div><div class="value money">@Model.GastosMes.ToString("C0")</div></div></div>
    }
    else
    {
        <div class="col-6 col-xl-3"><div class="stat"><div class="label">Productos</div><div class="value">@Model.TotalProductos</div></div></div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel h-100">
            <div class="panel-head">
                <span>Últimos 6 meses</span>
                <span class="small text-muted">
                    <span class="legend-dot" style="background:var(--brand)"></span>Ventas
                    @if (esAdmin) { <span class="legend-dot ms-2" style="background:#6b7280"></span><span>Gastos</span> }
                </span>
            </div>
            <div class="panel-body">
                <div class="bars">
                    @foreach (var m in Model.Meses)
                    {
                        <div class="bar-col" title="@m.Etiqueta: ventas @m.Ventas.ToString("C0")@(esAdmin ? ", gastos " + m.Gastos.ToString("C0") : "")">
                            <div class="bar-pair">
                                <div class="bar bar-v" style="height:@((int)(m.Ventas / maximo * 100))%"></div>
                                @if (esAdmin)
                                {
                                    <div class="bar bar-g" style="height:@((int)(m.Gastos / maximo * 100))%"></div>
                                }
                            </div>
                            <div class="bar-label">@m.Etiqueta</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel h-100">
            <div class="panel-head">
                <span>Stock bajo</span>
                <span class="tag @(Model.StockBajo.Any() ? "tag-bad" : "tag-ok")">@Model.StockBajo.Count</span>
            </div>
            @if (Model.StockBajo.Any())
            {
                <table class="data-table">
                    <tbody>
                        @foreach (var i in Model.StockBajo)
                        {
                            <tr>
                                <td>
                                    <div class="cell-title">@i.IdProductoNavigation?.Nombre</div>
                                    <div class="cell-sub">@i.IdBodegaNavigation?.NombreBodega</div>
                                </td>
                                <td class="text-end"><strong>@i.StockActual</strong> <span class="cell-sub">/ mín. @i.StockMinimo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Ningún producto por debajo del mínimo.</div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="panel">
            <div class="panel-head">
                <span>Más vendidos (últimos 90 días)</span>
            </div>
            @if (Model.MasVendidos.Any())
            {
                <table class="data-table">
                    <thead><tr><th>Producto o servicio</th><th class="text-end">Unidades</th><th class="text-end">Total vendido</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.MasVendidos)
                        {
                            <tr><td class="cell-title">@t.Nombre</td><td class="text-end">@t.Unidades</td><td class="text-end money">@t.Total.ToString("C0")</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Aún no hay ventas en este período.</div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="panel">
            <div class="panel-head">
                <span>Últimas ventas</span>
                <a asp-controller="Factura" asp-action="Index" class="small">Ver todas</a>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>N.º</th><th>Fecha</th><th>Cliente</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.UltimasFacturas)
                        {
                            <tr>
                                <td class="cell-title"><a asp-controller="Factura" asp-action="Details" asp-route-id="@f.Id">#@f.Id</a></td>
                                <td>@f.Fecha?.ToString("dd/MM/yyyy")</td>
                                <td>@f.IdClienteNavigation?.Nombres @f.IdClienteNavigation?.Apellidos</td>
                                <td class="text-end money">@f.TotalPagar.ToString("C0")</td>
                            </tr>
                        }
                        @if (!Model.UltimasFacturas.Any())
                        {
                            <tr><td colspan="4" class="empty-state">Todavía no hay ventas registradas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (esAdmin)
    {
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-head"><span>Gastos por pagar</span></div>
                <div class="panel-body">
                    <div class="value money fs-4 fw-bold">@Model.GastosPendientes.ToString("C0")</div>
                    <p class="text-muted mb-2">@Model.GastosPorVencer gasto(s) vencen en los próximos 7 días o ya vencieron.</p>
                    <a asp-controller="Gasto" asp-action="Index" class="btn btn-line btn-sm">Ver gastos</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-head"><span>Reportes en PDF</span></div>
                <div class="panel-body">
                    <form asp-controller="Reporte" asp-action="GenerarGeneral" method="get" class="row g-2 align-items-end mb-3">
                        <div class="col-sm-5">
                            <label class="form-label" for="fechaInicio">Desde</label>
                            <input id="fechaInicio" name="fechaInicio" type="date" class="form-control" value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label" for="fechaFin">Hasta</label>
                            <input id="fechaFin" name="fechaFin" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-sm-2"><button class="btn btn-brand w-100">General</button></div>
                    </form>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Reporte" asp-action="GenerarIndividual" asp-route-tipo="Factura" class="btn btn-line btn-sm">Ventas</a>
                        <a asp-controller="Reporte" asp-action="GenerarIndividual" asp-route-tipo="Gasto" class="btn btn-line btn-sm">Gastos</a>
                        <a asp-controller="Reporte" asp-action="GenerarIndividual" asp-route-tipo="Inventario" class="btn btn-line btn-sm">Inventario</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .legend-dot { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:.3rem; }
        .bars { display:flex; align-items:flex-end; gap:.75rem; height:220px; }
        .bar-col { flex:1; height:100%; display:flex; flex-direction:column; justify-content:flex-end; }
        .bar-pair { flex:1; display:flex; align-items:flex-end; justify-content:center; gap:4px; }
        .bar { width:42%; max-width:34px; min-height:2px; border-radius:3px 3px 0 0; }
        .bar-v { background:var(--brand); }
        .bar-g { background:#6b7280; }
        .bar-label { text-align:center; font-size:12px; color:var(--muted); margin-top:.4rem; text-transform:capitalize; }
    </style>
}
