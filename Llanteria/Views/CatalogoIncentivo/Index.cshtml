@model IEnumerable<Llanteria.Models.CatalogoIncentivo>

@{
    ViewData["Title"] = "Catálogo de Premios";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <div>
        <h2 class="text-dark"><i class="fa-solid fa-gift text-primary"></i> Premios e Incentivos</h2>
        <p class="text-muted">Gestiona los premios disponibles para los clientes más fieles.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> Agregar Nuevo Premio
    </a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h5 class="card-title fw-bold text-primary">@item.NombrePremio</h5>
                        <span class="badge bg-warning text-dark">
                            <i class="fa-solid fa-star"></i> @item.PuntosRequeridos pts
                        </span>
                    </div>
                    <p class="card-text text-secondary mt-2">@item.Descripcion</p>
                </div>
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center pb-3">
                    <small class="text-muted">
                        <i class="fa-solid fa-box"></i> Stock: <strong>@item.StockDisponible</strong>
                    </small>
                    <div>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <button onclick="confirmarEliminar(@item.Id, '@item.NombrePremio')" class="btn btn-outline-danger btn-sm">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar incentivo?',
                text: "Se quitará del catálogo: " + nombre,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/CatalogoIncentivo/Delete/' + id;
                }
            })
        }
    </script>
}