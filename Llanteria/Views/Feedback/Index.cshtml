@model Llanteria.Models.Sugerencia
@{
    ViewData["Title"] = "Ayúdanos a mejorar";
}

<div class="container py-5">
    <div class="mb-4">
        <span class="eyebrow">Tu opinión</span>
        <h1 class="section-title mt-1">Ayúdanos a mejorar el sitio</h1>
        <p class="section-sub">Cuéntanos qué cambiarías o qué te costó encontrar. Leemos todas las sugerencias.</p>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="contact-form-card">
                <form asp-action="Index" method="post">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" asp-for="Area">Área</label>
                            <select asp-for="Area" class="form-select contact-form-input">
                                <option value="">Selecciona…</option>
                                @foreach (var a in Llanteria.Models.Sugerencia.Areas) { <option value="@a" selected="@(Model.Area == a)">@a</option> }
                            </select>
                            <span asp-validation-for="Area" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" asp-for="Calificacion">Calificación del sitio</label>
                            <select asp-for="Calificacion" class="form-select contact-form-input">
                                @for (var i = 5; i >= 1; i--) { <option value="@i" selected="@(Model.Calificacion == i)">@i de 5</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="Mensaje">Tu sugerencia</label>
                            <textarea asp-for="Mensaje" rows="6" maxlength="1000" class="form-control contact-form-input" placeholder="Describe qué mejorarías y por qué."></textarea>
                            <span asp-validation-for="Mensaje" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Nombre">Nombre (opcional)</label>
                            <input asp-for="Nombre" class="form-control contact-form-input" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Correo">Correo (opcional)</label>
                            <input asp-for="Correo" type="email" class="form-control contact-form-input" maxlength="100" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>
                        <div class="col-12"><partial name="_AvisoDatos" /></div>
                        <div class="col-12"><button type="submit" class="btn btn-hyper-action px-4 py-2">Enviar sugerencia</button></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
