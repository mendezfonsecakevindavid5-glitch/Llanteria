@model Llanteria.Models.Cliente

@{
    ViewData["Title"] = "Crear cuenta";
}

<style>
    .register-container-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 250px);
        padding: 2rem 1rem;
    }

    @@keyframes slideUpEntrance {
        0% {
            opacity: 0;
            transform: translateY(30px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .entrance-register-card {
        background-color: #ffffff;
        width: 100%;
        max-width: 650px;
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), 0 10px 20px rgba(0, 0, 0, 0.1);
        animation: slideUpEntrance 0.6s ease-out forwards;
    }

    .header-group {
        margin-bottom: 2rem;
        text-align: center;
    }

    .form-description {
        margin-top: 1rem;
    }

    .custom-field-label {
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: block;
        color: #212529;
    }

    .custom-input {
        height: 55px;
        font-size: 1.1rem;
        border: 1px solid #ced4da;
        border-radius: 0.5rem;
        width: 100%;
        padding-left: 15px;
    }

    .unified-document-group {
        display: flex;
        align-items: center;
        border: 1px solid #ced4da;
        border-radius: 0.5rem;
        height: 55px;
        position: relative;
        background-color: #fff;
    }

        .unified-document-group:focus-within {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .doc-type-selector {
        display: flex;
        align-items: center;
        height: 100%;
        cursor: pointer;
        user-select: none;
        padding-left: 15px;
        padding-right: 10px;
        border-radius: 0.5rem 0 0 0.5rem;
    }

    .doc-divider {
        width: 1px;
        height: 60%;
        background-color: #adb5bd;
        margin: 0 5px;
    }

    .doc-number-input {
        flex-grow: 1;
        border: none;
        outline: none;
        padding-left: 10px;
        height: 100%;
        background: transparent;
        border-radius: 0 0.5rem 0.5rem 0;
        font-size: 1.1rem;
    }

    .doc-arrow {
        color: #000000;
        font-size: 0.9rem;
        transition: transform 0.3s ease;
        margin-right: 8px;
    }

        .doc-arrow.rotate {
            transform: rotate(-180deg);
        }

    .doc-acronym {
        color: #000000;
        font-weight: 600;
        font-size: 1.05rem;
        white-space: nowrap;
    }

    .custom-dropdown-menu {
        position: absolute;
        bottom: calc(100% + 10px); /* Aparece por encima */
        left: 0;
        width: 200px; /* Ancho fijo para que no sea toda la barra */
        background: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 0.5rem;
        box-shadow: 0 -8px 16px rgba(0,0,0,0.1);
        padding: 0;
        list-style: none;
        display: none;
        z-index: 100;
        max-height: 200px;
        overflow-y: auto;
    }

        .custom-dropdown-menu::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 20px;
            border-width: 8px;
            border-style: solid;
            border-color: #ffffff transparent transparent transparent;
            filter: drop-shadow(0 2px 2px rgba(0,0,0,0.1));
        }

        .custom-dropdown-menu.show {
            display: block;
            animation: fadeUpIn 0.2s ease-out forwards;
        }

    @@keyframes fadeUpIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-dropdown-item {
        padding: 12px 15px;
        cursor: pointer;
        transition: background-color 0.2s;
        border-bottom: 1px solid #f1f1f1;
    }

        .custom-dropdown-item:last-child {
            border-bottom: none;
        }

        .custom-dropdown-item:hover {
            background-color: #f8f9fa;
        }

    .custom-error-text {
        color: var(--llanteria-primary, #C92B0A);
        font-weight: 600;
        font-size: 0.95rem;
        margin-top: 0.8rem;
        display: none;
    }

    .btn-register-submit {
        background-color: var(--llanteria-primary, #C92B0A) !important;
        color: #ffffff !important;
        border: none !important;
        font-size: 1.1rem;
        padding: 1rem;
        font-weight: 700;
        transition: filter 0.3s ease;
    }

        .btn-register-submit:hover {
            filter: brightness(0.85);
        }

    .back-link-hover {
        color: #6c757d;
        text-decoration: none;
        font-size: 1.15rem;
        font-weight: 500;
        position: relative;
        display: inline-block;
        padding-bottom: 2px;
        transition: color 0.2s ease;
    }

        .back-link-hover::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #000000;
            transition: width 0.2s ease-out;
        }

        .back-link-hover:hover {
            color: #000000;
        }

            .back-link-hover:hover::after {
                width: 100%;
            }

    .upload-box {
        background-color: #f4f5f7;
        border-radius: 1.5rem;
        height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        margin: 1.5rem auto;
        max-width: 450px;
        user-select: none;
    }

    .upload-box:active {
        transform: scale(0.93);
    }

    .upload-icon {
        font-size: 3.5rem;
        color: #212529;
    }

    .file-state {
        display: none;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .file-type-icon {
        font-size: 3.5rem;
        color: #dc3545;
        margin-bottom: 0.8rem;
    }

    .file-name-text {
        font-size: 0.95rem;
        font-weight: 600;
        color: #495057;
        word-break: break-all;
        padding: 0 15px;
    }

    .remove-file-btn {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 1.5rem;
        color: #000000;
        cursor: pointer;
        z-index: 10;
        transition: transform 0.2s;
    }

    .remove-file-btn:hover {
       transform: scale(1.1);
    }

    .otp-wrapper {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 1.5rem 0;
    }

    .otp-input {
        width: 55px;
        height: 65px;
        border: 2px solid #000000;
        background-color: transparent;
        border-radius: 0.5rem;
        text-align: center;
        font-size: 2rem;
        font-weight: 700;
        color: #212529;
        outline: none;
        transition: border-color 0.2s ease, transform 0.1s ease;
    }

    .otp-input:focus {
        border-color: var(--llanteria-primary, #C92B0A);
        transform: translateY(-2px);
    }

    .timer-display {
        font-size: 1.5rem;
        font-weight: 700;
        color: #dc3545;
        text-align: center;
        display: block;
        margin-bottom: 1rem;
    }
</style>

<div class="register-container-wrapper">
    <div class="entrance-register-card">

        <div class="header-group">
            <div class="d-flex align-items-center justify-content-center">
                <i class="fa-solid fa-user-plus text-dark me-3" style="font-size: 2.5rem;"></i>
                <h2 class="form-main-title m-0 fw-bold">Crear cuenta</h2>
            </div>
            <p class="form-description text-muted">
                Por favor, ingresa tus datos para registrarte en el sistema.
            </p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" novalidate>
            @Html.AntiForgeryToken()
            <div class="row g-3">

                <div id="etapa1">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="custom-field-label">Documento</label>
                            <div class="unified-document-group">
                                <input type="hidden" id="hiddenIdDocumento" name="IdDocumento" required />

                                <div class="doc-type-selector" id="docSelectorToggle">
                                    <i class="fa-solid fa-chevron-up doc-arrow" id="docArrowIcon"></i>
                                    <span class="doc-acronym" id="docAcronymText">---</span>
                                </div>
                                <div class="doc-divider"></div>
                                <input asp-for="NumeroDocumento" class="doc-number-input" type="text" id="NumeroDocumento" autocomplete="off" required />

                                <ul class="custom-dropdown-menu" id="docDropdownMenu">
                                    @if (ViewBag.TiposDocumento != null)
                                    {
                                        foreach (var tipo in ViewBag.TiposDocumento)
                                        {
                                            <li class="custom-dropdown-item" data-id="@tipo.Id" data-siglas="@(string.IsNullOrEmpty(tipo.SiglasPresentacion) ? tipo.Nombre.Substring(0, 3).ToUpper() : tipo.SiglasPresentacion)">
                                                @tipo.Nombre
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Nombres" class="custom-field-label">Nombres</label>
                            <input asp-for="Nombres" class="form-control custom-input" type="text" id="Nombres" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Apellidos" class="custom-field-label">Apellidos</label>
                            <input asp-for="Apellidos" class="form-control custom-input" type="text" id="Apellidos" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="custom-field-label">Celular / teléfono</label>
                            <input asp-for="Telefono" class="form-control custom-input" type="text" id="Telefono" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Correo" class="custom-field-label">Correo electrónico</label>
                            <input asp-for="Correo" class="form-control custom-input" type="email" id="emailInput" required />
                        </div>
                    </div>
                </div>

                <div id="etapa2" style="display: none;">
                    <div class="text-center">
                        <p class="mb-4">Hemos enviado un código de 6 dígitos a tu correo electrónico. Ingrésalo a continuación para verificar tu identidad.</p>

                        <div class="otp-wrapper" id="otpContainer">
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" />
                        </div>

                        <span class="timer-display" id="timerText">01:10</span>
                        <input type="hidden" id="TokenCompleto" name="TokenVerificacion" />

                        <div class="d-grid mt-3 mb-4">
                            <button type="button" id="btnVerificar" class="btn btn-danger text-white text-uppercase fw-bold rounded-3 py-3">
                                Verificar
                            </button>
                        </div>
                    </div>
                </div>

                <div id="etapa3" style="display: none;">
                    <div class="upload-box" id="uploadBox">
                        <input type="file" id="fileInput" name="DocumentoAdjunto" accept=".pdf, .jpg, .jpeg" style="display: none;" />

                        <div id="initialState">
                            <i class="fa-solid fa-paperclip upload-icon"></i>
                        </div>

                        <div id="fileLoadedState" class="file-state">
                            <i class="fa-solid fa-xmark remove-file-btn" id="removeFileBtn"></i>
                            <i class="fa-solid fa-file file-type-icon" id="dynamicFileIcon"></i>
                            <span class="file-name-text" id="displayFileName"></span>
                        </div>
                    </div>
                </div>

                <div id="generalError" class="custom-error-text text-center mt-3"></div>

                <div class="d-grid mt-4">
                    <button type="submit" id="btnSiguiente" class="btn btn-register-submit text-uppercase rounded-3">
                        Siguiente
                    </button>
                </div>

                <div class="text-center mt-4 border-top pt-3">
                    <a id="btnRegresar" class="back-link-hover">Regresar</a>
                </div>
            </form>
        </div>
    </div>

@section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const etapa1 = document.getElementById('etapa1');
                const etapa2 = document.getElementById('etapa2');
                const etapa3 = document.getElementById('etapa3');
                const btnRegresar = document.getElementById('btnRegresar');
                const mainTitle = document.getElementById('mainTitle');
                const mainDescription = document.getElementById('mainDescription');
                const headerIcon = document.getElementById('headerIcon');
                const registerForm = document.getElementById('registerForm');
                const btnSiguiente = document.getElementById('btnSiguiente');
                const errorContainer = document.getElementById('generalError');
                const otpInputs = document.querySelectorAll('.otp-input');
                const timerText = document.getElementById('timerText');
                let countdownInterval;

                let currentStep = 1;

                            btnRegresar.addEventListener('click', function (e) {
                e.preventDefault();
                errorContainer.style.display = 'none';

                if (currentStep === 1) {
                    // Si estamos en la etapa 1, redirige al Login
                    window.location.href = '@Url.Action("Login", "Account")';
                } else if (currentStep === 2) {
                    // De Etapa 2 a Etapa 1
                    currentStep = 1;
                    etapa2.style.display = 'none';
                    etapa1.style.display = 'block';
                    mainTitle.innerHTML = 'Crear cuenta';
                    mainDescription.innerHTML = 'Por favor, ingresa tus datos para registrarte en el sistema.';
                    headerIcon.className = 'fa-solid fa-user-plus text-dark me-3';
                    clearInterval(countdownInterval);
                    btnSiguiente.style.display = 'block'; // Volver a mostrar Siguiente
                } else if (currentStep === 3) {
                    // De Etapa 3 a Etapa 2
                    currentStep = 2;
                    etapa3.style.display = 'none';
                    etapa2.style.display = 'block';
                    mainTitle.innerHTML = 'Verificar correo';
                    mainDescription.innerHTML = 'Ingresa el código que hemos enviado a tu bandeja de entrada.';
                    headerIcon.className = 'fa-solid fa-envelope-circle-check text-dark me-3';
                    // Opcional: puedes reiniciar el temporizador aquí
                }
            });

                registerForm.addEventListener('submit', function(e) {
                    e.preventDefault(); // Detener envío por defecto
                    errorContainer.style.display = 'none';
                    errorContainer.innerHTML = '';
                    let errorMessage = "";

                    if (currentStep === 1) {
                        const docInput = document.getElementById('NumeroDocumento');
                        const nombresInput = document.getElementById('Nombres');
                        const apellidosInput = document.getElementById('Apellidos');
                        const telInput = document.getElementById('Telefono');
                        const emailInput = document.getElementById('emailInput');
                        const hiddenInput = document.getElementById('hiddenIdDocumento');

                        if (!hiddenInput.value || !docInput.value || !nombresInput.value || !apellidosInput.value || !telInput.value || !emailInput.value) {
                            errorMessage = "&bull; Por favor, completa todos los campos para continuar.";
                        } else {
                            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                            if (!emailRegex.test(emailInput.value)) {
                                errorMessage = "&bull; Por favor, introduce un correo electrónico válido.";
                            }
                        }

                        if (errorMessage !== "") {
                            errorContainer.innerHTML = errorMessage;
                            errorContainer.style.display = 'block';
                        } else {
                            currentStep = 2;
                            etapa1.style.display = 'none';
                            etapa2.style.display = 'block';

                            mainTitle.innerHTML = 'Verificar identidad';
                            mainDescription.innerHTML = 'Adjunta tu documento de identidad para verificar de forma confiable tu identidad y asegurar que coincida con los datos proporcionados.';
                            headerIcon.className = 'fa-solid fa-id-card text-dark me-3';
                            btnRegresar.removeAttribute('href');
                            btnRegresar.onclick = function() {
                                currentStep = 1;
                                etapa2.style.display = 'none';
                                etapa1.style.display = 'block';
                                mainTitle.innerHTML = 'Crear cuenta';
                                mainDescription.innerHTML = 'Por favor, ingresa tus datos para registrarte en el sistema.';
                                headerIcon.className = 'fa-solid fa-user-plus text-dark me-3';
                                btnRegresar.onclick = null;
                                btnRegresar.href = '@Url.Action("Login", "Account")';
                                errorContainer.style.display = 'none';
                            };
                        }
                    } else if (currentStep === 2) {
                        const fileInput = document.getElementById('fileInput');
                        if (fileInput.files.length === 0) {
                            errorContainer.innerHTML = "&bull; Por favor adjunta tu documento para finalizar.";
                            errorContainer.style.display = 'block';
                            return;
                        }

                        btnSiguiente.disabled = true;
                        btnSiguiente.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Procesando...';

                        registerForm.submit();
                    }
                });

                const uploadBox = document.getElementById('uploadBox');
                const fileInput = document.getElementById('fileInput');
                const initialState = document.getElementById('initialState');
                const fileLoadedState = document.getElementById('fileLoadedState');
                const displayFileName = document.getElementById('displayFileName');
                const removeFileBtn = document.getElementById('removeFileBtn');
                const dynamicFileIcon = document.getElementById('dynamicFileIcon');

                uploadBox.addEventListener('click', function(e) {
                    if (e.target !== removeFileBtn) {
                        fileInput.click();
                    }
                });

                fileInput.addEventListener('change', function() {
                    if (this.files && this.files.length > 0) {
                        const file = this.files[0];
                        const extension = file.name.split('.').pop().toLowerCase();

                        displayFileName.textContent = file.name;
                        if (extension === 'pdf') {
                            dynamicFileIcon.className = 'fa-solid fa-file-pdf file-type-icon';
                        } else if (extension === 'jpg' || extension === 'jpeg') {
                            dynamicFileIcon.className = 'fa-solid fa-file-image file-type-icon';
                        } else {
                            dynamicFileIcon.className = 'fa-solid fa-file file-type-icon';
                        }

                        initialState.style.display = 'none';
                        fileLoadedState.style.display = 'flex';
                        errorContainer.style.display = 'none';
                    }
                });

                removeFileBtn.addEventListener('click', function(e) {
                    e.stopPropagation(); 
                    fileInput.value = ''; 
                    fileLoadedState.style.display = 'none';
                    initialState.style.display = 'block';
                });

                const docInput = document.getElementById('NumeroDocumento');
                const telInput = document.getElementById('Telefono');
                const nombresInput = document.getElementById('Nombres');
                const apellidosInput = document.getElementById('Apellidos');

                function forceNumericOnly(element) {
                    element.addEventListener('input', function() { this.value = this.value.replace(/[^0-9]/g, ''); });
                }
                function preventFirstSpace(element) {
                    element.addEventListener('input', function() { if (this.value.startsWith(' ')) this.value = this.value.trimStart(); });
                }

                forceNumericOnly(docInput); forceNumericOnly(telInput);
                preventFirstSpace(nombresInput); preventFirstSpace(apellidosInput);

                const toggleBtn = document.getElementById('docSelectorToggle');
                const dropdownMenu = document.getElementById('docDropdownMenu');
                const arrowIcon = document.getElementById('docArrowIcon');
                const acronymText = document.getElementById('docAcronymText');
                const hiddenInput = document.getElementById('hiddenIdDocumento');
                const dropdownItems = document.querySelectorAll('.custom-dropdown-item');

                if (dropdownItems.length > 0) {
                    const firstItem = dropdownItems[0];
                    hiddenInput.value = firstItem.getAttribute('data-id');
                    acronymText.textContent = firstItem.getAttribute('data-siglas');
                }

                toggleBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle('show');
                    arrowIcon.classList.toggle('rotate');
                });

                dropdownItems.forEach(item => {
                    item.addEventListener('click', function() {
                        hiddenInput.value = this.getAttribute('data-id');
                        acronymText.textContent = this.getAttribute('data-siglas');
                        dropdownMenu.classList.remove('show');
                        arrowIcon.classList.remove('rotate');
                    });
                });

                document.addEventListener('click', function(e) {
                    if (!toggleBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                        dropdownMenu.classList.remove('show');
                        arrowIcon.classList.remove('rotate');
                    }
                });

                otpInputs.forEach((input, index) => {
                    input.addEventListener('input', function() {
                        this.value = this.value.replace(/[^0-9]/g, ''); // Solo números
                        if (this.value !== '') {
                            if (index < otpInputs.length - 1) otpInputs[index + 1].focus();
                        }
                        compilarToken();
                    });

                    input.addEventListener('keydown', function(e) {
                        if (e.key === 'Backspace' && this.value === '') {
                            if (index > 0) otpInputs[index - 1].focus();
                        }
                    });
                });

                function compilarToken() {
                    let token = '';
                    otpInputs.forEach(input => token += input.value);
                    document.getElementById('TokenCompleto').value = token;
                }

                function iniciarTemporizador(segundos) {
                    clearInterval(countdownInterval);
                    let tiempoRestante = segundos;

                    countdownInterval = setInterval(() => {
                        let minutos = Math.floor(tiempoRestante / 60);
                        let segs = tiempoRestante % 60;
                        timerText.textContent = `${minutos.toString().padStart(2, '0')}:${segs.toString().padStart(2, '0')}`;

                        if (tiempoRestante <= 0) {
                            clearInterval(countdownInterval);
                            timerText.textContent = "00:00";
                            errorContainer.innerHTML = "&bull; El código ha expirado. Por favor, solicita uno nuevo.";
                            errorContainer.style.display = 'block';
                            btnSiguiente.disabled = true;
                        }
                        tiempoRestante--;
                    }, 1000);
                }

                // Modificación del evento submit
                registerForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    errorContainer.style.display = 'none';
                    let errorMessage = "";

                    if (currentStep === 1) {
                        // ... (Tus validaciones de la etapa 1 se mantienen iguales) ...

                        if (errorMessage === "") {
                            // AQUÍ DEBERÍAS LLAMAR A TU BACKEND MEDIANTE FETCH PARA ENVIAR EL CORREO
                            // Simulación de paso a Etapa 2:
                            currentStep = 2;
                            etapa1.style.display = 'none';
                            etapa2.style.display = 'block';

                            mainTitle.innerHTML = 'Verificar correo';
                            mainDescription.innerHTML = 'Ingresa el código que hemos enviado a tu bandeja de entrada.';
                            headerIcon.className = 'fa-solid fa-envelope-circle-check text-dark me-3';

                            iniciarTemporizador(70);
                            otpInputs[0].focus();

                            // Configurar botón regresar
                            btnRegresar.removeAttribute('href');
                            btnRegresar.onclick = function() {
                                currentStep = 1;
                                etapa2.style.display = 'none';
                                etapa1.style.display = 'block';
                                mainTitle.innerHTML = 'Crear cuenta';
                                clearInterval(countdownInterval);
                                // Los campos conservan su valor automáticamente por el DOM
                            };
                        }
                    } else if (currentStep === 2) {
                        const token = document.getElementById('TokenCompleto').value;
                        if (token.length < 6) {
                            errorContainer.innerHTML = "&bull; Debes ingresar los 6 dígitos completos.";
                            errorContainer.style.display = 'block';
                            return;
                        }

                        // AQUÍ DEBERÍAS LLAMAR A TU BACKEND PARA VERIFICAR EL TOKEN
                        // Simulación de paso a Etapa 3 (Subida de archivo):
                        currentStep = 3;
                        etapa2.style.display = 'none';
                        etapa3.style.display = 'block';
                        clearInterval(countdownInterval);

                        mainTitle.innerHTML = 'Verificar identidad';
                        headerIcon.className = 'fa-solid fa-id-card text-dark me-3';

                        btnRegresar.onclick = function() {
                            currentStep = 2;
                            etapa3.style.display = 'none';
                            etapa2.style.display = 'block';
                            mainTitle.innerHTML = 'Verificar correo';
                            iniciarTemporizador(70); // Opcional: decidir si el contador se reinicia o continúa
                        };
                    } else if (currentStep === 3) {
                        // Lógica final de envío de formulario (Etapa archivo)
                        const fileInput = document.getElementById('fileInput');
                        if (fileInput.files.length === 0) {
                            // ...
                        }
                        registerForm.submit();
                    }
                });
            });
        </script>
    }