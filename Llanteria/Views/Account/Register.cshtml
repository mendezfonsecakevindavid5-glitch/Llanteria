@model Llanteria.Models.Cliente

@{
    ViewData["Title"] = "Club de puntos";
}

<div class="auth-wrap wide">
    <div class="auth-card">
        <h1>Únete al club de puntos</h1>
        <p class="text-muted mb-4">Regístrate, recibe 50 puntos de bienvenida y consulta tus puntos cuando quieras. Verificaremos tu correo con un código.</p>

        <form asp-action="Register" method="post" data-otp novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombres" class="form-label">Nombres</label>
                    <input asp-for="Nombres" class="form-control" maxlength="100" required />
                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellidos" class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" class="form-control" maxlength="100" required />
                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdDocumento" class="form-label">Tipo de documento</label>
                    <select asp-for="IdDocumento" class="form-select" asp-items="ViewBag.IdDocumento" required><option value="0">Seleccione…</option></select>
                    <span asp-validation-for="IdDocumento" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NumeroDocumento" class="form-label">Número de documento</label>
                    <input asp-for="NumeroDocumento" class="form-control" maxlength="20" required inputmode="numeric" />
                    <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IdSexo" class="form-label">Sexo</label>
                    <select asp-for="IdSexo" class="form-select" asp-items="ViewBag.IdSexo" required><option value="0">Seleccione…</option></select>
                    <span asp-validation-for="IdSexo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" maxlength="20" required inputmode="tel" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" id="emailInput" type="email" class="form-control" maxlength="100" required />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="contrasena">Contraseña</label>
                    <input id="contrasena" name="contrasena" type="password" class="form-control" minlength="6" required autocomplete="new-password" />
                    @Html.ValidationMessage("contrasena", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="confirmacion">Repite la contraseña</label>
                    <input id="confirmacion" name="confirmacion" type="password" class="form-control" minlength="6" required autocomplete="new-password" />
                    @Html.ValidationMessage("confirmacion", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="mt-3">
                <button type="button" id="btnEnviar" class="btn btn-line">Enviar código de verificación</button>
                <div id="bloqueCodigo" class="d-none mt-3" style="max-width:280px">
                    <label class="form-label" for="codigo">Código recibido</label>
                    <input id="codigo" class="form-control otp-input" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                    <button type="button" id="btnVerificar" class="btn btn-brand w-100 mt-2">Verificar</button>
                </div>
                <div id="otpEstado" class="small mt-2"></div>
            </div>

            <button type="submit" id="btnCrear" class="btn btn-hyper-action w-100 py-2 mt-4" disabled>Crear cuenta</button>
            <p class="small text-muted text-center mt-3 mb-0">¿Ya tienes cuenta? <a asp-action="Login" class="text-llanteria-primary">Inicia sesión</a></p>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        window.OTP = {
            enviar: '@Url.Action("EnviarCodigoOtp", "Account")',
            verificar: '@Url.Action("VerificarToken", "Account")',
            onVerified: function () { document.getElementById('btnCrear').disabled = false; }
        };
    </script>
    <script src="~/js/otp.js" asp-append-version="true"></script>
}
