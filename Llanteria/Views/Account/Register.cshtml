@model Llanteria.Models.Cliente

@{
    ViewData["Title"] = "Crear cuenta";
}

<link rel="stylesheet" href="~/css/paginas/register.css" asp-append-version="true" />

<div class="register-container-wrapper">
    <div class="entrance-register-card">
        <div class="header-group">
            <h2 id="mainTitle" class="form-main-title m-0 fw-bold">Crear cuenta</h2>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" enctype="multipart/form-data" autocomplete="off" novalidate>
            @Html.AntiForgeryToken()
            <input type="text" style="display:none" name="prevent_autofill_reg" autocomplete="username" />
            <input type="password" style="display:none" name="prevent_autofill_reg_pass" autocomplete="current-password" />

            <div>
                <div id="etapa1">
                    <div class="mb-4">
                        <label class="custom-field-label">
                            Documento
                            <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                        </label>
                        <div class="unified-group">
                            <input type="hidden" id="hiddenIdDocumento" asp-for="IdDocumento" required />
                            <div class="group-selector-toggle" id="docSelectorToggle">
                                <i class="fa-solid fa-chevron-down dropdown-arrow" id="docArrowIcon"></i>
                                <span class="dropdown-text" id="docAcronymText">Seleccionar...</span>
                            </div>
                            <div class="group-divider"></div>
                            <input asp-for="NumeroDocumento" class="group-inner-input" type="text" id="NumeroDocumento" autocomplete="off" data-lpignore="true" placeholder="Número de documento" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                            <ul class="custom-dropdown-menu" id="docDropdownMenu">
                                @if (ViewBag.TiposDocumento != null)
                                {
                                    foreach (var tipo in (IEnumerable<Llanteria.Models.TipoDocumento>)ViewBag.TiposDocumento)
                                    {
                                        string siglas = !string.IsNullOrEmpty(tipo.SiglasPresentacion) ? tipo.SiglasPresentacion : tipo.Nombre.Substring(0, 3).ToUpper();
                                        <li class="custom-dropdown-item doc-item" data-id="@tipo.Id" data-siglas="@siglas">@tipo.Nombre</li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Nombres" class="custom-field-label">
                            Nombres
                            <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                        </label>
                        <input asp-for="Nombres" class="form-control custom-input" type="text" id="Nombres" placeholder="Ingresa tus nombres" autocomplete="off" data-lpignore="true" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Apellidos" class="custom-field-label">
                            Apellidos
                            <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                        </label>
                        <input asp-for="Apellidos" class="form-control custom-input" type="text" id="Apellidos" placeholder="Ingresa tus apellidos" autocomplete="off" data-lpignore="true" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="IdSexo" class="custom-field-label">
                            Sexo
                            <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                        </label>
                        <select asp-for="IdSexo" class="form-select custom-input" id="IdSexo" autocomplete="off" required>
                            <option value="" disabled selected>Seleccionar...</option>
                            @if (ViewBag.Sexos != null)
                            {
                                foreach (var sexo in (IEnumerable<Llanteria.Models.Sexo>)ViewBag.Sexos)
                                {
                                    <option value="@sexo.Id">@sexo.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Telefono" class="custom-field-label">
                            Número de teléfono
                            <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                        </label>
                        <div class="unified-group">
                            <input type="hidden" id="hiddenPrefijoPais" name="PrefijoPais" value="+57" />
                            <div class="group-selector-toggle" id="phoneSelectorToggle">
                                <i class="fa-solid fa-chevron-down dropdown-arrow" id="phoneArrowIcon"></i>
                                <span class="dropdown-text" id="phonePrefixText">+57</span>
                            </div>
                            <div class="group-divider"></div>
                            <input asp-for="Telefono" class="group-inner-input" type="text" id="Telefono" autocomplete="off" data-lpignore="true" placeholder="Número de teléfono" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                            <ul class="custom-dropdown-menu" id="phoneDropdownMenu">
                                <li class="custom-dropdown-item phone-item" data-prefijo="+57" data-nombre="Colombia">Colombia (+57)</li>
                                <li class="custom-dropdown-item phone-item" data-prefijo="+1" data-nombre="Estados Unidos">Estados Unidos (+1)</li>
                                <li class="custom-dropdown-item phone-item" data-prefijo="+52" data-nombre="México">México (+52)</li>
                                <li class="custom-dropdown-item phone-item" data-prefijo="+34" data-nombre="España">España (+34)</li>
                                @if (ViewBag.Paises != null)
                                {
                                    foreach (var pais in (IEnumerable<Llanteria.Models.Pais>)ViewBag.Paises)
                                    {
                                        <li class="custom-dropdown-item phone-item" data-prefijo="@pais.Prefijo" data-nombre="@pais.Nombre">@pais.Nombre (@pais.Prefijo)</li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Correo" class="custom-field-label">
                            Correo electrónico
                            <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                        </label>
                        <input asp-for="Correo" class="form-control custom-input" type="email" id="emailInput" placeholder="Dirección de correo electrónico" autocomplete="off" data-lpignore="true" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                    </div>

                    <div id="generalErrorStage1" class="custom-error-text text-center mb-3"></div>

                    <div class="d-grid mt-4 mb-4">
                        <button type="submit" id="btnSiguiente" class="btn btn-register-submit text-uppercase rounded-3 btn-muted">
                            Siguiente
                        </button>
                    </div>

                    <div class="text-center pt-4 border-top">
                        <span style="color: #000000;">¿Ya tienes una cuenta?</span>
                        <a id="btnRegresarLogin" class="text-danger fw-bold text-decoration-none ms-2" style="cursor: pointer;">Inicia sesión aquí</a>
                    </div>
                </div>

                <div id="etapa2" style="display: none;">
                    <p class="text-center text-muted mb-4" style="font-size: 0.95rem;">
                        Ingrese el código enviado a <br />
                        <span class="fw-bold text-dark" id="censoredEmailDisplay"></span>
                    </p>

                    <div class="text-center">
                        <div class="otp-wrapper my-4" id="otpContainer">
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" data-lpignore="true" onpaste="return false;" oncopy="return false;" oncut="return false;" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" data-lpignore="true" onpaste="return false;" oncopy="return false;" oncut="return false;" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" data-lpignore="true" onpaste="return false;" oncopy="return false;" oncut="return false;" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" data-lpignore="true" onpaste="return false;" oncopy="return false;" oncut="return false;" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" data-lpignore="true" onpaste="return false;" oncopy="return false;" oncut="return false;" />
                            <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" autocomplete="off" data-lpignore="true" onpaste="return false;" oncopy="return false;" oncut="return false;" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center my-4">
                            <div class="timer-container m-0">
                                <span id="timerText">01:20</span>
                            </div>
                            <div>
                                <span id="resendCodeBtn" class="resend-link" style="display: none;">Enviar nuevo código</span>
                            </div>
                        </div>

                        <input type="hidden" id="TokenCompleto" name="TokenVerificacion" />
                    </div>

                    <div id="generalErrorStage2" class="custom-error-text text-center mb-3"></div>

                    <div class="d-grid mt-5">
                        <button type="button" id="btnVerificar" class="btn btn-register-submit text-uppercase rounded-3 btn-muted">
                            Verificar
                        </button>
                    </div>
                </div>

                <div id="etapa3" style="display: none;">
                    <div class="stage3-grid mb-4">
                        <div class="avatar-upload-container">
                            <label class="custom-field-label text-center w-100">Foto de perfil</label>
                            <div class="avatar-circle-btn" id="btnSelectFoto">
                                <i class="fa-solid fa-user" id="avatarIcon"></i>
                                <img id="avatarImgPreview" class="avatar-preview-img" style="display: none;" />
                            </div>
                            <input type="file" id="fileFotoInput" name="FotoPerfilFile" accept="image/*" style="display: none;" />
                            <input type="hidden" id="hiddenFotoBase64" name="FotoBase64" />
                        </div>

                        <div class="stage3-inputs-wrapper">
                            <div class="mb-3">
                                <label class="custom-field-label">
                                    Nombre de usuario
                                    <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                                </label>
                                <div class="input-wrapper">
                                    <input type="text" id="usernameInput" name="Username" class="form-control custom-input" placeholder="Nombre de usuario" maxlength="50" autocomplete="off" data-lpignore="true" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="custom-field-label">
                                    Contraseña
                                    <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                                </label>
                                <div class="input-wrapper">
                                    <button type="button" id="togglePass1" class="password-toggle-btn"><i id="eyeIcon1" class="fa-regular fa-eye-slash"></i></button>
                                    <input type="password" id="pass1" name="Password" class="form-control custom-input custom-input-password" placeholder="Contraseña" autocomplete="new-password" data-lpignore="true" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="custom-field-label">
                                    Confirmar contraseña
                                    <span class="required-asterisk">*<span class="tooltip-text">Este campo es obligatorio</span></span>
                                </label>
                                <div class="input-wrapper">
                                    <button type="button" id="togglePass2" class="password-toggle-btn"><i id="eyeIcon2" class="fa-regular fa-eye-slash"></i></button>
                                    <input type="password" id="pass2" class="form-control custom-input custom-input-password" placeholder="Confirmar contraseña" autocomplete="new-password" data-lpignore="true" spellcheck="false" onpaste="return false;" oncopy="return false;" oncut="return false;" ondrop="return false;" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 req-toggle-btn-group">
                        <button type="button" id="btnTabUser" class="req-tab-btn">Usuario</button>
                        <button type="button" id="btnTabPass" class="req-tab-btn active-req">Contraseña</button>
                    </div>

                    <div class="mb-4" style="background-color: transparent; font-size: 0.85rem;">
                        <span class="fw-bold d-block mb-2 text-dark" id="requirementsHeaderTitle">La contraseña debe cumplir con:</span>
                        <ul id="requirementsListContainer" class="mb-0 ps-0" style="line-height: 1.6; list-style: none;">
                            <li id="req-len" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Mínimo 15 caracteres en total</span></li>
                            <li id="req-upper" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 2 letras mayúsculas</span></li>
                            <li id="req-lower" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 3 letras minúsculas</span></li>
                            <li id="req-num" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 6 números</span></li>
                            <li id="req-spec" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 2 caracteres especiales</span></li>
                            <li id="req-match" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Las contraseñas coinciden</span></li>
                        </ul>
                    </div>

                    <div class="form-check mb-3" style="font-size: 0.85rem;">
                        <input class="form-check-input" type="checkbox" id="aceptaTerminosReg" name="AceptaTerminos" value="true" />
                        <label class="form-check-label" for="aceptaTerminosReg">
                            He leído y acepto los <a href="@Url.Action("Terminos", "Legal")" target="_blank" rel="noopener">términos y condiciones</a> y autorizo el tratamiento de mis datos personales según la <a href="@Url.Action("Privacidad", "Legal")" target="_blank" rel="noopener">política de tratamiento de datos</a>. <span class="required-asterisk">*</span>
                        </label>
                    </div>

                    <div id="generalErrorStage3" class="custom-error-text text-center mb-3"></div>

                    <div class="d-grid mt-4">
                        <button type="submit" id="btnFinalizarRegister" class="btn btn-register-submit text-uppercase rounded-3 btn-muted" disabled>
                            Finalizar
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="_RecorteFoto" />

@section Scripts {
    <script src="~/js/recorte-foto.js" asp-append-version="true"></script>
    <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const etapa1 = document.getElementById('etapa1');
                    const etapa2 = document.getElementById('etapa2');
                    const etapa3 = document.getElementById('etapa3');
                    const registerForm = document.getElementById('registerForm');

                    const btnSiguiente = document.getElementById('btnSiguiente');
                    const btnVerificar = document.getElementById('btnVerificar');
                    const btnFinalizarRegister = document.getElementById('btnFinalizarRegister');
                    const btnRegresarLogin = document.getElementById('btnRegresarLogin');
                    const resendCodeBtn = document.getElementById('resendCodeBtn');

                    const errorStage1 = document.getElementById('generalErrorStage1');
                    const errorStage2 = document.getElementById('generalErrorStage2');
                    const errorStage3 = document.getElementById('generalErrorStage3');

                    const docInput = document.getElementById('NumeroDocumento');
                    const telInput = document.getElementById('Telefono');
                    const nombresInput = document.getElementById('Nombres');
                    const apellidosInput = document.getElementById('Apellidos');
                    const sexoInput = document.getElementById('IdSexo');
                    const emailInput = document.getElementById('emailInput');
                    const hiddenIdDoc = document.getElementById('hiddenIdDocumento');
                    const hiddenPrefijo = document.getElementById('hiddenPrefijoPais');

                    const docToggle = document.getElementById('docSelectorToggle');
                    const docMenu = document.getElementById('docDropdownMenu');
                    const docArrow = document.getElementById('docArrowIcon');
                    const docText = document.getElementById('docAcronymText');
                    const docItems = document.querySelectorAll('.doc-item');

                    const phoneToggle = document.getElementById('phoneSelectorToggle');
                    const phoneMenu = document.getElementById('phoneDropdownMenu');
                    const phoneArrow = document.getElementById('phoneArrowIcon');
                    const phoneText = document.getElementById('phonePrefixText');
                    const phoneItems = document.querySelectorAll('.phone-item');

                    const otpInputs = document.querySelectorAll('.otp-input');
                    const timerText = document.getElementById('timerText');

                    const usernameInput = document.getElementById('usernameInput');
                    const pass1 = document.getElementById('pass1');
                    const pass2 = document.getElementById('pass2');
                    const togglePass1 = document.getElementById('togglePass1');
                    const togglePass2 = document.getElementById('togglePass2');
                    const eyeIcon1 = document.getElementById('eyeIcon1');
                    const eyeIcon2 = document.getElementById('eyeIcon2');

                    const btnTabUser = document.getElementById('btnTabUser');
                    const btnTabPass = document.getElementById('btnTabPass');
                    const requirementsHeaderTitle = document.getElementById('requirementsHeaderTitle');
                    const requirementsListContainer = document.getElementById('requirementsListContainer');
                    let viewingUsernameReqs = false;

                    const avatarIcon = document.getElementById('avatarIcon');
                    const avatarImgPreview = document.getElementById('avatarImgPreview');
                    const hiddenFotoBase64 = document.getElementById('hiddenFotoBase64');

                    let countdownInterval;
                    let currentStep = 1;

                    const allowedEmailRegex = /^[a-zA-Z0-9._%+-]+@@(gmail|outlook|hotmail)\.[a-zA-Z]{2,}$/i;

                    function getAntiForgeToken() {
                        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    }

                    document.querySelectorAll('input').forEach(inp => {
                        ['paste', 'copy', 'cut', 'drop'].forEach(ev => {
                            inp.addEventListener(ev, e => e.preventDefault());
                        });
                    });

                    btnTabUser.addEventListener('click', function () {
                        viewingUsernameReqs = true;
                        btnTabUser.classList.add('active-req');
                        btnTabPass.classList.remove('active-req');
                        requirementsHeaderTitle.textContent = "El nombre de usuario debe cumplir con:";
                        requirementsListContainer.innerHTML = `
                            <li id="req-u-len" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Mínimo 9 caracteres en total</span></li>
                            <li id="req-u-upper" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Al menos 1 letra mayúscula</span></li>
                            <li id="req-u-num" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 4 números</span></li>
                            <li id="req-u-spec" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 2 caracteres especiales</span></li>
                        `;
                        validarRequisitosEtapa3();
                    });

                    btnTabPass.addEventListener('click', function () {
                        viewingUsernameReqs = false;
                        btnTabPass.classList.add('active-req');
                        btnTabUser.classList.remove('active-req');
                        requirementsHeaderTitle.textContent = "La contraseña debe cumplir con:";
                        requirementsListContainer.innerHTML = `
                            <li id="req-len" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Mínimo 15 caracteres en total</span></li>
                            <li id="req-upper" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 2 letras mayúsculas</span></li>
                            <li id="req-lower" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 3 letras minúsculas</span></li>
                            <li id="req-num" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 6 números</span></li>
                            <li id="req-spec" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Por lo menos 2 caracteres especiales</span></li>
                            <li id="req-match" class="req-item"><i class="fa-solid fa-circle me-2 req-icon" style="font-size: 0.4rem;"></i><span>Las contraseñas coinciden</span></li>
                        `;
                        validarRequisitosEtapa3();
                    });

                    btnRegresarLogin.addEventListener('click', () => window.location.href = '@Url.Action("Login", "Account")');

                    docToggle.addEventListener('click', (e) => {
                        e.stopPropagation();
                        docMenu.classList.toggle('show');
                        docArrow.classList.toggle('rotate');
                        phoneMenu.classList.remove('show');
                    });

                    docItems.forEach(item => {
                        item.addEventListener('click', function() {
                            hiddenIdDoc.value = this.getAttribute('data-id');
                            docText.textContent = this.getAttribute('data-siglas');
                            docMenu.classList.remove('show');
                            docArrow.classList.remove('rotate');
                            verificarEtapa1();
                        });
                    });

                    phoneToggle.addEventListener('click', (e) => {
                        e.stopPropagation();
                        phoneMenu.classList.toggle('show');
                        phoneArrow.classList.toggle('rotate');
                        docMenu.classList.remove('show');
                    });

                    phoneItems.forEach(item => {
                        item.addEventListener('click', function() {
                            const pref = this.getAttribute('data-prefijo');
                            hiddenPrefijo.value = pref;
                            phoneText.textContent = pref;
                            phoneMenu.classList.remove('show');
                            phoneArrow.classList.remove('rotate');
                            verificarEtapa1();
                        });
                    });

                    document.addEventListener('click', () => {
                        docMenu.classList.remove('show');
                        docArrow.classList.remove('rotate');
                        phoneMenu.classList.remove('show');
                        phoneArrow.classList.remove('rotate');
                    });

                    function verificarEtapa1() {
                        const tieneDoc = hiddenIdDoc.value !== '' && docInput.value.trim() !== '';
                        const tieneNombres = nombresInput.value.trim() !== '';
                        const tieneApellidos = apellidosInput.value.trim() !== '';
                        const tieneSexo = sexoInput.value !== '' && sexoInput.value !== null;
                        const tieneTel = telInput.value.trim() !== '';
                        const tieneEmail = emailInput.value.trim() !== '';

                        if (tieneDoc && tieneNombres && tieneApellidos && tieneSexo && tieneTel && tieneEmail) {
                            btnSiguiente.classList.remove('btn-muted');
                            errorStage1.style.display = 'none';
                        } else {
                            btnSiguiente.classList.add('btn-muted');
                        }
                    }

                    [docInput, telInput, nombresInput, apellidosInput, emailInput, sexoInput].forEach(elem => {
                        elem.addEventListener('input', verificarEtapa1);
                        elem.addEventListener('change', verificarEtapa1);
                        elem.addEventListener('blur', verificarEtapa1);
                    });
                    setTimeout(verificarEtapa1, 200);

                    togglePass1.addEventListener('click', () => {
                        const isPass = pass1.type === 'password';
                        pass1.type = isPass ? 'text' : 'password';
                        eyeIcon1.classList.toggle('fa-eye-slash', !isPass);
                        eyeIcon1.classList.toggle('fa-eye', isPass);
                    });

                    togglePass2.addEventListener('click', () => {
                        const isPass = pass2.type === 'password';
                        pass2.type = isPass ? 'text' : 'password';
                        eyeIcon2.classList.toggle('fa-eye-slash', !isPass);
                        eyeIcon2.classList.toggle('fa-eye', isPass);
                    });

                    function toggleRequirement(elementId, conditionMet) {
                        const el = document.getElementById(elementId);
                        if (!el) return conditionMet;
                        const icon = el.querySelector('i');

                        if (conditionMet) {
                            el.classList.add('valid');
                            if (icon) {
                                icon.classList.replace('fa-circle', 'fa-check');
                                icon.style.fontSize = '0.8rem';
                            }
                        } else {
                            el.classList.remove('valid');
                            if (icon) {
                                icon.classList.replace('fa-check', 'fa-circle');
                                icon.style.fontSize = '0.4rem';
                            }
                        }
                        return conditionMet;
                    }

                    function validarRequisitosEtapa3() {
                        const uVal = usernameInput ? usernameInput.value.trim() : '';
                        const p1 = pass1 ? pass1.value : '';
                        const p2 = pass2 ? pass2.value : '';

                        const uUpper = /[A-Z]/.test(uVal);
                        const uNum = (uVal.match(/[0-9]/g) || []).length >= 4;
                        const uSpec = (uVal.match(/[^a-zA-Z0-9]/g) || []).length >= 2;
                        const uLen = uVal.length >= 9;
                        const isUsernameValid = uUpper && uNum && uSpec && uLen;

                        if (viewingUsernameReqs) {
                            toggleRequirement('req-u-len', uLen);
                            toggleRequirement('req-u-upper', uUpper);
                            toggleRequirement('req-u-num', uNum);
                            toggleRequirement('req-u-spec', uSpec);
                        } else {
                            toggleRequirement('req-len', p1.length >= 15);
                            toggleRequirement('req-upper', (p1.match(/[A-Z]/g) || []).length >= 2);
                            toggleRequirement('req-lower', (p1.match(/[a-z]/g) || []).length >= 3);
                            toggleRequirement('req-num', (p1.match(/[0-9]/g) || []).length >= 6);
                            toggleRequirement('req-spec', (p1.match(/[^a-zA-Z0-9]/g) || []).length >= 2);
                            toggleRequirement('req-match', p1 !== '' && p1 === p2);
                        }

                        const rLen = p1.length >= 15;
                        const rUpper = (p1.match(/[A-Z]/g) || []).length >= 2;
                        const rLower = (p1.match(/[a-z]/g) || []).length >= 3;
                        const rNum = (p1.match(/[0-9]/g) || []).length >= 6;
                        const rSpec = (p1.match(/[^a-zA-Z0-9]/g) || []).length >= 2;
                        const rMatch = p1 !== '' && p1 === p2;
                        const isPasswordValid = rLen && rUpper && rLower && rNum && rSpec && rMatch;

                        const aceptaChk = document.getElementById('aceptaTerminosReg');
                        const aceptaOk = !aceptaChk || aceptaChk.checked;

                        if (isUsernameValid && isPasswordValid && aceptaOk) {
                            btnFinalizarRegister.disabled = false;
                            btnFinalizarRegister.classList.remove('btn-muted');
                        } else {
                            btnFinalizarRegister.disabled = true;
                            btnFinalizarRegister.classList.add('btn-muted');
                        }
                    }

                    if (usernameInput) usernameInput.addEventListener('input', validarRequisitosEtapa3);
                    if (pass1) pass1.addEventListener('input', validarRequisitosEtapa3);
                    if (pass2) pass2.addEventListener('input', validarRequisitosEtapa3);
                    const chkTerminos = document.getElementById('aceptaTerminosReg');
                    if (chkTerminos) chkTerminos.addEventListener('change', validarRequisitosEtapa3);

                    RecorteFoto.iniciar({
                        boton: '#btnSelectFoto',
                        archivo: '#fileFotoInput',
                        alAceptar: function (foto) {
                            hiddenFotoBase64.value = foto;
                            avatarImgPreview.src = foto;
                            avatarImgPreview.style.display = 'block';
                            avatarIcon.style.display = 'none';
                        }
                    });

                    registerForm.addEventListener('submit', async function(e) {
                        if (currentStep === 1) {
                            e.preventDefault();
                            if (!allowedEmailRegex.test(emailInput.value.trim())) {
                                errorStage1.innerHTML = "&bull; Solo se permiten correos con dominio Gmail, Outlook o Hotmail.";
                                errorStage1.style.display = 'block';
                                return;
                            }

                            btnSiguiente.disabled = true;
                            btnSiguiente.innerHTML = '<span class="wave-dot">.</span><span class="wave-dot">.</span><span class="wave-dot">.</span><span class="wave-dot">.</span>';

                            try {
                                const response = await fetch('@Url.Action("EnviarCodigoOtp", "Account")', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'RequestVerificationToken': getAntiForgeToken()
                                    },
                                    body: JSON.stringify({
                                        correo: emailInput.value.trim(),
                                        nombre: nombresInput.value.trim() + ' ' + apellidosInput.value.trim()
                                    })
                                });
                                const textoRespuesta = await response.text();
        let resData;
        try { resData = JSON.parse(textoRespuesta); }
        catch (e) { resData = { success: false, message: 'El servidor no pudo guardar tus datos (código ' + response.status + '). Inténtalo de nuevo; si sigue igual, avisa al administrador.' }; }

                                if (resData.success) {
                                    const [nombre, dominio] = emailInput.value.trim().split('\u0040');
                                    const censored = nombre.length <= 2 ? nombre + '***\u0040' + dominio : nombre.substring(0, 2) + '*'.repeat(nombre.length - 2) + '\u0040' + dominio;
                                    document.getElementById('censoredEmailDisplay').textContent = censored;

                                    currentStep = 2;
                                    etapa1.style.display = 'none';
                                    etapa2.style.display = 'block';
                                    iniciarTemporizador(60);
                                    otpInputs[0].focus();
                                } else {
                                    errorStage1.innerHTML = "&bull; " + (resData.message || "Error al enviar correo.");
                                    errorStage1.style.display = 'block';
                                }
                            } catch (err) {
                                errorStage1.innerHTML = "&bull; Error de conexión.";
                                errorStage1.style.display = 'block';
                            } finally {
                                btnSiguiente.disabled = false;
                                btnSiguiente.innerHTML = 'SIGUIENTE';
                            }
                        } else if (currentStep === 3) {
                            e.preventDefault();
                            errorStage3.style.display = 'none';

                            btnFinalizarRegister.disabled = true;
                            btnFinalizarRegister.innerHTML = '<span class="wave-dot">.</span><span class="wave-dot">.</span><span class="wave-dot">.</span><span class="wave-dot">.</span>';

                            try {
                                const formData = new FormData(registerForm);
                                const telefonoCompleto = hiddenPrefijo.value + ' ' + telInput.value.trim();
                                formData.set('Telefono', telefonoCompleto);

                                const response = await fetch('@Url.Action("Register", "Account")', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': getAntiForgeToken()
            },
            body: formData
        });
        const resData = await response.json();

                                if (resData.success) {
                                    window.location.href = resData.redirectUrl;
                                } else {
                                    errorStage3.innerHTML = "&bull; " + (resData.message || "No se pudo completar el registro.");
                                    errorStage3.style.display = 'block';
                                    btnFinalizarRegister.disabled = false;
                                    btnFinalizarRegister.innerHTML = 'FINALIZAR';
                                }
                            } catch (err) {
                                errorStage3.innerHTML = "&bull; Error de conexión: " + err.message;
                                errorStage3.style.display = 'block';
                                btnFinalizarRegister.disabled = false;
                                btnFinalizarRegister.innerHTML = 'FINALIZAR';
                            }
                        }
                    });

                    btnVerificar.addEventListener('click', async function () {
                        let token = '';
                        otpInputs.forEach(inp => token += inp.value);
                        if (token.length < 6) return;

                        clearInterval(countdownInterval);

                        btnVerificar.style.pointerEvents = 'none';
                        btnVerificar.innerHTML = '<span class="wave-dot">.</span><span class="wave-dot">.</span><span class="wave-dot">.</span><span class="wave-dot">.</span>';

                        try {
                            const response = await fetch('@Url.Action("VerificarToken", "Account")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': getAntiForgeToken()
                                },
                                body: JSON.stringify(token)
                            });
                            const resData = await response.json();

                            if (resData.success) {
                                btnVerificar.innerHTML = '<i class="fa-solid fa-check me-2"></i>CORRECTO';
                                setTimeout(() => {
                                    currentStep = 3;
                                    etapa2.style.display = 'none';
                                    etapa3.style.display = 'block';
                                    document.getElementById('mainTitle').textContent = 'Completa tu registro';
                                    validarRequisitosEtapa3();
                                }, 600);
                            } else {
                                btnVerificar.classList.add('btn-incorrect');
                                btnVerificar.innerHTML = '<i class="fa-solid fa-xmark me-2"></i>INCORRECTO';
                                resendCodeBtn.style.display = 'inline-block';
                                btnVerificar.style.pointerEvents = 'auto';
                            }
                        } catch (err) {
                            btnVerificar.classList.add('btn-incorrect');
                            btnVerificar.innerHTML = '<i class="fa-solid fa-xmark me-2"></i>INCORRECTO';
                            resendCodeBtn.style.display = 'inline-block';
                            btnVerificar.style.pointerEvents = 'auto';
                        }
                    });

                    otpInputs.forEach((input, index) => {
                        input.addEventListener('input', function() {
                            this.value = this.value.replace(/[^0-9]/g, '');
                            if (this.value !== '' && index < otpInputs.length - 1) otpInputs[index + 1].focus();
                            let t = '';
                            otpInputs.forEach(i => t += i.value);
                            if (t.length === 6) {
                                btnVerificar.classList.remove('btn-muted');
                                btnVerificar.click();
                            } else {
                                btnVerificar.classList.add('btn-muted');
                            }
                        });
                        input.addEventListener('keydown', function(e) {
                            if (e.key === 'Backspace' && this.value === '' && index > 0) otpInputs[index - 1].focus();
                        });
                    });

                    function formatearNombreYApellido(e) {
                        let valor = e.target.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '');
                        valor = valor.replace(/(?:^|\s)\S/g, function(letra) { return letra.toUpperCase(); });
                        e.target.value = valor;
                    }

                    nombresInput.addEventListener('input', formatearNombreYApellido);
                    apellidosInput.addEventListener('input', formatearNombreYApellido);

                    function iniciarTemporizador(segundos) {
                        clearInterval(countdownInterval);
                        resendCodeBtn.style.display = 'none';
                        let tiempoRestante = segundos;
                        countdownInterval = setInterval(() => {
                            let min = Math.floor(tiempoRestante / 60);
                            let seg = tiempoRestante % 60;
                            timerText.textContent = `${min < 10 ? '0' + min : min}:${seg < 10 ? '0' + seg : seg}`;
                            if (--tiempoRestante < 0) {
                                clearInterval(countdownInterval);
                                resendCodeBtn.style.display = 'inline-block';
                            }
                        }, 1000);
                    }

                    resendCodeBtn.addEventListener('click', async function () {
                        resendCodeBtn.style.display = 'none';
                        otpInputs.forEach(inp => inp.value = '');
                        document.getElementById('TokenCompleto').value = '';
                        btnVerificar.classList.remove('btn-incorrect');
                        btnVerificar.classList.add('btn-muted');
                        btnVerificar.textContent = 'Verificar';
                        errorStage2.style.display = 'none';

                        try {
                            await fetch('@Url.Action("EnviarCodigoOtp", "Account")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'RequestVerificationToken': getAntiForgeToken()
                                },
                                body: JSON.stringify({
                                    correo: emailInput.value.trim(),
                                    nombre: nombresInput.value.trim() + ' ' + apellidosInput.value.trim()
                                })
                            });
                            iniciarTemporizador(60);
                        } catch (err) {
                            errorStage2.innerHTML = "&bull; No se pudo reenviar el código.";
                            errorStage2.style.display = 'block';
                            resendCodeBtn.style.display = 'inline-block';
                        }
                    });
                });
    </script>
}