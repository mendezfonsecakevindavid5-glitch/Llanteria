@{
    Layout = null;
    ViewData["Title"] = "Acceso Restringido";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seguridad - Sistema Llantería</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #09090B;
            color: #FFFFFF;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .error-card {
            text-align: center;
            padding: 3rem;
            border: 2px dashed #C92B0A;
            border-radius: 1rem;
            max-width: 500px;
            background-color: #121214;
        }
        .pixel-face {
            font-size: 4rem;
            color: #C92B0A;
            margin-bottom: 1.5rem;
            font-weight: bold;
        }
        .error-msg {
            font-size: 1.2rem;
            color: #e0e0e0;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="pixel-face">(>_<)</div>
        <div class="error-msg">Ha ocurrido un error inesperado, por favor sea paciente.</div>
    </div>
</body>
</html>