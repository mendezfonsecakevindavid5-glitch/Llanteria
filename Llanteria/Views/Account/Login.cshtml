@{
    ViewData["Title"] = "Ingreso al Sistema";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
            <div class="text-center mb-4">
                <div class="bg-light text-danger p-3 rounded-circle d-inline-block mb-3 shadow-sm" style="width: 70px; height: 70px; border: 2px solid #C92B0A;">
                    <i class="fa-solid fa-user-shield fa-2x mt-2" style="color: #C92B0A;"></i>
                </div>
                
                <h4 class="fw-bold text-dark m-0">Ingreso al Sistema</h4>
                <p class="text-muted small">Acceso para Clientes, Personal y Administradores</p>
                
                <div class="d-flex justify-content-center gap-3 mt-2 text-secondary small">
                    <span><i class="fa-solid fa-user me-1"></i>Cliente</span>
                    <span><i class="fa-solid fa-screwdriver-wrench me-1"></i>Personal</span>
                    <span><i class="fa-solid fa-lock me-1"></i>Admin</span>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 py-2 text-center rounded-3 shadow-sm mb-3" role="alert">
                    <small><i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Error</small>
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <div class="form-floating">
                        <input type="text" name="username" class="form-control" placeholder="nombre.usuario" required />
                        <label class="text-muted"><i class="fa-solid fa-user me-2"></i>Nombre de Usuario</label>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-floating">
                        <input type="password" name="password" class="form-control" placeholder="Contraseña" required />
                        <label class="text-muted"><i class="fa-solid fa-key me-2"></i>Contraseña</label>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn py-2 fw-bold text-uppercase text-white rounded-3 shadow-sm" style="background-color: #C92B0A; border: none;">
                        Entrar al Sistema
                    </button>
                </div>
            </form>

            <div class="text-center mt-3">
                <small class="text-muted">¿No tienes cuenta? <a asp-controller="Account" asp-action="Register" class="text-danger fw-bold">Regístrate aquí</a></small>
            </div>
        </div>
    </div>
</div>