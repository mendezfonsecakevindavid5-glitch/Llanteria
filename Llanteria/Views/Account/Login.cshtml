@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Iniciar sesión</h1>
        <p class="text-muted mb-4">Personal del taller: usuario o correo. Clientes: correo o documento.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="mb-3">
                <label class="form-label" for="username">Usuario, correo o documento</label>
                <input id="username" name="username" class="form-control" required autofocus autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Contraseña</label>
                <div class="input-group">
                    <input id="password" name="password" type="password" class="form-control" required autocomplete="current-password" />
                    <button class="btn btn-line" type="button" id="verPass" title="Mostrar u ocultar"><i class="fa-regular fa-eye"></i></button>
                </div>
            </div>
            <button type="submit" class="btn btn-hyper-action w-100 py-2">Entrar</button>
        </form>

        <div class="d-flex justify-content-between mt-3 small">
            <a asp-action="ReestablecerContra" class="text-llanteria-primary text-decoration-none">¿Olvidaste tu contraseña?</a>
            <a asp-action="Register" class="text-llanteria-primary text-decoration-none">Crear cuenta de puntos</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('verPass').addEventListener('click', function () {
            const i = document.getElementById('password');
            i.type = i.type === 'password' ? 'text' : 'password';
        });
    </script>
}
