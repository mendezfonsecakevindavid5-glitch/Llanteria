@{
    ViewData["Title"] = "Ingreso al Sistema";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm rounded-xl p-4 bg-white">
            <div class="text-center mb-4">
                <div class="bg-dark text-warning p-3 rounded-circle d-inline-block mb-2 shadow-sm" style="width: 65px; height: 65px;">
                    <i class="fa-solid fa-lock fa-xl"></i>
                </div>
                <h4 class="fw-bold text-dark m-0">Ingreso Administrativo</h4>
                <p class="text-muted small">Personal Técnico, Empleados y Administradores</p>
            </div>

            <!-- Alerta de Credenciales Inválidas o Cuenta Inactiva -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger font-sm border-0 py-2 text-center rounded-3 shadow-sm mb-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <div class="form-floating">
                        <input type="text" name="username" class="form-control" placeholder="usuario123" required />
                        <label class="text-muted"><i class="fa-solid fa-user me-2"></i>Nombre de Usuario</label>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-floating">
                        <input type="password" name="password" class="form-control" placeholder="Contraseña" required />
                        <label class="text-muted"><i class="fa-solid fa-key me-2"></i>Contraseña</label>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary py-2 fw-bold text-uppercase text-white rounded-3 shadow-sm transition-transform">
                        Entrar al Sistema
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>