@{
    ViewData["Title"] = "Ingreso al Sistema";
}

<style>
    /* Contenedor principal */
    .login-container-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 250px);
        padding: 2rem 1rem;
    }

    /* Tarjeta con animación */
    .entrance-login-card {
        background-color: #ffffff;
        width: 100%;
        max-width: 480px;
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1), 0 5px 15px rgba(0, 0, 0, 0.05);
        animation: slideUpEntrance 0.6s ease-out forwards;
        opacity: 0;
    }

    @@keyframes slideUpEntrance {
        0% {
            transform: translateY(20px);
            opacity: 0;
        }

        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* Estilos visuales personalizados */
    .icon-header-circle {
        width: 70px;
        height: 70px;
        border: 2px solid #C92B0A;
        background-color: #fff5f5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .form-main-title {
        font-size: 1.7rem;
        font-weight: 800;
        color: #000000;
    }

    .custom-field-label {
        display: block;
        font-size: 1.1rem;
        font-weight: 700;
        color: #000000;
        margin-bottom: 0.5rem;
        text-align: left;
    }

    .custom-input-group {
        height: 55px;
    }

        .custom-input-group .form-control {
            font-size: 1.1rem;
            border: 1px solid #ced4da;
            border-left: none;
            border-radius: 0 0.5rem 0.5rem 0;
        }

    .input-icon-text {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-right: none;
        border-radius: 0.5rem 0 0 0.5rem;
        padding: 0 1rem;
        display: flex;
        align-items: center;
        font-size: 1.2rem;
    }

    .password-toggle-btn {
        background: transparent;
        border: none;
        color: #000000;
        font-size: 1.4rem;
        cursor: pointer;
        transition: opacity 0.3s ease;
    }

    .btn-login-submit {
        background-color: #C92B0A;
        color: #ffffff;
        border: none;
        font-size: 1.1rem;
        transition: background-color 0.3s ease;
    }

        .btn-login-submit:disabled {
            background-color: #8B0000;
            opacity: 0.6;
            cursor: not-allowed;
        }
</style>

<div class="login-container-wrapper">
    <div class="entrance-login-card">
        <div class="text-center mb-4">
            <div class="icon-header-circle rounded-circle mb-3 shadow-sm">
                <i class="fa-solid fa-user-shield fa-xl" style="color: #C92B0A;"></i>
            </div>
            <h4 class="form-main-title m-0">Ingreso al Sistema</h4>
            <div class="d-flex justify-content-center gap-3 mt-3 text-secondary small">
                <span><i class="fa-solid fa-user me-1"></i>Cliente</span>
                <span><i class="fa-solid fa-screwdriver-wrench me-1"></i>Personal</span>
                <span><i class="fa-solid fa-lock me-1"></i>Admin</span>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 py-2 text-center rounded-3 shadow-sm mb-3" role="alert">
                <small><i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.Error</small>
            </div>
        }

        <form id="loginForm" asp-action="Login" method="post">
            <div class="mb-4">
                <label class="custom-field-label">Usuario</label>
                <div class="input-group custom-input-group">
                    <span class="input-icon-text"><i class="fa-regular fa-user"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="nombre.usuario" required />
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="custom-field-label m-0">Contraseña</label>
                    <button type="button" id="togglePasswordBtn" class="password-toggle-btn">
                        <i id="eyeIcon" class="fa-regular fa-eye-slash"></i>
                    </button>
                </div>
                <div class="input-group custom-input-group">
                    <span class="input-icon-text"><i class="fa-regular fa-key"></i></span>
                    <input type="password" id="passwordInput" name="password" class="form-control" placeholder="••••••••" required />
                </div>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" id="submitBtn" class="btn py-3 fw-bold text-uppercase rounded-3 shadow-sm btn-login-submit">
                    Ingresar al sistema
                </button>
            </div>
        </form>

        <div class="text-center mt-4 border-top pt-3">
            <span class="text-muted">¿No tienes cuenta?</span>
            <a asp-controller="Account" asp-action="Register" class="text-danger fw-bold text-decoration-none ms-2">Regístrate aquí</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');
            let isCooldownActivo = false;

            // Lógica de visibilidad de contraseña con Cooldown
            toggleBtn.addEventListener('click', function () {
                if (isCooldownActivo) return;

                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    eyeIcon.classList.replace('fa-eye-slash', 'fa-eye');
                } else {
                    passwordInput.type = 'password';
                    eyeIcon.classList.replace('fa-eye', 'fa-eye-slash');
                }

                isCooldownActivo = true;
                toggleBtn.style.opacity = '0.4';
                toggleBtn.style.cursor = 'wait';

                setTimeout(() => {
                    isCooldownActivo = false;
                    toggleBtn.style.opacity = '1';
                    toggleBtn.style.cursor = 'pointer';
                }, 7000);
            });

            // Bloqueo de doble envío al hacer submit
            document.getElementById('loginForm').addEventListener('submit', function () {
                const btn = document.getElementById('submitBtn');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Procesando...';
            });
        });
    </script>
}
