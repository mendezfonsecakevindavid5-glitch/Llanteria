@{
    ViewData["Title"] = "¡Bienvenido al Club!";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card border-0 shadow-sm rounded-xl p-5 bg-white">
            <div class="mb-4">
                <i class="fa-solid fa-circle-check text-success display-1"></i>
            </div>

            <h2 class="font-premium-title fw-black text-dark text-uppercase">¡Registro Exitoso!</h2>
            <p class="font-premium-body text-muted px-3">
                Ya eres miembro oficial de nuestro sistema de fidelización. Hemos acreditado tus puntos de regalo en tu cuenta.
            </p>

            <div class="my-4 p-3 rounded-xl border border-warning bg-light d-inline-block mx-auto" style="min-width: 200px;">
                <span class="text-muted d-block text-uppercase small fw-bold">Saldo Actual</span>
                <h3 class="fw-black text-warning m-0"><i class="fa-solid fa-star me-1"></i> 50 Puntos</h3>
            </div>

            <p class="small text-muted font-premium-body mb-4">
                Suministra tu número de documento en tu próxima compra o cambio de llantas para seguir acumulando beneficios canjeables.
            </p>

            <div class="d-grid">
                <a href="/" class="btn btn-dark py-2 text-uppercase fw-bold rounded-3 shadow-sm">
                    Volver a la Página Principal
                </a>
            </div>
        </div>
    </div>
</div>