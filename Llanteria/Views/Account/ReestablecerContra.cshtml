@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Recuperar contraseña</h1>
        <p class="text-muted mb-4">Te enviaremos un código al correo de tu cuenta.</p>

        <form asp-action="ProcesarReestablecimiento" method="post" data-otp>
            <label class="form-label" for="emailInput">Correo</label>
            <input id="emailInput" type="email" class="form-control" maxlength="100" required autofocus />

            <div class="mt-3">
                <button type="button" id="btnEnviar" class="btn btn-line">Enviar código</button>
                <div id="bloqueCodigo" class="d-none mt-3">
                    <label class="form-label" for="codigo">Código recibido</label>
                    <input id="codigo" class="form-control otp-input" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                    <button type="button" id="btnVerificar" class="btn btn-brand w-100 mt-2">Verificar</button>
                </div>
                <div id="otpEstado" class="small mt-2"></div>
            </div>

            <div id="bloqueClave" class="d-none mt-3">
                <div class="mb-3">
                    <label class="form-label" for="pass1">Nueva contraseña</label>
                    <input id="pass1" name="NuevaContrasena" type="password" class="form-control" minlength="6" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="pass2">Repite la contraseña</label>
                    <input id="pass2" type="password" class="form-control" minlength="6" autocomplete="new-password" />
                    <div id="claveEstado" class="small text-danger mt-1"></div>
                </div>
                <button type="submit" class="btn btn-hyper-action w-100 py-2">Guardar contraseña</button>
            </div>
        </form>
        <p class="small text-center mt-3 mb-0"><a asp-action="Login" class="text-llanteria-primary text-decoration-none">Volver a iniciar sesión</a></p>
    </div>
</div>

@section Scripts {
    <script>
        window.OTP = {
            enviar: '@Url.Action("EnviarCodigoRecuperacion", "Account")',
            verificar: '@Url.Action("VerificarTokenRecuperacion", "Account")',
            onVerified: function () {
                document.getElementById('bloqueClave').classList.remove('d-none');
                document.getElementById('pass1').required = true;
                document.getElementById('pass2').required = true;
                document.getElementById('pass1').focus();
            }
        };
        document.querySelector('form[data-otp]').addEventListener('submit', function (e) {
            if (document.getElementById('pass1').value !== document.getElementById('pass2').value) {
                e.preventDefault();
                document.getElementById('claveEstado').textContent = 'Las contraseñas no coinciden.';
            }
        });
    </script>
    <script src="~/js/otp.js" asp-append-version="true"></script>
}
