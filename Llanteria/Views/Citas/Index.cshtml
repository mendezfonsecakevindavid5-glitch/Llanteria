@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Cita>
@inject NegocioInfo Negocio

@{
    ViewData["Title"] = "Citas";
    string estado = ViewBag.Estado ?? "";
    string Clase(string e) => e switch
    {
        "Pendiente" => "tag-warn",
        "Confirmada" => "tag-ok",
        "Completada" => "tag-neutral",
        _ => "tag-bad"
    };
    var retorno = Context.Request.Path + Context.Request.QueryString;
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Citas", "Solicitudes de servicio hechas desde la página web."))

<form id="formEstado" asp-action="CambiarEstado" method="post" class="d-none">
    <input type="hidden" name="id" />
    <input type="hidden" name="estado" />
    <input type="hidden" name="retorno" value="@retorno" />
</form>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><div class="label">Pendientes por confirmar</div><div class="value">@ViewBag.Pendientes</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><div class="label">Próximos 7 días</div><div class="value">@ViewBag.ProximasSemana</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar cliente, servicio o vehículo" />
            <select name="estado" class="form-select form-select-sm" style="max-width:170px">
                <option value="">Todos los estados</option>
                @foreach (var e in Llanteria.Models.Cita.Estados)
                {
                    <option value="@e" selected="@(estado == e)">@e</option>
                }
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
            <a asp-action="Exportar" asp-route-estado="@estado" asp-route-buscar="@ViewBag.Buscar" class="btn btn-line btn-sm ms-auto"><i class="fa-solid fa-file-excel me-1"></i>Exportar a Excel</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Servicio</th>
                    <th>Cliente</th>
                    <th>Vehículo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="money">@c.Fecha.ToString("dd/MM/yyyy")<div class="cell-sub">@c.Hora</div></td>
                        <td class="cell-title">@c.Servicio<div class="cell-sub">@c.FormaPago</div></td>
                        <td>
                            @c.Solicitante
                            @if (!string.IsNullOrEmpty(c.Telefono)) { <div class="cell-sub">@c.Telefono</div> }
                        </td>
                        <td>
                            @c.Vehiculo
                            @if (!string.IsNullOrEmpty(c.Direccion)) { <div class="cell-sub"><i class="fa-solid fa-location-dot me-1"></i>@c.Direccion</div> }
                            @if (!string.IsNullOrEmpty(c.Notas)) { <div class="cell-sub">@c.Notas</div> }
                        </td>
                        <td><span class="tag @Clase(c.Estado)">@c.Estado</span></td>
                        <td class="text-end">
                            <span class="row-actions">
                                @{ var wa = NegocioInfo.WhatsAppDe(c.Telefono); }
                                @if (wa != null)
                                {
                                    var texto = $"Hola {c.Solicitante}, te escribimos de {Negocio.Nombre} sobre tu cita de {c.Servicio} el {c.Fecha:dd/MM/yyyy} a las {c.Hora}.";
                                    <a class="icon-btn" title="Escribir por WhatsApp" target="_blank" rel="noopener" href="https://wa.me/@(wa)?text=@(Uri.EscapeDataString(texto))"><i class="fa-brands fa-whatsapp"></i></a>
                                }
                                @if (c.Estado == "Pendiente")
                                {
                                    <button type="button" class="icon-btn" title="Confirmar" data-estado="Confirmada" data-id="@c.Id"><i class="fa-solid fa-check"></i></button>
                                }
                                @if (c.Estado is "Pendiente" or "Confirmada")
                                {
                                    <button type="button" class="icon-btn" title="Marcar como completada" data-estado="Completada" data-id="@c.Id"><i class="fa-solid fa-flag-checkered"></i></button>
                                    <button type="button" class="icon-btn danger" title="Cancelar" data-estado="Cancelada" data-id="@c.Id"><i class="fa-solid fa-xmark"></i></button>
                                }
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="empty-state">No hay citas con esos filtros.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            const b = e.target.closest('[data-estado]');
            if (!b) return;
            const f = document.getElementById('formEstado');
            f.elements['id'].value = b.dataset.id;
            f.elements['estado'].value = b.dataset.estado;
            if (b.dataset.estado === 'Cancelada') {
                Swal.fire({ title: '¿Cancelar la cita?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Sí, cancelar', cancelButtonText: 'Volver', confirmButtonColor: '#C92B0A' })
                    .then(r => { if (r.isConfirmed) f.submit(); });
            } else f.submit();
        });
    </script>
}
