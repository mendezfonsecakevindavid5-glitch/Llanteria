@model Llanteria.Models.ReporteVentasVM
@{
    Layout = null;
    var m = Model;
    string Money(decimal v) => v.ToString("C0");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@m.Cabecera.Titulo · @m.Cabecera.Codigo</title>
    <partial name="_PdfEstilos" />
</head>
<body>
    <partial name="_PdfEncabezado" model="m.Cabecera" />

    <table class="kpis">
        <tr>
            <td class="hl"><div class="kpi-l">Total vendido</div><div class="kpi-v">@Money(m.Total)</div><div class="kpi-s">@m.Facturas.Count facturas</div></td>
            <td><div class="kpi-l">Subtotal (sin IVA)</div><div class="kpi-v">@Money(m.Subtotal)</div><div class="kpi-s">Base gravable</div></td>
            <td><div class="kpi-l">IVA facturado</div><div class="kpi-v">@Money(m.Iva)</div><div class="kpi-s">Retenciones @Money(m.Retenciones)</div></td>
            <td><div class="kpi-l">Ticket promedio</div><div class="kpi-v">@Money(m.TicketPromedio)</div><div class="kpi-s">Por factura</div></td>
        </tr>
    </table>

    @if (m.TopClientes.Any())
    {
        <h2 class="sec">Mejores clientes</h2>
        <table class="dt">
            <thead><tr><th>Cliente</th><th class="num">Facturas</th><th class="num">Total comprado</th><th class="num">Participación</th></tr></thead>
            <tbody>
                @for (var i = 0; i < m.TopClientes.Count; i++)
                {
                    var t = m.TopClientes[i];
                    <tr class="@(i % 2 == 1 ? "alt" : "")">
                        <td>@t.Nombre</td><td class="num">@t.Cantidad</td><td class="num">@Money(t.Valor)</td>
                        <td class="num">@((m.Total > 0 ? t.Valor / m.Total : 0).ToString("P1"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="sec">Detalle de facturas<small>@m.Facturas.Count registros</small></h2>
    @if (m.Facturas.Any())
    {
        <table class="dt">
            <thead><tr><th>N.º</th><th>Fecha</th><th>Cliente</th><th>Documento</th><th class="num">Subtotal</th><th class="num">IVA</th><th class="num">Retención</th><th class="num">Total</th></tr></thead>
            <tbody>
                @for (var i = 0; i < m.Facturas.Count; i++)
                {
                    var f = m.Facturas[i];
                    <tr class="@(i % 2 == 1 ? "alt" : "")">
                        <td>@f.Id.ToString("D6")</td>
                        <td>@f.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>@f.IdClienteNavigation?.Nombres @f.IdClienteNavigation?.Apellidos</td>
                        <td>@f.IdClienteNavigation?.NumeroDocumento</td>
                        <td class="num">@Money(f.TotalBruto)</td>
                        <td class="num">@Money(f.Iva)</td>
                        <td class="num">@Money(f.RteFte ?? 0)</td>
                        <td class="num">@Money(f.TotalPagar)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="4">Total</td><td class="num">@Money(m.Subtotal)</td><td class="num">@Money(m.Iva)</td><td class="num">@Money(m.Retenciones)</td><td class="num">@Money(m.Total)</td></tr>
            </tfoot>
        </table>
    }
    else
    {
        <p class="muted">No hay facturas en el periodo seleccionado.</p>
    }

    <partial name="_PdfFirmas" />
</body>
</html>
