@model Llanteria.Models.ReporteGeneralViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <style>
            :root {
                --primary-color: #2c3e50;
                --accent-color: #3498db;
            }

            body {
                font-family: 'Helvetica', sans-serif;
                font-size: 12px;
                color: #333;
                margin: 40px;
            }

            /* Encabezado Profesional */
            .header {
                display: flex;
                justify-content: space-between;
                border-bottom: 3px solid var(--primary-color);
                padding-bottom: 20px;
                margin-bottom: 30px;
            }

            .company-info h1 {
                margin: 0;
                color: var(--primary-color);
                text-transform: uppercase;
            }

            .report-meta {
                text-align: right;
            }

            /* Tarjetas de Resumen */
            .summary-row {
                display: flex;
                gap: 20px;
                margin-bottom: 30px;
            }

            .card {
                flex: 1;
                border: 1px solid #ddd;
                padding: 15px;
                border-radius: 5px;
                background: #f9f9f9;
            }

                .card h4 {
                    margin: 0 0 10px 0;
                    font-size: 10px;
                    text-transform: uppercase;
                    color: #7f8c8d;
                }

                .card p {
                    margin: 0;
                    font-size: 20px;
                    font-weight: bold;
                    color: var(--primary-color);
                }

            /* Tablas */
            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
            }

            th {
                background: var(--primary-color);
                color: white;
                padding: 10px;
                text-align: left;
            }

            td {
                border-bottom: 1px solid #eee;
                padding: 10px;
            }

            tr:nth-child(even) {
                background: #fdfdfd;
            }

            /* Footer */
            .footer {
                position: fixed;
                bottom: 0;
                width: 100%;
                text-align: center;
                font-size: 10px;
                border-top: 1px solid #eee;
                padding-top: 10px;
            }
    </style>
</head>
<body>

    <div class="header">
        <div class="company-info">
            <h1>Llantería System</h1>
            <p>Reporte Administrativo Operativo</p>
        </div>
        <div class="report-meta">
            <p><strong>Fecha:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    <div class="summary-row">
        <div class="card">
            <h4>Total Ventas</h4>
            <p>$ @Model.Facturas.Sum(f => f.TotalPagar).ToString("N2")</p>
        </div>
        <div class="card">
            <h4>Total Gastos</h4>
            <p>$ @Model.Gastos.Sum(g => g.Monto).ToString("N2")</p>
        </div>
        <div class="card">
            <h4>Balance Neto</h4>
            <p>$ @((Model.Facturas.Sum(f => f.TotalPagar) - Model.Gastos.Sum(g => g.Monto)).ToString("N2"))</p>
        </div>
    </div>

    <h3>Detalle de Transacciones Recientes</h3>
    <table>
        <thead>
            <tr>
                <th>Tipo</th>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Monto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model.Facturas.Take(10))
            {
                <tr><td>Factura</td><td>@f.Fecha?.ToString("dd/MM/yyyy")</td><td>Venta #@f.Id</td><td style="color: green;">+ $ @f.TotalPagar.ToString("N2")</td></tr>
            }
            @foreach (var g in Model.Gastos.Take(10))
            {
                <tr><td>Gasto</td><td>@g.FechaRegistro?.ToString("dd/MM/yyyy")</td><td>@g.Descripcion</td><td style="color: red;">- $ @g.Monto.ToString("N2")</td></tr>
            }
        </tbody>
    </table>

    <div class="footer">
        Generado automáticamente por Llantería System - Documento para uso interno.
    </div>
</body>
</html>