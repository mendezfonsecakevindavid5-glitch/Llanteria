@model Llanteria.Models.ReporteGeneralViewModel
@{
    Layout = null;
    var facturas = Model.Facturas.ToList();
    var gastos = Model.Gastos.ToList();
    var titulo = Model.Titulo;
    var periodo = Model.Periodo;
    var ventas = facturas.Sum(f => f.TotalPagar);
    var egresos = gastos.Sum(g => g.Monto);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; color: #1f2328; margin: 28px; }
        .header { border-bottom: 2px solid #C92B0A; padding-bottom: 8px; margin-bottom: 18px; }
        .header h1 { margin: 0; font-size: 20px; text-transform: uppercase; }
        .header p { margin: 2px 0 0; color: #6b7280; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th { background: #f1f2f4; text-align: left; padding: 7px 8px; font-size: 11px; text-transform: uppercase; border-bottom: 1px solid #cfd4da; }
        td { padding: 7px 8px; border-bottom: 1px solid #eceef1; }
        .num { text-align: right; white-space: nowrap; }
        .resumen td { border: 1px solid #e3e6ea; text-align: center; padding: 10px; }
        .resumen .t { font-size: 10px; text-transform: uppercase; color: #6b7280; }
        .resumen .v { font-size: 16px; font-weight: bold; }
        h3 { margin: 22px 0 0; font-size: 13px; }
        .pie { margin-top: 24px; font-size: 10px; color: #8a9099; text-align: center; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Llantería Valledupar · @titulo</h1>
        <p>@(periodo != null ? "Periodo: " + periodo + " · " : "")Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <table class="resumen">
        <tr>
            @if (facturas.Any()) { <td><div class="t">Ventas</div><div class="v">@ventas.ToString("C0")</div></td> }
            @if (gastos.Any()) { <td><div class="t">Gastos</div><div class="v">@egresos.ToString("C0")</div></td> }
            @if (facturas.Any() && gastos.Any()) { <td><div class="t">Balance</div><div class="v">@((ventas - egresos).ToString("C0"))</div></td> }
        </tr>
    </table>

    @if (facturas.Any())
    {
        <h3>Ventas (@facturas.Count)</h3>
        <table>
            <thead><tr><th>N.º</th><th>Fecha</th><th>Cliente</th><th class="num">Total</th></tr></thead>
            <tbody>
                @foreach (var f in facturas)
                {
                    <tr>
                        <td>@f.Id</td>
                        <td>@f.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>@f.IdClienteNavigation?.Nombres @f.IdClienteNavigation?.Apellidos</td>
                        <td class="num">@f.TotalPagar.ToString("C0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (gastos.Any())
    {
        <h3>Gastos (@gastos.Count)</h3>
        <table>
            <thead><tr><th>Fecha</th><th>Categoría</th><th>Descripción</th><th>Estado</th><th class="num">Monto</th></tr></thead>
            <tbody>
                @foreach (var g in gastos)
                {
                    <tr>
                        <td>@g.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                        <td>@g.IdCategoriaNavigation?.Nombre</td>
                        <td>@g.Descripcion</td>
                        <td>@(g.Estado ?? "Pendiente")</td>
                        <td class="num">@g.Monto.ToString("C0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!facturas.Any() && !gastos.Any())
    {
        <p>No hay registros para mostrar.</p>
    }

    <div class="pie">Llantería Valledupar</div>
</body>
</html>
