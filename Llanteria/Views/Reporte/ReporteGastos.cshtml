@model Llanteria.Models.ReporteGastosVM
@{
    Layout = null;
    var m = Model;
    string Money(decimal v) => v.ToString("C0");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@m.Cabecera.Titulo · @m.Cabecera.Codigo</title>
    <partial name="_PdfEstilos" />
</head>
<body>
    <partial name="_PdfEncabezado" model="m.Cabecera" />

    <table class="kpis">
        <tr>
            <td class="hl"><div class="kpi-l">Total egresos</div><div class="kpi-v">@Money(m.Total)</div><div class="kpi-s">@m.Gastos.Count gastos</div></td>
            <td><div class="kpi-l">Pagado</div><div class="kpi-v pos">@Money(m.Pagado)</div><div class="kpi-s">Gastos cancelados</div></td>
            <td><div class="kpi-l">Por pagar</div><div class="kpi-v">@Money(m.Pendiente)</div><div class="kpi-s">Pendiente y vencido</div></td>
            <td><div class="kpi-l">Vencido</div><div class="kpi-v @(m.Vencido > 0 ? "neg" : "")">@Money(m.Vencido)</div><div class="kpi-s">Requiere atención</div></td>
        </tr>
    </table>

    @if (m.PorCategoria.Any())
    {
        <h2 class="sec">Egresos por categoría</h2>
        <table class="dt">
            <thead><tr><th>Categoría</th><th class="num">Gastos</th><th class="num">Monto</th><th class="num">%</th><th style="width:28%">Participación</th></tr></thead>
            <tbody>
                @for (var i = 0; i < m.PorCategoria.Count; i++)
                {
                    var c = m.PorCategoria[i];
                    <tr class="@(i % 2 == 1 ? "alt" : "")">
                        <td>@c.Categoria</td>
                        <td class="num">@c.Cantidad</td>
                        <td class="num">@Money(c.Monto)</td>
                        <td class="num">@c.Porcentaje.ToString("P1")</td>
                        <td><div class="bar"><i style="width:@((int)Math.Round(c.Porcentaje * 100))%"></i></div></td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><td>Total</td><td class="num">@m.Gastos.Count</td><td class="num">@Money(m.Total)</td><td class="num">100,0 %</td><td></td></tr></tfoot>
        </table>
    }

    <h2 class="sec">Detalle de gastos<small>@m.Gastos.Count registros</small></h2>
    @if (m.Gastos.Any())
    {
        <table class="dt">
            <thead><tr><th>Registro</th><th>Categoría</th><th>Descripción</th><th>Vence</th><th>Pagado el</th><th>Estado</th><th class="num">Monto</th></tr></thead>
            <tbody>
                @for (var i = 0; i < m.Gastos.Count; i++)
                {
                    var g = m.Gastos[i];
                    var pagado = g.Estado == "Pagado";
                    var vencido = !pagado && g.FechaVencimiento < m.Hoy;
                    <tr class="@(i % 2 == 1 ? "alt" : "")">
                        <td>@g.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                        <td>@g.IdCategoriaNavigation?.Nombre</td>
                        <td>@g.Descripcion</td>
                        <td>@g.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                        <td>@(g.FechaPago?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td><span class="tag @(pagado ? "ok" : vencido ? "bad" : "warn")">@(pagado ? "Pagado" : vencido ? "Vencido" : "Pendiente")</span></td>
                        <td class="num">@Money(g.Monto)</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr><td colspan="6">Total</td><td class="num">@Money(m.Total)</td></tr></tfoot>
        </table>
    }
    else
    {
        <p class="muted">No hay gastos registrados en el periodo seleccionado.</p>
    }

    <partial name="_PdfFirmas" />
</body>
</html>
