@model Llanteria.Models.PromocionesViewModel
@{
    ViewData["Title"] = "Promociones";
    string Etiqueta(Llanteria.Models.Oferta o)
    {
        if (o.PorcentajeDescuento > 0) return $"{o.PorcentajeDescuento.Value:0.##} % de descuento";
        if (o.MontoDescuentoFijo > 0) return $"{o.MontoDescuentoFijo.Value:C0} de descuento";
        return "Promoción";
    }
}
@await Html.PartialAsync("_BannerNegro", ("Promociones", "Productos con precio especial y cupones vigentes en nuestra sucursal de Valledupar."))

@if (Model.EventosHoy.Any())
{
    @* Eventos de hoy: aparecen a las 12:00 a. m. del día del evento y se ocultan solos a las 11:59 p. m. *@
    <section class="section pb-0">
        <div class="container">
            <span class="eyebrow">Hoy</span>
            <h2 class="section-title mt-1 mb-3">Eventos de hoy</h2>
            <div class="row g-3">
                @foreach (var ev in Model.EventosHoy)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="promo-card">
                            <span class="tag-promo">@ev.Fecha.ToString("d 'de' MMMM")</span>
                            <h3>@ev.Nombre</h3>
                            @if (!string.IsNullOrWhiteSpace(ev.Descripcion)) { <p>@ev.Descripcion</p> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.Productos.Any())
{
    <section class="section">
        <div class="container">
            <div class="mb-4">
                <span class="eyebrow">En promoción</span>
                <h2 class="section-title mt-1">Productos con precio especial</h2>
            </div>
            <div class="cat-grid">
                @foreach (var p in Model.Productos)
                {
                    <partial name="_TarjetaProducto" model="(p, Model.Agotados.Contains(p.Id))" />
                }
            </div>
        </div>
    </section>
}

<section class="section @(Model.Productos.Any() ? "section-alt" : "")">
    <div class="container">
        <div class="mb-4">
            <span class="eyebrow">Beneficios</span>
            <h2 class="section-title mt-1">Ofertas y cupones</h2>
            <p class="section-sub">Los códigos se aplican en el carrito antes de pagar.</p>
        </div>
        <div class="row g-3">
            @foreach (var o in Model.Ofertas)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="promo-card">
                        <span class="tag-promo">@Etiqueta(o)</span>
                        <h3>@o.Titulo</h3>
                        <p>@o.Descripcion</p>
                        <div class="small text-muted mt-auto mb-2">Vigente hasta el @o.FechaFin.ToString("d 'de' MMMM 'de' yyyy")</div>
                        @if (!string.IsNullOrEmpty(o.CodigoPromocional))
                        {
                            <div class="small mb-2">Código: <strong>@o.CodigoPromocional</strong></div>
                        }
                        <a asp-controller="Llantas" asp-action="Index" class="btn btn-outline-llanteria-primary btn-sm align-self-start">Ver llantas</a>
                    </div>
                </div>
            }
            @if (!Model.Ofertas.Any() && !Model.Productos.Any())
            {
                <div class="col-lg-4">
                    <div class="promo-card">
                        <span class="tag-promo">Cupos limitados</span>
                        <h3>Combo 4 llantas</h3>
                        <p>Por la compra de un juego completo de 4 llantas te regalamos la alineación 3D y el balanceo. Valor normal: $120.000.</p>
                        <a asp-controller="Llantas" asp-action="Index" class="btn btn-outline-llanteria-primary btn-sm mt-auto align-self-start">Ver llantas</a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="promo-card">
                        <span class="tag-promo">Agenda en línea</span>
                        <h3>Diagnóstico de suspensión</h3>
                        <p>Si agendas tu cita desde el portal, el diagnóstico preventivo de suspensión, frenos y rines es gratis. Precio normal: $45.000.</p>
                        <a asp-controller="Servicios" asp-action="Detalle" asp-route-slug="suspension-amortiguadores" class="btn btn-outline-llanteria-primary btn-sm mt-auto align-self-start">Agendar</a>
                    </div>
                </div>
            }
        </div>
        <p class="small text-muted mt-3 mb-0">Sujetas a disponibilidad de inventario. No acumulables con otras campañas vigentes.</p>
    </div>
</section>
