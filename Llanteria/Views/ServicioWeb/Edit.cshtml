@model Llanteria.Models.ServicioWeb

@{
    ViewData["Title"] = "Editar servicio";
    ViewData["Accion"] = "Edit";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Editar servicio", "Cambia el texto, el precio, la imagen o la visibilidad.", "ServicioWeb", "Index"))

<div class="panel panel-medium">
    <div class="panel-body">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
