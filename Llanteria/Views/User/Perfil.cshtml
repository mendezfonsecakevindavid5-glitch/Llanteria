@model Llanteria.Models.PerfilUsuarioViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Mi perfil", "Tus datos de contacto y tu contraseña."))

<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-head">Datos personales</div>
            <div class="panel-body">
                <form asp-controller="User" asp-action="ActualizarPerfil" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TemaPreferencia" />

                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.FotoBase64))
                        {
                            <img id="previewFoto" class="file-preview rounded-circle" src="@Model.FotoBase64" alt="Foto" />
                        }
                        else
                        {
                            <img id="previewFoto" class="file-preview rounded-circle" src="~/images/productoos/default-producto.png" alt="Foto" />
                        }
                        <div class="flex-grow-1">
                            <label asp-for="NuevaFoto" class="form-label">Foto</label>
                            <input asp-for="NuevaFoto" type="file" class="form-control" accept="image/*" data-preview="#previewFoto" />
                            <span asp-validation-for="NuevaFoto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label">Nombre completo</label>
                            <input asp-for="Nombre" class="form-control" maxlength="150" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" maxlength="20" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Correo" class="form-label">Correo</label>
                            <input asp-for="Correo" class="form-control" readonly />
                            <div class="form-text">El correo lo gestiona el administrador.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label">Acerca de ti</label>
                            <textarea asp-for="Bio" class="form-control" rows="3" maxlength="500"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="NotificacionesActivas" class="form-check-input" />
                                <label asp-for="NotificacionesActivas" class="form-check-label">Recibir notificaciones</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-brand">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-head">Cambiar contraseña</div>
            <div class="panel-body">
                <form asp-controller="User" asp-action="CambiarPassword" method="post" autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label" for="actual">Contraseña actual</label>
                        <input id="actual" name="actual" type="password" class="form-control" required autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="nueva">Nueva contraseña</label>
                        <input id="nueva" name="nueva" type="password" class="form-control" minlength="6" required autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="confirmacion">Repite la nueva contraseña</label>
                        <input id="confirmacion" name="confirmacion" type="password" class="form-control" minlength="6" required autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-line w-100">Actualizar contraseña</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
