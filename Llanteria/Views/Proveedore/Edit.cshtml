@model Llanteria.Models.Proveedore

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="container py-5" style="max-width: 850px;">

    <div class="mb-4 animate__animated animate__fadeIn">
        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
            <i class="fa-solid fa-arrow-left"></i> Volver a Proveedores
        </a>
        <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-pen-to-square" style="color: #C92B0A;"></i> Modificar Proveedor
        </h2>
        <p class="text-muted small m-0">Actualiza los datos institucionales, asesores corporativos o el logo oficial asignado.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="card-body p-4 p-md-5 bg-white">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-12 d-flex align-items-center gap-3 bg-light p-3 rounded-3 border mb-2">
                        <div class="rounded-3 overflow-hidden border bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 75px; height: 75px; flex-shrink: 0;">
                            <img id="previewImagen" src="@Url.Content("~/images/proveedores/" + Model.Id + ".png")"
                                 class="w-100 h-100 object-fit-cover"
                                 alt="Logotipo"
                                 onerror="this.src='/images/proveedores/default-proveedor.png';" />
                        </div>
                        <div>
                            <span class="badge bg-dark text-uppercase px-2 py-1 mb-1" style="font-size: 0.65rem;">ID Sistema: #@Model.Id</span>
                            <h6 class="m-0 fw-bold text-dark" id="previewNombre">Empresa: @Model.NombreEmpresa</h6>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="form-floating">
                            <input asp-for="NombreEmpresa" id="inputNombre" class="form-control" placeholder="Empresa" required />
                            <label asp-for="NombreEmpresa" class="fw-semibold text-muted">Nombre de la Empresa / Fábrica</label>
                            <span asp-validation-for="NombreEmpresa" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="form-floating">
                            <input asp-for="Telefono" class="form-control" placeholder="Teléfono" />
                            <label asp-for="Telefono" class="fw-semibold text-muted">Teléfono de Atención</label>
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Contacto" class="form-control" placeholder="Contacto" />
                            <label asp-for="Contacto" class="fw-semibold text-muted">Nombre del Asesor / Ejecutivo</label>
                            <span asp-validation-for="Contacto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-2 bg-white h-100 d-flex flex-column justify-content-center">
                            <label asp-for="ImagenArchivo" class="form-label small fw-semibold text-muted mb-1">Reemplazar Logotipo (.png, .jpg)</label>
                            <input asp-for="ImagenArchivo" id="inputImagenFile" type="file" class="form-control form-control-sm" accept="image/*" />
                            <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-3 border">Cancelar</a>
                        <button type="submit" class="btn text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform" style="background-color: #C92B0A; border: none;">
                            <i class="fa-solid fa-square-check"></i> Actualizar Cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: transform 0.2s ease;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    .form-control:focus {
        border-color: #C92B0A;
        box-shadow: 0 0 0 0.25px rgba(201, 43, 10, 0.25);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("inputImagenFile").addEventListener("change", function(e) {
            const preview = document.getElementById("previewImagen");
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) { preview.src = event.target.result; }
                reader.readAsDataURL(file);
            }
        });

        document.getElementById("inputNombre").addEventListener("input", function(e) {
            const valor = e.target.value.trim();
            document.getElementById("previewNombre").innerText = valor === "" ? "Esperando..." : "Empresa: " + valor;
        });
    </script>
}