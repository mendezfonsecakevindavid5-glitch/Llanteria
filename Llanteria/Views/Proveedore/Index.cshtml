@model IEnumerable<Llanteria.Models.Proveedore>

@{
    ViewData["Title"] = "Aliados y Proveedores";
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-industry" style="color: #C92B0A;"></i> Aliados y Proveedores
            </h2>
            <p class="text-muted small m-0">Administra los fabricantes de llantas, rines, herramientas y distribuidores oficiales del taller.</p>
        </div>

        <a asp-action="Create" class="btn text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform" style="background-color: #C92B0A; border: none;">
            <i class="fa-solid fa-plus"></i> Registrar Proveedor
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm border-0" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-white text-uppercase small tracking-wider" style="background-color: #000000;">
                    <tr>
                        <th scope="col" class="ps-4 text-center" style="width: 110px;">Logo</th>
                        <th scope="col" class="py-3">Nombre de la Empresa</th>
                        <th scope="col" class="py-3">Contacto / Asesor</th>
                        <th scope="col" class="py-3">Teléfono de Atención</th>
                        <th scope="col" class="text-center py-3" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-center">
                                    <div class="rounded-3 border bg-light shadow-sm d-inline-flex align-items-center justify-content-center overflow-hidden" style="width: 55px; height: 55px;">
                                        <img src="@Url.Content("~/images/proveedores/" + item.Id + ".png")"
                                             class="w-100 h-100 object-fit-cover"
                                             alt="@item.NombreEmpresa"
                                             onerror="this.src='/images/proveedores/default-proveedor.png';" />
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark fs-6">@item.NombreEmpresa</span>
                                </td>

                                <td>
                                    <span class="text-dark fw-semibold">
                                        <i class="fa-solid fa-user-tie text-secondary me-1" style="font-size: 0.9rem;"></i>
                                        @(string.IsNullOrEmpty(item.Contacto) ? "No especificado" : item.Contacto)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1.5 fw-medium">
                                        <i class="fa-solid fa-phone text-muted me-1"></i>
                                        @(string.IsNullOrEmpty(item.Telefono) ? "S/N" : item.Telefono)
                                    </span>
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-2" title="Editar Información">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-2" title="Eliminar Proveedor" onclick="confirmarEliminar(@item.Id, '@item.NombreEmpresa')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open display-4 mb-3 d-block text-secondary"></i>
                                <span class="fw-semibold">No hay proveedores registrados en el sistema.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .object-fit-cover {
        object-fit: cover;
    }
</style>

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar proveedor?',
                text: "Se borrará de forma permanente a: \"" + nombre + "\". Asegúrate de que no tenga productos asociados en stock, o el sistema denegará la acción.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C92B0A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                customClass: {
                    popup: 'rounded-3'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Proveedore/Delete/' + id;
                }
            })
        }
    </script>
}