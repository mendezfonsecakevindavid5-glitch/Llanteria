@model IEnumerable<Llanteria.Models.Proveedore>
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = "Proveedores";
    string Logo(int id) => System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", "proveedores", id + ".png"))
        ? Url.Content($"~/images/proveedores/{id}.png")
        : Url.Content("~/images/proveedores/default-proveedor.png");
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Proveedores", "Empresas que surten llantas, aceites y repuestos.", BotonTexto: "Nuevo proveedor", BotonAction: "Create", BotonController: "Proveedore"))

<div class="panel">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Empresa</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><img class="thumb" src="@Logo(p.Id)" alt="" /></td>
                        <td class="cell-title">@p.NombreEmpresa</td>
                        <td>@(string.IsNullOrWhiteSpace(p.Contacto) ? "—" : p.Contacto)</td>
                        <td>@(string.IsNullOrWhiteSpace(p.Telefono) ? "—" : p.Telefono)</td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = p.Id })" data-nombre="@p.NombreEmpresa"
                                        data-aviso="No se puede eliminar si tiene productos asociados."><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="empty-state">Aún no hay proveedores registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
