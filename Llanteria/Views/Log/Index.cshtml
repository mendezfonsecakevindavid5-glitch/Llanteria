@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.LogActividad>

@{
    ViewData["Title"] = "Registro de actividad";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Registro de actividad", "Quién hizo qué y cuándo, para auditoría del panel."))

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:320px" placeholder="Buscar por acción, tabla o usuario" />
            <button class="btn btn-line btn-sm">Buscar</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Tabla afectada</th>
                    <th>Dirección IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Items)
                {
                    <tr>
                        <td class="money">@(l.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>
                            <div class="cell-title">@(l.IdUsuarioNavigation?.Username ?? "—")</div>
                            <div class="cell-sub">@l.IdUsuarioNavigation?.Correo</div>
                        </td>
                        <td>@l.Accion</td>
                        <td>@(l.TablaAfectada ?? "—")</td>
                        <td>@(l.DireccionIp ?? "—")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="empty-state">No hay registros de actividad con esos filtros.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>
