@model Llanteria.Models.Inventario
@{
    var editando = Model.Id > 0;
}

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="IdProducto" class="form-label">Producto</label>
            <select asp-for="IdProducto" class="form-select" asp-items="ViewBag.IdProducto"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdProducto" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="IdBodega" class="form-label">Bodega</label>
            <select asp-for="IdBodega" class="form-select" asp-items="ViewBag.IdBodega"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdBodega" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Codigo" class="form-label">Código o lote</label>
            <input asp-for="Codigo" class="form-control text-uppercase" maxlength="50" placeholder="LL-205-55-16-A" />
            <span asp-validation-for="Codigo" class="text-danger small"></span>
        </div>
        @if (editando)
        {
            <div class="col-md-4">
                <label class="form-label">Stock actual</label>
                <input class="form-control" value="@Model.StockActual" readonly />
                <div class="form-text">Cambia con entradas de mercancía y con las ventas.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="IdEstado" class="form-label">Estado</label>
                <select asp-for="IdEstado" class="form-select" asp-items="ViewBag.IdEstado"></select>
                <div class="form-text">Marca «Dañado» para excluirlo de las ventas.</div>
            </div>
        }
        else
        {
            <div class="col-md-4">
                <label asp-for="StockActual" class="form-label">Unidades iniciales</label>
                <input asp-for="StockActual" type="number" min="0" class="form-control" />
                <span asp-validation-for="StockActual" class="text-danger small"></span>
            </div>
        }
        <div class="col-md-4">
            <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
            <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
            <div class="form-text">Por debajo de este número se genera una alerta.</div>
            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
