@model Llanteria.Models.Vehiculo

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Placa" class="form-label">Placa</label>
            <input asp-for="Placa" class="form-control text-uppercase" maxlength="10" placeholder="ABC123" autofocus />
            <span asp-validation-for="Placa" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Marca" class="form-label">Marca</label>
            <input asp-for="Marca" class="form-control" maxlength="50" placeholder="Toyota" />
            <span asp-validation-for="Marca" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Modelo" class="form-label">Modelo</label>
            <input asp-for="Modelo" class="form-control" maxlength="50" placeholder="Hilux 2024" />
            <span asp-validation-for="Modelo" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="IdCliente" class="form-label">Propietario</label>
            <select asp-for="IdCliente" class="form-select" asp-items="ViewBag.IdCliente"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdCliente" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
