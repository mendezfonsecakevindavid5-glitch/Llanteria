@model IEnumerable<Llanteria.Models.Vehiculo>

@{
    ViewData["Title"] = "Gestión de Vehículos";
}

<div class="container py-5" style="max-width: 1100px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0">
                <i class="fa-solid fa-car text-primary"></i> Vehículos Registrados
            </h2>
            <p class="text-muted small m-0">Lista de vehículos asociados a tus clientes.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
            <i class="fa-solid fa-plus-circle"></i> Registrar Vehículo
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">Placa</th>
                        <th class="py-3">Marca y Modelo</th>
                        <th class="py-3">Propietario</th>
                        <th class="text-center py-3 pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var item in Model)
                    {
                        <tr style="height: 70px;">
                            <td class="ps-4">
                                <span class="badge bg-warning text-dark border border-dark fs-6 px-3 py-2 shadow-sm rounded-2">
                                    @item.Placa?.ToUpper()
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Marca</div>
                                <div class="text-muted small">@item.Modelo</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="fa-solid fa-user-circle text-muted me-2 fs-5"></i>
                                    <span class="fw-semibold">@item.Cliente?.Nombres @item.Cliente?.Apellidos</span>
                                </div>
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-2" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-2" title="Eliminar" onclick="confirmarEliminar(@item.Id, '@item.Placa')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .table td {
        padding: 15px !important;
    }

    .transition-transform {
        transition: 0.2s;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .hover-left:hover {
        transform: translateX(-4px);
    }
</style>

@section Scripts {
    <script>
        function confirmarEliminar(id, placa) {
            Swal.fire({
                title: '¿Eliminar vehículo?',
                text: "El vehículo con placa " + placa + " será eliminado permanentemente.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Vehiculo/Delete/' + id;
                }
            })
        }
    </script>
}