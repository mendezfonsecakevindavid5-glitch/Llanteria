@model List<Llanteria.Models.Articulo>
@{
    ViewData["Title"] = "Blog";
    string? categoria = ViewBag.Categoria;
    string orden = ViewBag.Orden;
}

@await Html.PartialAsync("_BannerNegro", ("Blog", "Guías prácticas sobre llantas, aceites, baterías y seguridad vial, escritas por el equipo del taller."))

<div class="container blog-wrap">

    <form method="get" class="blog-toolbar">
        <div class="blog-chips">
            <a asp-action="Index" asp-route-orden="@orden" class="@(categoria == null ? "active" : "")">Todos</a>
            @foreach (var c in Llanteria.Models.BlogCatalogo.Categorias)
            {
                <a asp-action="Index" asp-route-categoria="@c" asp-route-orden="@orden" class="@(categoria == c ? "active" : "")">@c</a>
            }
        </div>
        <input type="hidden" name="categoria" value="@categoria" />
        <label class="d-flex align-items-center gap-2">
            <span class="d-none d-sm-inline small text-muted">Ordenar</span>
            <select name="orden" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="recientes" selected="@(orden == "recientes")">Más recientes</option>
                <option value="antiguos" selected="@(orden == "antiguos")">Más antiguos</option>
            </select>
        </label>
    </form>

    @if (Model.Any())
    {
        <div class="bl-grid">
            @foreach (var a in Model)
            {
                <article class="bl-card">
                    <a asp-action="Detalle" asp-route-slug="@a.Slug" class="bl-img" tabindex="-1" aria-hidden="true">
                        <img src="~/images/blog/@a.ImagenTarjeta" alt="" loading="lazy" />
                    </a>
                    <div class="bl-body">
                        <h2>@a.Titulo</h2>
                        <p>@a.Resumen <a asp-action="Detalle" asp-route-slug="@a.Slug" class="bl-mas">Leer más</a></p>
                        <time datetime="@a.Fecha.ToString("yyyy-MM-dd")">@a.Fecha.ToString("dd 'de' MMMM 'de' yyyy")</time>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="cat-empty"><i class="fa-regular fa-newspaper"></i><h2>Todavía no hay artículos en esta categoría</h2></div>
    }
</div>
