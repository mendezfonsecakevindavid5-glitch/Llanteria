@model Llanteria.Models.SeccionFormVM
@{
    var nueva = Model.Numero < 0;
    var intro = Model.Numero == 0;
    ViewData["Title"] = nueva ? "Nueva sección" : intro ? "Editar introducción" : "Editar sección";
    var accion = nueva ? $"/Blog/{Model.Slug}/nueva-seccion" : $"/Blog/{Model.Slug}/seccion/{Model.Numero}";
}
<div class="container blog-wrap" style="max-width:820px">
    <header class="page-head">
        <h1>@ViewData["Title"]</h1>
        <p>@Model.TituloArticulo</p>
    </header>

    <form method="post" action="@accion">
        @Html.AntiForgeryToken()
        @if (!intro)
        {
            <div class="mb-3">
                <label class="form-label" for="Titulo">Título de la sección</label>
                <input id="Titulo" name="Titulo" class="form-control" maxlength="150" value="@Model.Titulo" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
                <div class="form-text">No escribas el número: lo pone el sistema según el orden de la sección.</div>
            </div>
        }
        <div class="mb-3">
            <label class="form-label" for="Cuerpo">Texto</label>
            <textarea id="Cuerpo" name="Cuerpo" class="form-control" rows="14">@Model.Cuerpo</textarea>
            <span asp-validation-for="Cuerpo" class="text-danger small"></span>
            <div class="form-text">
                Una línea en blanco separa los párrafos. Marcas: <code>- Viñeta</code> · <code>&gt; Recuadro destacado</code> ·
                <code>**negrita**</code> · <code>[texto](https://enlace)</code> · <code>[color=#C92B0A]texto[/color]</code>.
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-line" href="/Blog/@Model.Slug">Cancelar</a>
            <button class="btn btn-brand" type="submit">Guardar</button>
        </div>
    </form>
</div>
