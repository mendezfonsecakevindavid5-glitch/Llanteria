@model IEnumerable<Llanteria.Models.Cliente>

@{
    ViewData["Title"] = "Puntos de clientes";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Puntos de clientes", "Cada $1.000 facturados suman 1 punto. Aquí puedes ajustarlos manualmente."))

<form id="formPuntos" asp-action="ModificarPuntos" method="post" class="d-none">
    <input type="hidden" name="id" />
    <input type="hidden" name="cantidad" />
    <input type="hidden" name="operacion" />
</form>

<form id="formCanje" asp-action="Canjear" method="post" class="d-none">
    <input type="hidden" name="id" />
    <input type="hidden" name="idIncentivo" />
</form>

<div class="panel">
    <div class="panel-head">
        <span>@Model.Count() clientes</span>
        <input id="buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar cliente" />
    </div>
    <div class="table-responsive">
        <table class="data-table" id="tabla">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Documento</th>
                    <th class="text-end">Puntos</th>
                    <th class="text-end">Ajustar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="cell-title">@c.Nombres @c.Apellidos</td>
                        <td>@c.NumeroDocumento</td>
                        <td class="text-end"><strong>@c.PuntosAcumulados.ToString("N0")</strong></td>
                        <td class="text-end">
                            <span class="row-actions">
                                <button type="button" class="icon-btn" title="Sumar puntos" data-puntos="sumar" data-id="@c.Id" data-nombre="@c.Nombres @c.Apellidos"><i class="fa-solid fa-plus"></i></button>
                                <button type="button" class="icon-btn" title="Canjear premio" data-canje="@c.Id" data-nombre="@c.Nombres @c.Apellidos" data-puntos-cliente="@c.PuntosAcumulados"><i class="fa-solid fa-gift"></i></button>
                                <button type="button" class="icon-btn danger" title="Restar puntos" data-puntos="restar" data-id="@c.Id" data-nombre="@c.Nombres @c.Apellidos"><i class="fa-solid fa-minus"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="empty-state">Aún no hay clientes registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscar').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#tabla tbody tr').forEach(function (tr) {
                tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });

        const premios = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.Incentivos));
        document.addEventListener('click', function (e) {
            const g = e.target.closest('[data-canje]');
            if (!g) return;
            const pts = parseInt(g.dataset.puntosCliente, 10);
            const alcanzan = premios.filter(p => p.puntos <= pts);
            if (!alcanzan.length) {
                Swal.fire({ icon: 'info', title: 'Sin premios disponibles', text: g.dataset.nombre + ' tiene ' + pts + ' puntos y todavía no le alcanza para ningún premio.' });
                return;
            }
            const opciones = {};
            alcanzan.forEach(p => opciones[p.id] = p.nombre + ' — ' + p.puntos + ' pts');
            Swal.fire({
                title: 'Canjear premio', text: g.dataset.nombre + ' · ' + pts + ' puntos',
                input: 'select', inputOptions: opciones, inputPlaceholder: 'Elige un premio',
                showCancelButton: true, confirmButtonText: 'Canjear', cancelButtonText: 'Cancelar', confirmButtonColor: '#C92B0A',
                inputValidator: v => v ? null : 'Elige un premio'
            }).then(function (r) {
                if (!r.isConfirmed) return;
                const f = document.getElementById('formCanje');
                f.elements['id'].value = g.dataset.canje;
                f.elements['idIncentivo'].value = r.value;
                f.submit();
            });
        });

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-puntos]');
            if (!btn) return;
            const op = btn.dataset.puntos;
            Swal.fire({
                title: op === 'sumar' ? 'Sumar puntos' : 'Restar puntos',
                text: btn.dataset.nombre,
                input: 'number',
                inputAttributes: { min: 1, step: 1 },
                inputPlaceholder: 'Cantidad de puntos',
                showCancelButton: true,
                confirmButtonText: 'Aplicar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#C92B0A',
                inputValidator: v => (!v || parseInt(v, 10) < 1) ? 'Escribe una cantidad mayor a cero' : null
            }).then(function (r) {
                if (!r.isConfirmed) return;
                const f = document.getElementById('formPuntos');
                f.elements['id'].value = btn.dataset.id;
                f.elements['cantidad'].value = parseInt(r.value, 10);
                f.elements['operacion'].value = op;
                f.submit();
            });
        });
    </script>
}
