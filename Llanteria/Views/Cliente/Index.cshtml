@model IEnumerable<Llanteria.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fa-solid fa-address-book"></i> Directorio de Clientes</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-user-plus"></i> Nuevo Cliente
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre Completo</th>
                    <th>Documento</th>
                    <th>Contacto</th>
                    <th class="text-center">Puntos</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@item.Nombres @item.Apellidos</div>
                            <small class="text-muted">@item.IdSexoNavigation?.Nombre</small>
                        </td>
                        <td>
                            <span class="text-secondary small">@item.IdDocumentoNavigation?.Nombre</span><br />
                            @item.NumeroDocumento
                        </td>
                        <td>
                            <i class="fa-solid fa-phone fa-xs"></i> @item.Telefono <br />
                            <i class="fa-solid fa-envelope fa-xs"></i> <small>@item.Correo</small>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-warning text-dark shadow-sm">
                                <i class="fa-solid fa-star"></i> @item.PuntosAcumulados
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <button type="button" class="btn btn-danger btn-sm" onclick="confirmarEliminar(@item.Id, '@item.Nombres')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar cliente?',
                text: "Se borrará a: " + nombre + ". Esto podría afectar facturas existentes.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Cliente/Delete/' + id;
                }
            })
        }
    </script>
}