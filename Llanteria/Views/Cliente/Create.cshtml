@model Llanteria.Models.Cliente

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa-solid fa-user-plus"></i> Registro de Cliente</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombres" class="form-label fw-bold"></label>
                            <input asp-for="Nombres" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellidos" class="form-label fw-bold"></label>
                            <input asp-for="Apellidos" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tipo de Documento</label>
                            <select asp-for="IdDocumento" class="form-select" asp-items="ViewBag.IdDocumento"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumeroDocumento" class="form-label fw-bold">Nro. Documento</label>
                            <input asp-for="NumeroDocumento" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Correo" class="form-label fw-bold"></label>
                            <input asp-for="Correo" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label fw-bold"></label>
                            <input asp-for="Telefono" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Género</label>
                            <select asp-for="IdSexo" class="form-select" asp-items="ViewBag.IdSexo"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PuntosAcumulados" class="form-label fw-bold">Puntos Iniciales</label>
                            <input asp-for="PuntosAcumulados" class="form-control" value="0" />
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar Cliente</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>