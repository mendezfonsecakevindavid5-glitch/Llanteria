@{
    ViewData["Title"] = "Serviteca Móvil";
}

<div class="container py-5">

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="d-flex items-center gap-3 mb-3">
                <div class="bg-danger text-white p-3 rounded-3">
                    <i class="fa-solid fa-truck-pickup fa-2xl"></i>
                </div>
                <div>
                    <h1 class="fw-black text-uppercase m-0">Serviteca Móvil</h1>
                    <p class="text-muted m-0">Atención especializada donde la necesites</p>
                </div>
            </div>

            <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=1000&q=80" class="img-fluid rounded-4 shadow-sm mb-4" alt="Serviteca Móvil">

            <h4 class="fw-bold mb-3">¿En qué consiste el servicio?</h4>
            <p class="text-muted leading-relaxed">
                Llevamos nuestro taller móvil directamente hasta tu casa u oficina en Valledupar. Realizamos montaje, balanceo, despinche y cambio de baterías sin que tengas que desplazarte.
            </p>

            <div class="row g-3 my-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-house text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Comodidad Total</h6>
                        <p class="small text-muted m-0">Atención personalizada a domicilio sin filas.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-clock text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Ahorro de Tiempo</h6>
                        <p class="small text-muted m-0">Continuas con tus labores mientras atendemos tu auto.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-lg p-4 rounded-4 sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-1">Solicita este servicio</h4>
                <p class="small text-muted mb-4">Ingresa tus datos y te contactaremos para agendar tu cita.</p>

                <form>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Servicio</label>
                        <input type="text" class="form-control bg-light fw-bold" value="Serviteca Móvil" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control" placeholder="Ej. Ana Mercedes" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-mail</label>
                        <input type="email" class="form-control" placeholder="correo@ejemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Teléfono / Dirección</label>
                        <input type="tel" class="form-control" placeholder="Ej. 300 123 4567" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mensaje / Vehículo</label>
                        <textarea class="form-control" rows="3" placeholder="Dirección exacta en Valledupar y detalles..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 py-3 fw-bold text-uppercase">Enviar Solicitud</button>
                </form>
            </div>
        </div>
    </div>
</div>