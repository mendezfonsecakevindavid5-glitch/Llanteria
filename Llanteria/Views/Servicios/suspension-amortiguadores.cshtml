@{
    ViewData["Title"] = "Suspensión y Amortiguadores";
}

<div class="container py-5">

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="d-flex items-center gap-3 mb-3">
                <div class="bg-danger text-white p-3 rounded-3">
                    <i class="fa-solid fa-truck-monster fa-2xl"></i>
                </div>
                <div>
                    <h1 class="fw-black text-uppercase m-0">Suspensión y Amortiguadores</h1>
                    <p class="text-muted m-0">Diagnóstico técnico para garantizar la estabilidad y el confort</p>
                </div>
            </div>

            <img src="https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1000&q=80" class="img-fluid rounded-4 shadow-sm mb-4" alt="Suspensión">

            <h4 class="fw-bold mb-3">¿En qué consiste el servicio?</h4>
            <p class="text-muted leading-relaxed">
                Inspeccionamos detalladamente amortiguadores, espirales, bujes, terminales de dirección y rótulas para asegurar el agarre del vehículo sobre el asfalto y brindar máximo confort en cabina.
            </p>

            <div class="row g-3 my-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-shield-cat text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Seguridad en Curvas</h6>
                        <p class="small text-muted m-0">Mantiene el vehículo firme en maniobras exigentes.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-road text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Absorción de Impactos</h6>
                        <p class="small text-muted m-0">Filtra las irregularidades del camino eficientemente.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-lg p-4 rounded-4 sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-1">Solicita este servicio</h4>
                <p class="small text-muted mb-4">Ingresa tus datos y te contactaremos para agendar tu cita.</p>

                <form>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Servicio</label>
                        <input type="text" class="form-control bg-light fw-bold" value="Suspensión y Amortiguadores" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control" placeholder="Ej. Ana Mercedes" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-mail</label>
                        <input type="email" class="form-control" placeholder="correo@ejemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Teléfono de contacto</label>
                        <input type="tel" class="form-control" placeholder="Ej. 300 123 4567" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mensaje / Vehículo</label>
                        <textarea class="form-control" rows="3" placeholder="Detalles de tu vehículo..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 py-3 fw-bold text-uppercase">Enviar Solicitud</button>
                </form>
            </div>
        </div>
    </div>
</div>