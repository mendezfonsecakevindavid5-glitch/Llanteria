@{
    ViewData["Title"] = "Alineación 3D";
}

<div class="container py-5">

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="d-flex items-center gap-3 mb-3">
                <div class="bg-danger text-white p-3 rounded-3">
                    <i class="fa-solid fa-arrows-to-dot fa-2xl"></i>
                </div>
                <div>
                    <h1 class="fw-black text-uppercase m-0">Alineación 3D</h1>
                    <p class="text-muted m-0">Ajuste técnico milimétrico con tecnología óptica</p>
                </div>
            </div>

            <img src="https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=1000&q=80" class="img-fluid rounded-4 shadow-sm mb-4" alt="Alineación 3D">

            <h4 class="fw-bold mb-3">¿En qué consiste el servicio?</h4>
            <p class="text-muted leading-relaxed">
                Utilizamos sensores ópticos de alta definición para ajustar los ángulos de las ruedas (Camber, Caster y Toe) exactamente según las especificaciones originales del fabricante de tu vehículo.
            </p>

            <div class="row g-3 my-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-compass text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Trayectoria Recta</h6>
                        <p class="small text-muted m-0">Evita que el vehículo se desvíe hacia los lados en recta.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-leaf text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Ahorro de Combustible</h6>
                        <p class="small text-muted m-0">Reduce la fricción innecesaria del neumático con el asfalto.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-lg p-4 rounded-4 sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-1">Solicita este servicio</h4>
                <p class="small text-muted mb-4">Ingresa tus datos y te contactaremos para agendar tu cita.</p>

                <form>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Servicio</label>
                        <input type="text" class="form-control bg-light fw-bold" value="Alineación 3D" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control" placeholder="Ej. Ana Mercedes" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-mail</label>
                        <input type="email" class="form-control" placeholder="correo@ejemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Teléfono de contacto</label>
                        <input type="tel" class="form-control" placeholder="Ej. 300 123 4567" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mensaje / Vehículo</label>
                        <textarea class="form-control" rows="3" placeholder="Detalles de tu vehículo..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 py-3 fw-bold text-uppercase">Enviar Solicitud</button>
                </form>
            </div>
        </div>
    </div>
</div>