@{
    ViewData["Title"] = "Baterías";
}

<div class="container py-5">

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="d-flex items-center gap-3 mb-3">
                <div class="bg-danger text-white p-3 rounded-3">
                    <i class="fa-solid fa-car-battery fa-2xl"></i>
                </div>
                <div>
                    <h1 class="fw-black text-uppercase m-0">Venta e Instalación de Baterías</h1>
                    <p class="text-muted m-0">Diagnóstico de carga e instalación profesional con garantía</p>
                </div>
            </div>

            <img src="https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=1000&q=80" class="img-fluid rounded-4 shadow-sm mb-4" alt="Baterías">

            <h4 class="fw-bold mb-3">¿En qué consiste el servicio?</h4>
            <p class="text-muted leading-relaxed">
                Realizamos la revisión digital del estado del acumulador y del sistema de carga de tu vehículo (alternador). Contamos con baterías de alta potencia y respaldo de marcas líderes del mercado.
            </p>

            <div class="row g-3 my-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-award text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Garantía Nacional</h6>
                        <p class="small text-muted m-0">Respaldo directo y soporte ante cualquier eventualidad.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-white shadow-sm">
                        <i class="fa-solid fa-screwdriver-wrench text-danger mb-2 fa-lg"></i>
                        <h6 class="fw-bold">Instalación Gratis</h6>
                        <p class="small text-muted m-0">Montaje sin costo adicional al adquirir la batería.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-lg p-4 rounded-4 sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-1">Solicita este servicio</h4>
                <p class="small text-muted mb-4">Ingresa tus datos y te contactaremos para agendar tu cita.</p>

                <form>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Servicio</label>
                        <input type="text" class="form-control bg-light fw-bold" value="Baterías" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control" placeholder="Ej. Ana Mercedes" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-mail</label>
                        <input type="email" class="form-control" placeholder="correo@ejemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Teléfono de contacto</label>
                        <input type="tel" class="form-control" placeholder="Ej. 300 123 4567" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mensaje / Vehículo</label>
                        <textarea class="form-control" rows="3" placeholder="Detalles de tu vehículo..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 py-3 fw-bold text-uppercase">Enviar Solicitud</button>
                </form>
            </div>
        </div>
    </div>
</div>