@model Llanteria.Models.ServicioViewModel

@{
    ViewData["Title"] = Model.Titulo;
    var autenticado = User.Identity?.IsAuthenticated == true;
}

<div class="container py-5">
    <a asp-controller="Home" asp-action="Index" asp-fragment="servicios" class="small text-muted text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Todos los servicios</a>

    <div class="d-flex align-items-center gap-3 mt-3 mb-4">
        <span class="icon-tile service-detail-icon"><i class="fa-solid @Model.Icono"></i></span>
        <div>
            <h1 class="h2 fw-bold mb-0">@Model.Titulo</h1>
            <p class="text-muted mb-0">@Model.Subtitulo</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="side-card mb-3">
                <h2 class="h5 fw-bold">¿En qué consiste?</h2>
                <p class="text-muted mb-0">@Model.Descripcion</p>
            </div>

            <div class="row g-3 mb-3">
                @foreach (var v in Model.Ventajas)
                {
                    <div class="col-sm-6">
                        <div class="side-card h-100">
                            <i class="fa-solid @v.Icono text-llanteria-primary mb-2"></i>
                            <h3 class="h6 fw-bold">@v.Titulo</h3>
                            <p class="small text-muted mb-0">@v.Texto</p>
                        </div>
                    </div>
                }
            </div>

            <div class="side-card">
                <h2 class="h6 fw-bold mb-3"><i class="fa-solid fa-circle-info text-llanteria-primary me-2"></i>Información para tu cita</h2>
                <ul class="mb-0 ps-3">
                    @foreach (var i in Model.InfoCita)
                    {
                        <li class="mb-1"><strong>@i.Etiqueta:</strong> @i.Texto</li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="side-card">
                <div class="d-flex justify-content-between align-items-baseline mb-3">
                    <span class="text-muted">@Model.EtiquetaPrecio</span>
                    <strong class="fs-5 text-llanteria-primary">@Model.Precio</strong>
                </div>

                @if (autenticado)
                {
                    <h2 class="h5 fw-bold">Agendar cita</h2>
                    <form asp-controller="Citas" asp-action="Agendar" method="post">
                        <input type="hidden" name="slug" value="@Model.Slug" />
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="fecha">Fecha</label>
                                <input id="fecha" type="date" name="fecha" class="form-control" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="hora">Hora</label>
                                <select id="hora" name="hora" class="form-select" required>
                                    <option value="" selected disabled>Elige…</option>
                                    @foreach (var h in Model.Horarios)
                                    {
                                        <option value="@h">@h</option>
                                    }
                                </select>
                            </div>
                            @if (Model.EsDomicilio)
                            {
                                <div class="col-12">
                                    <label class="form-label" for="direccion">Dirección</label>
                                    <input id="direccion" name="direccion" class="form-control" required maxlength="200" placeholder="Calle, barrio y referencia" />
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label" for="vehiculo">Vehículo</label>
                                <input id="vehiculo" name="vehiculo" class="form-control" required maxlength="100" placeholder="@Model.PlaceholderVehiculo" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="formaPago">Forma de pago</label>
                                <select id="formaPago" name="formaPago" class="form-select">
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Tarjeta">Datáfono (débito o crédito)</option>
                                    <option value="Transferencia">Nequi, Daviplata o transferencia</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="notas">Notas (opcional)</label>
                                <textarea id="notas" name="notas" class="form-control" rows="2" maxlength="400" placeholder="@Model.PlaceholderNotas"></textarea>
                            </div>
                        </div>
                        <div class="mt-3"><partial name="_AvisoDatos" /></div>
                        <button type="submit" class="btn btn-hyper-action w-100 py-2 mt-3">Solicitar cita</button>
                    </form>
                }
                else
                {
                    <h2 class="h5 fw-bold">@(string.IsNullOrEmpty(Model.TituloVisitante) ? "Solicita información" : Model.TituloVisitante)</h2>
                    @if (!string.IsNullOrEmpty(Model.TextoVisitante))
                    {
                        <p class="small text-muted">@Model.TextoVisitante</p>
                    }
                    <form asp-controller="Servicios" asp-action="SolicitarContacto" method="post">
                        <input type="hidden" name="slug" value="@Model.Slug" />
                        <div class="mb-3">
                            <label class="form-label" for="nombre">Nombre</label>
                            <input id="nombre" name="nombre" class="form-control" required maxlength="100" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="correo">Correo</label>
                                <input id="correo" type="email" name="correo" class="form-control" required maxlength="100" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="telefono">Teléfono</label>
                                <input id="telefono" type="tel" name="telefono" class="form-control" required maxlength="20" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="mensaje">Vehículo y detalles</label>
                            <textarea id="mensaje" name="mensaje" class="form-control" rows="2" maxlength="500" placeholder="@Model.PlaceholderMensaje"></textarea>
                        </div>
                        <div class="mb-3"><partial name="_AvisoDatos" /></div>
                        <button type="submit" class="btn btn-hyper-action w-100 py-2">Enviar solicitud</button>
                    </form>
                    <hr />
                    <p class="small text-muted mb-2">¿Quieres agendar directamente? Inicia sesión para elegir fecha y hora.</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-llanteria-primary btn-sm w-100">Iniciar sesión</a>
                }
            </div>
        </div>
    </div>
</div>
