@model IEnumerable<Llanteria.Models.Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Vehículos", "Vehículos de los clientes del taller.", BotonTexto: "Nuevo vehículo", BotonAction: "Create", BotonController: "Vehiculo"))

<div class="panel">
    <div class="panel-head">
        <span>@Model.Count() vehículos</span>
        <input id="buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar placa, marca o propietario" />
    </div>
    <div class="table-responsive">
        <table class="data-table" id="tabla">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Vehículo</th>
                    <th>Propietario</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.OrderBy(x => x.Placa))
                {
                    <tr>
                        <td class="cell-title">@v.Placa</td>
                        <td>@v.Marca @v.Modelo
                            @if (v.Anio.HasValue || v.Kilometraje.HasValue)
                            {
                                <div class="cell-sub">@(v.Anio?.ToString() ?? "") @(v.Kilometraje.HasValue ? "· " + v.Kilometraje.Value.ToString("N0") + " km" : "")</div>
                            }
                        </td>
                        <td>
                            <div>@v.Cliente?.Nombres @v.Cliente?.Apellidos</div>
                            <div class="cell-sub">@v.Cliente?.Telefono</div>
                        </td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Historial" asp-route-id="@v.Id" class="icon-btn" title="Historial de mantenimiento"><i class="fa-solid fa-clock-rotate-left"></i></a>
                                <a asp-controller="OrdenTrabajo" asp-action="Create" asp-route-idVehiculo="@v.Id" class="icon-btn" title="Nueva orden de trabajo"><i class="fa-solid fa-clipboard-check"></i></a>
                                <a asp-action="Edit" asp-route-id="@v.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = v.Id })" data-nombre="@v.Placa"><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="empty-state">Aún no hay vehículos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscar').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#tabla tbody tr').forEach(function (tr) {
                tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}
