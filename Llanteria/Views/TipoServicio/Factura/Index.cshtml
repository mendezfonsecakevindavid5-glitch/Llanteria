@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Factura>

@{
    ViewData["Title"] = "Ventas";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Ventas", "Facturas emitidas a los clientes.", BotonTexto: "Nueva factura", BotonAction: "Create", BotonController: "Factura"))

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><div class="label">Vendido este mes</div><div class="value money">@(((decimal)ViewBag.VendidoMes).ToString("C0"))</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><div class="label">Facturas este mes</div><div class="value">@ViewBag.FacturasMes</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar por número o cliente" />
            <button class="btn btn-line btn-sm">Buscar</button>
            <a asp-action="Exportar" asp-route-buscar="@ViewBag.Buscar" class="btn btn-line btn-sm ms-auto"><i class="fa-solid fa-file-excel me-1"></i>Exportar a Excel</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table" >
            <thead>
                <tr>
                    <th>N.º</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Items)
                {
                    <tr>
                        <td class="cell-title">#@f.Id</td>
                        <td>@f.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>@f.IdClienteNavigation?.Nombres @f.IdClienteNavigation?.Apellidos</td>
                        <td class="text-end money">@f.TotalPagar.ToString("C0")</td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Details" asp-route-id="@f.Id" class="icon-btn" title="Ver"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@f.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = f.Id })" data-nombre="Factura #@f.Id"
                                        data-aviso="Se restarán al cliente los puntos que esta factura le dio."><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="empty-state">Aún no hay facturas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>

