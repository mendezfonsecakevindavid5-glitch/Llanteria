@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.SolicitudEmpresa>

@{
    ViewData["Title"] = "Solicitudes de empresas";
    string estado = ViewBag.Estado ?? "";
    string Clase(string e) => e switch { "Pendiente" => "tag-warn", "Contactada" => "tag-ok", _ => "tag-neutral" };
    var retorno = Context.Request.Path + Context.Request.QueryString;
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Solicitudes de empresas", "Empresas que pidieron propuesta de mantenimiento para su flota."))

<form id="formEstado" asp-action="CambiarEstado" method="post" class="d-none">
    <input type="hidden" name="id" />
    <input type="hidden" name="estado" />
    <input type="hidden" name="retorno" value="@retorno" />
</form>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><div class="label">Pendientes por contactar</div><div class="value">@ViewBag.Pendientes</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><div class="label">Vehículos en solicitudes abiertas</div><div class="value">@ViewBag.Vehiculos</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar empresa, contacto o NIT" />
            <select name="estado" class="form-select form-select-sm" style="max-width:170px">
                <option value="">Todos los estados</option>
                @foreach (var e in Llanteria.Models.SolicitudEmpresa.Estados) { <option value="@e" selected="@(estado == e)">@e</option> }
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
            <a asp-action="Exportar" asp-route-estado="@estado" asp-route-buscar="@ViewBag.Buscar" class="btn btn-line btn-sm ms-auto"><i class="fa-solid fa-file-excel me-1"></i>Exportar a Excel</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>Fecha</th><th>Empresa</th><th>Contacto</th><th>Flota</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td class="money">@s.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="cell-title">@s.Empresa
                            @if (!string.IsNullOrEmpty(s.Nit)) { <div class="cell-sub">NIT @s.Nit</div> }
                            @if (!string.IsNullOrEmpty(s.Ciudad)) { <div class="cell-sub">@s.Ciudad</div> }
                        </td>
                        <td>@s.Contacto<div class="cell-sub">@s.Telefono</div><div class="cell-sub">@s.Correo</div></td>
                        <td>@s.TipoFlota<div class="cell-sub">@s.NumeroVehiculos vehículos</div>
                            @if (!string.IsNullOrEmpty(s.Mensaje)) { <div class="cell-sub">@s.Mensaje</div> }
                        </td>
                        <td><span class="tag @Clase(s.Estado)">@s.Estado</span></td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a class="icon-btn" title="Responder por correo" href="mailto:@s.Correo"><i class="fa-solid fa-envelope"></i></a>
                                @if (s.Estado == "Pendiente")
                                {
                                    <button type="button" class="icon-btn" title="Marcar como contactada" data-estado="Contactada" data-id="@s.Id"><i class="fa-solid fa-phone"></i></button>
                                }
                                @if (s.Estado != "Cerrada")
                                {
                                    <button type="button" class="icon-btn" title="Cerrar solicitud" data-estado="Cerrada" data-id="@s.Id"><i class="fa-solid fa-flag-checkered"></i></button>
                                }
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="empty-state">No hay solicitudes con esos filtros.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            const b = e.target.closest('[data-estado]');
            if (!b) return;
            const f = document.getElementById('formEstado');
            f.elements['id'].value = b.dataset.id;
            f.elements['estado'].value = b.dataset.estado;
            f.submit();
        });
    </script>
}
