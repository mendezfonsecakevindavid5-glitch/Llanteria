@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Clientes", "Directorio de clientes y sus puntos.", BotonTexto: "Nuevo cliente", BotonAction: "Create", BotonController: "Cliente"))

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar nombre, documento, teléfono o correo" />
            <button class="btn btn-line btn-sm">Buscar</button>
            <a asp-action="Exportar" asp-route-buscar="@ViewBag.Buscar" class="btn btn-line btn-sm ms-auto"><i class="fa-solid fa-file-excel me-1"></i>Exportar a Excel</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table" >
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Documento</th>
                    <th>Contacto</th>
                    <th class="text-end">Puntos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="cell-title">@c.Nombres @c.Apellidos</td>
                        <td>@c.IdDocumentoNavigation?.SiglasPresentacion @c.NumeroDocumento</td>
                        <td>
                            <div>@c.Telefono</div>
                            <div class="cell-sub">@c.Correo</div>
                        </td>
                        <td class="text-end">@c.PuntosAcumulados.ToString("N0")</td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-controller="Factura" asp-action="Create" asp-route-idCliente="@c.Id" class="icon-btn" title="Nueva factura"><i class="fa-solid fa-file-invoice"></i></a>
                                <a asp-controller="Vehiculo" asp-action="Create" asp-route-idCliente="@c.Id" class="icon-btn" title="Agregar vehículo"><i class="fa-solid fa-car"></i></a>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = c.Id })" data-nombre="@c.Nombres @c.Apellidos"
                                        data-aviso="No se puede eliminar si tiene facturas o vehículos."><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="empty-state">Aún no hay clientes registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>

