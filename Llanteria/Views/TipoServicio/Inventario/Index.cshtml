@model IEnumerable<Llanteria.Models.Inventario>

@{
    ViewData["Title"] = "Existencias";
    var admin = User.IsInRole("Administrador");
    string buscar = ViewBag.Buscar;
    string filtro = ViewBag.Filtro;
}

@if (admin)
{
    await Html.RenderPartialAsync("_PageHeader", new PageHeader("Existencias", "Stock por producto y bodega.", BotonTexto: "Nuevas existencias", BotonAction: "Create", BotonController: "Inventario"));
}
else
{
    await Html.RenderPartialAsync("_PageHeader", new PageHeader("Existencias", "Stock por producto y bodega."));
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="stat"><div class="label">Referencias</div><div class="value">@ViewBag.Referencias</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat"><div class="label">Unidades</div><div class="value">@(((int)ViewBag.Unidades).ToString("N0"))</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat accent"><div class="label">Bajo el mínimo</div><div class="value">@ViewBag.Bajos</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat"><div class="label">Agotados</div><div class="value">@ViewBag.Agotados</div></div></div>
</div>

<form id="formEntrada" asp-action="Entrada" method="post" class="d-none">
    <input type="hidden" name="id" />
    <input type="hidden" name="cantidad" />
</form>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@buscar" type="search" class="form-control form-control-sm" style="max-width:280px" placeholder="Buscar producto, código o bodega" />
            <select name="filtro" class="form-select form-select-sm" style="max-width:180px">
                <option value="" selected="@(filtro != "bajo")">Todo</option>
                <option value="bajo" selected="@(filtro == "bajo")">Solo stock bajo</option>
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
            <a asp-action="Exportar" asp-route-buscar="@buscar" asp-route-filtro="@filtro" class="btn btn-line btn-sm ms-auto"><i class="fa-solid fa-file-excel me-1"></i>Exportar a Excel</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Código</th>
                    <th>Bodega</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Mínimo</th>
                    <th>Estado</th>
                    <th>Último ingreso</th>
                    @if (admin) { <th class="text-end">Acciones</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    var stock = i.StockActual ?? 0;
                    var bajo = i.StockMinimo.HasValue && stock <= i.StockMinimo;
                    <tr>
                        <td class="cell-title">@i.IdProductoNavigation?.Nombre</td>
                        <td>@i.Codigo</td>
                        <td>@i.IdBodegaNavigation?.NombreBodega</td>
                        <td class="text-end">
                            <span class="tag @(stock <= 0 ? "tag-bad" : bajo ? "tag-warn" : "tag-ok")">@stock</span>
                        </td>
                        <td class="text-end">@i.StockMinimo</td>
                        <td>@i.IdEstadoNavigation?.Nombre</td>
                        <td>@i.FechaIngreso?.ToString("dd/MM/yyyy")</td>
                        @if (admin)
                        {
                            <td class="text-end">
                                <span class="row-actions">
                                    <button type="button" class="icon-btn" title="Registrar entrada" data-entrada="@i.Id" data-nombre="@i.IdProductoNavigation?.Nombre"><i class="fa-solid fa-plus"></i></button>
                                    <a asp-action="Edit" asp-route-id="@i.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                    <button type="button" class="icon-btn danger" title="Eliminar"
                                            data-delete="@Url.Action("Delete", new { id = i.Id })" data-nombre="@i.IdProductoNavigation?.Nombre (@i.Codigo)"
                                            data-aviso="Se pierde el registro de existencias de este lote."><i class="fa-solid fa-trash"></i></button>
                                </span>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="@(admin ? 8 : 7)" class="empty-state">No hay existencias para mostrar.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-entrada]');
            if (!btn) return;
            Swal.fire({
                title: 'Entrada de mercancía',
                text: btn.dataset.nombre,
                input: 'number',
                inputAttributes: { min: 1, step: 1 },
                inputPlaceholder: 'Unidades que ingresan',
                showCancelButton: true,
                confirmButtonText: 'Sumar al stock',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#C92B0A',
                inputValidator: v => (!v || parseInt(v, 10) < 1) ? 'Escribe una cantidad mayor a cero' : null
            }).then(function (r) {
                if (!r.isConfirmed) return;
                const f = document.getElementById('formEntrada');
                f.elements['id'].value = btn.dataset.entrada;
                f.elements['cantidad'].value = parseInt(r.value, 10);
                f.submit();
            });
        });
    </script>
}
