@model IEnumerable<Llanteria.Models.TipoServicio>

@{
    ViewData["Title"] = "Catálogo de Servicios";
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-gears text-primary"></i> Servicios del Taller
            </h2>
            <p class="text-muted small m-0">Gestiona los servicios mecánicos ofrecidos, sus costos sugeridos e identidad visual (iconos).</p>
        </div>

        <a asp-action="Create" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
            <i class="fa-solid fa-plus"></i> Nuevo Servicio
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small tracking-wider" style="background-color: #1a1e21;">
                    <tr>
                        <th scope="col" class="ps-4 text-center" style="width: 100px;">Icono</th>
                        <th scope="col">Nombre del Servicio</th>
                        <th scope="col" class="text-end" style="width: 200px;">Valor Sugerido</th>
                        <th scope="col" class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-center">
                                    <div class="rounded-3 border bg-light shadow-sm d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="@(string.IsNullOrEmpty(item.IconoPath) ? "fa-solid fa-wrench" : item.IconoPath) text-primary fs-4"></i>
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark">@item.NombreServicio</span>
                                </td>

                                <td class="text-end fw-bold text-success pe-3">
                                    $ @item.ValorServicio.ToString("N0")
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-2" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-2" title="Eliminar" onclick="confirmarEliminar(@item.Id, '@item.NombreServicio')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open display-4 mb-3 d-block text-secondary"></i>
                                <span class="fw-semibold">No hay servicios registrados en este momento.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .table method th {
        border-bottom: none;
    }
</style>

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar servicio?',
                text: "Se borrará de forma permanente: " + nombre,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/TipoServicio/Delete/' + id;
                }
            })
        }
    </script>
}