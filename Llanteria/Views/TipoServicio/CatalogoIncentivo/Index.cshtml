@model IEnumerable<Llanteria.Models.CatalogoIncentivo>

@{
    ViewData["Title"] = "Incentivos";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Incentivos", "Premios que los clientes canjean con sus puntos.", BotonTexto: "Nuevo incentivo", BotonAction: "Create", BotonController: "CatalogoIncentivo"))

<div class="panel">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Premio</th>
                    <th class="text-end">Puntos</th>
                    <th class="text-end">Disponibles</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.OrderBy(x => x.PuntosRequeridos))
                {
                    <tr>
                        <td>
                            <div class="cell-title">@i.NombrePremio</div>
                            @if (!string.IsNullOrWhiteSpace(i.Descripcion))
                            {
                                <div class="cell-sub">@i.Descripcion</div>
                            }
                        </td>
                        <td class="text-end">@i.PuntosRequeridos.ToString("N0")</td>
                        <td class="text-end">
                            @if (i.StockDisponible is null)
                            {
                                <span class="tag tag-neutral">Sin límite</span>
                            }
                            else if (i.StockDisponible <= 0)
                            {
                                <span class="tag tag-bad">Agotado</span>
                            }
                            else
                            {
                                @i.StockDisponible
                            }
                        </td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Edit" asp-route-id="@i.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = i.Id })" data-nombre="@i.NombrePremio"
                                        data-aviso="Si ya fue canjeado, no podrá eliminarse."><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="empty-state">Aún no hay incentivos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
