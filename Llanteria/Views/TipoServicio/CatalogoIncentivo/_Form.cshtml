@model Llanteria.Models.CatalogoIncentivo

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="NombrePremio" class="form-label">Premio</label>
        <input asp-for="NombrePremio" class="form-control" maxlength="100" placeholder="Ej. Cambio de aceite gratis" autofocus />
        <span asp-validation-for="NombrePremio" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="300"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
    <div class="row g-3">
        <div class="col-sm-6">
            <label asp-for="PuntosRequeridos" class="form-label">Puntos requeridos</label>
            <input asp-for="PuntosRequeridos" type="number" min="1" class="form-control" />
            <span asp-validation-for="PuntosRequeridos" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="StockDisponible" class="form-label">Unidades disponibles</label>
            <input asp-for="StockDisponible" type="number" min="0" class="form-control" />
            <span asp-validation-for="StockDisponible" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
