@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Pedido>
@{
    ViewData["Title"] = "Pedidos";
    string estado = ViewBag.Estado ?? "";
    string Clase(string e) => e switch
    {
        "Pendiente" => "tag-warn",
        "Pagado" => "tag-ok",
        "Enviado" => "tag-neutral",
        "Entregado" => "tag-ok",
        _ => "tag-bad"
    };
    var retorno = Context.Request.Path + Context.Request.QueryString;
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Pedidos", "Compras hechas desde la tienda en línea."))

<form id="formEstado" asp-action="CambiarEstado" method="post" class="d-none">
    <input type="hidden" name="id" />
    <input type="hidden" name="estado" />
    <input type="hidden" name="retorno" value="@retorno" />
</form>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><div class="label">Pendientes de pago</div><div class="value">@ViewBag.Pendientes</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><div class="label">Pagados por despachar</div><div class="value">@ViewBag.PorEnviar</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar número, cliente o documento" />
            <select name="estado" class="form-select form-select-sm" style="max-width:170px">
                <option value="">Todos los estados</option>
                @foreach (var e in Llanteria.Models.Pedido.Estados) { <option value="@e" selected="@(estado == e)">@e</option> }
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
            <a asp-action="Exportar" asp-route-estado="@estado" asp-route-buscar="@ViewBag.Buscar" class="btn btn-line btn-sm ms-auto"><i class="fa-solid fa-file-excel me-1"></i>Exportar a Excel</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>Pedido</th><th>Cliente</th><th>Entrega</th><th>Pago</th><th>Estado</th><th class="text-end">Total</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td class="cell-title">@p.Numero<div class="cell-sub">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</div></td>
                        <td>@p.NombreCompleto<div class="cell-sub">@p.Telefono</div></td>
                        <td>@p.Ciudad<div class="cell-sub">@p.Pais</div></td>
                        <td>@p.MetodoPago</td>
                        <td><span class="tag @Clase(p.Estado)">@p.Estado</span></td>
                        <td class="text-end money">@p.Total.ToString("C0")</td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Detalle" asp-route-id="@p.Id" class="icon-btn" title="Ver detalle"><i class="fa-solid fa-eye"></i></a>
                                @if (p.Estado == "Pendiente") { <button type="button" class="icon-btn" title="Marcar como pagado" data-estado="Pagado" data-id="@p.Id"><i class="fa-solid fa-check"></i></button> }
                                @if (p.Estado == "Pagado") { <button type="button" class="icon-btn" title="Marcar como enviado" data-estado="Enviado" data-id="@p.Id"><i class="fa-solid fa-truck"></i></button> }
                                @if (p.Estado == "Enviado") { <button type="button" class="icon-btn" title="Marcar como entregado" data-estado="Entregado" data-id="@p.Id"><i class="fa-solid fa-flag-checkered"></i></button> }
                                @if (p.Estado is "Pendiente" or "Pagado") { <button type="button" class="icon-btn danger" title="Cancelar (devuelve el stock)" data-estado="Cancelado" data-id="@p.Id"><i class="fa-solid fa-xmark"></i></button> }
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="empty-state">No hay pedidos con esos filtros.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            const b = e.target.closest('[data-estado]');
            if (!b) return;
            const f = document.getElementById('formEstado');
            f.elements['id'].value = b.dataset.id;
            f.elements['estado'].value = b.dataset.estado;
            if (b.dataset.estado === 'Cancelado') {
                Swal.fire({ title: '¿Cancelar el pedido?', text: 'Se devolverá el stock al inventario.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Sí, cancelar', cancelButtonText: 'Volver', confirmButtonColor: '#C92B0A' })
                    .then(r => { if (r.isConfirmed) f.submit(); });
            } else f.submit();
        });
    </script>
}
