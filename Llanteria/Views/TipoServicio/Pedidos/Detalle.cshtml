@model Llanteria.Models.Pedido
@{
    ViewData["Title"] = $"Pedido {Model.Numero}";
}

@await Html.PartialAsync("_PageHeader", new PageHeader($"Pedido {Model.Numero}", Model.Fecha.ToString("dd 'de' MMMM 'de' yyyy, HH:mm"), "Pedidos", "Index"))

<div class="row g-3">
    <div class="col-lg-5">
        <div class="panel h-100">
            <div class="panel-head">Cliente y entrega</div>
            <div class="panel-body">
                <dl class="detail-list">
                    <dt>Nombre</dt><dd>@Model.NombreCompleto</dd>
                    <dt>Documento</dt><dd>@Model.TipoDocumento @Model.NumeroDocumento</dd>
                    <dt>Teléfono</dt><dd>@Model.Telefono</dd>
                    <dt>Correo</dt><dd>@Model.Correo</dd>
                    <dt>Dirección</dt><dd>@Model.Direccion@(string.IsNullOrEmpty(Model.Complemento) ? "" : ", " + Model.Complemento)</dd>
                    <dt>Ciudad</dt><dd>@Model.Ciudad, @Model.Departamento, @Model.Pais</dd>
                    <dt>Código postal</dt><dd>@Model.CodigoPostal</dd>
                    <dt>Pago</dt><dd>@Model.MetodoPago</dd>
                    <dt>Estado</dt><dd><span class="tag tag-neutral">@Model.Estado</span></dd>
                    <dt>Notas</dt><dd>@(string.IsNullOrWhiteSpace(Model.Notas) ? "—" : Model.Notas)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-head">Productos</div>
            <table class="data-table">
                <thead><tr><th>Descripción</th><th class="text-end">Cant.</th><th class="text-end">Unitario</th><th class="text-end">Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr><td>@i.Descripcion</td><td class="text-end">@i.Cantidad</td><td class="text-end money">@i.ValorUnitario.ToString("C0")</td><td class="text-end money">@i.Subtotal.ToString("C0")</td></tr>
                    }
                </tbody>
            </table>
            <div class="panel-body border-top">
                <dl class="detail-list" style="grid-template-columns:1fr auto">
                    <dt>Subtotal</dt><dd class="money text-end">@Model.Subtotal.ToString("C0")</dd>
                    @if (Model.Descuento > 0) { <dt>Descuento @Model.CodigoCupon</dt><dd class="money text-end">− @Model.Descuento.ToString("C0")</dd> }
                    <dt>Base gravable</dt><dd class="money text-end">@Model.BaseGravable.ToString("C0")</dd>
                    <dt>IVA</dt><dd class="money text-end">@Model.Iva.ToString("C0")</dd>
                    <dt class="fw-bold">Total</dt><dd class="money text-end fw-bold">@Model.Total.ToString("C0")</dd>
                </dl>
            </div>
        </div>

        @if (Model.Estado != "Cancelado" && Model.Estado != "Entregado")
        {
            <form asp-action="CambiarEstado" method="post" class="d-flex gap-2 mt-3 flex-wrap">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="retorno" value="@Url.Action("Detalle", new { id = Model.Id })" />
                @if (Model.Estado == "Pendiente") { <button name="estado" value="Pagado" class="btn btn-brand">Marcar como pagado</button> }
                @if (Model.Estado == "Pagado") { <button name="estado" value="Enviado" class="btn btn-brand">Marcar como enviado</button> }
                @if (Model.Estado == "Enviado") { <button name="estado" value="Entregado" class="btn btn-brand">Marcar como entregado</button> }
                @if (Model.Estado is "Pendiente" or "Pagado") { <button name="estado" value="Cancelado" class="btn btn-line" onclick="return confirm('¿Cancelar el pedido? Se devuelve el stock.');">Cancelar pedido</button> }
            </form>
        }
    </div>
</div>
