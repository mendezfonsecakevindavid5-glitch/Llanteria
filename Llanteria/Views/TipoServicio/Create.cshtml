@model Llanteria.Models.TipoServicio

@{
    ViewData["Title"] = "Registrar Servicio";
}

<div class="container py-5" style="max-width: 800px;">

    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
            <i class="fa-solid fa-arrow-left"></i> Volver al Catálogo
        </a>
        <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-plus-circle" style="color: #C92B0A;"></i> Registrar Nuevo Servicio
        </h2>
        <p class="text-muted small m-0">Añade un servicio mecánico subiendo una imagen real y asignando su precio base.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4">

                    <div class="col-12 d-flex align-items-center gap-3 bg-light p-3 rounded-3 border mb-2">
                        <div class="rounded-3 border bg-white shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 75px; height: 75px; flex-shrink: 0;">
                            <img id="previewImagen" src="/images/Servicios/default-servicio.png" class="w-100 h-100 object-fit-cover" alt="Previsualización" />
                        </div>
                        <div>
                            <span class="badge text-white text-uppercase px-2 py-1 mb-1" style="font-size: 0.7rem; background-color: #C92B0A;">Nuevo Registro</span>
                            <h6 class="m-0 fw-bold text-dark" id="previewNombre">Esperando nombre del servicio...</h6>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="NombreServicio" id="inputNombre" class="form-control" placeholder="Ej. Cambio de Aceite" required />
                            <label asp-for="NombreServicio" class="fw-semibold text-muted">Nombre del Servicio</label>
                            <span asp-validation-for="NombreServicio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ValorServicio" type="number" step="0.01" class="form-control text-end fw-bold text-dark" placeholder="0" required />
                            <label asp-for="ValorServicio" class="fw-semibold text-muted">Precio / Valor Sugerido ($)</label>
                            <span asp-validation-for="ValorServicio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-2 bg-white h-100 d-flex flex-column justify-content-center">
                            <label asp-for="ImagenArchivo" class="form-label small fw-semibold text-muted mb-1">Seleccionar Imagen (.jpg, .png)</label>
                            <input asp-for="ImagenArchivo" id="inputImagenFile" type="file" class="form-control form-control-sm" accept="image/*" />
                            <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-3 border">Cancelar</a>
                        <button type="submit" class="btn text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" style="background-color: #C92B0A; border: none;">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Servicio
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    .form-control:focus {
        border-color: #C92B0A;
        box-shadow: 0 0 0 0.25px rgba(201, 43, 10, 0.25);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Previsualizar la foto de la computadora antes de subirla
        document.getElementById("inputImagenFile").addEventListener("change", function(e) {
            const preview = document.getElementById("previewImagen");
            const file = e.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    preview.src = event.target.result;
                }
                reader.readAsDataURL(file);
            } else {
                preview.src = "/images/servicios/default-servicio.png";
            }
        });

        // Actualizar texto del banner
        document.getElementById("inputNombre").addEventListener("input", function(e) {
            const previewTxt = document.getElementById("previewNombre");
            previewTxt.innerText = e.target.value.trim() === "" ? "Esperando nombre..." : e.target.value;
        });
    </script>
}