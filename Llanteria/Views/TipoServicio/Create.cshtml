@model Llanteria.Models.TipoServicio

@{
    ViewData["Title"] = "Registrar Servicio";
}

<div class="container py-5" style="max-width: 800px;">

    <!-- ENCABEZADO CON BOTÓN DE REGRESAR -->
    <div class="mb-4 animate__animated animate__fadeIn">
        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
            <i class="fa-solid fa-arrow-left"></i> Volver al Catálogo
        </a>
        <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-plus-circle text-success"></i> Registrar Nuevo Servicio
        </h2>
        <p class="text-muted small m-0">Añade un nuevo servicio mecánico a la lista del taller, asignando su precio base y un icono identificador.</p>
    </div>

    <!-- TARJETA DEL FORMULARIO CON PREVISUALIZACIÓN -->
    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="card-body p-4 p-md-5 bg-white">

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4">

                    <!-- BANNER VISUAL CON ICONO EN TIEMPO REAL -->
                    <div class="col-12 d-flex align-items-center gap-3 bg-light p-3 rounded-3 border mb-2">
                        <div class="rounded-3 border bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 65px; height: 65px; flex-shrink: 0;">
                            <i id="previewIcono" class="fa-solid fa-wrench text-primary fs-3"></i>
                        </div>
                        <div>
                            <span class="badge bg-success text-uppercase px-2 py-1 mb-1" style="font-size: 0.7rem;">Nuevo Registro</span>
                            <h6 class="m-0 fw-bold text-dark" id="previewNombre">Esperando nombre del servicio...</h6>
                        </div>
                    </div>

                    <!-- Nombre del Servicio -->
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="NombreServicio" id="inputNombre" class="form-control" placeholder="Ej. Cambio de Aceite" required />
                            <label asp-for="NombreServicio" class="fw-semibold text-muted">Nombre del Servicio</label>
                            <span asp-validation-for="NombreServicio" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Valor/Precio Sugerido -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="ValorServicio" type="number" step="0.001" class="form-control text-end fw-bold text-success" placeholder="0" required />
                            <label asp-for="ValorServicio" class="fw-semibold text-success">Precio / Valor Sugerido ($)</label>
                            <span asp-validation-for="ValorServicio" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Ruta/Clase del Icono -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="IconoPath" id="inputIcono" class="form-control" placeholder="Ej. fa-solid fa-oil-can" />
                            <label asp-for="IconoPath" class="fw-semibold text-muted">Clase del Icono (FontAwesome)</label>
                            <span asp-validation-for="IconoPath" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- BOTONES DE ACCIÓN COMPACTOS -->
                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-3 border">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Servicio
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ESTILOS EXTRAS PARA ACABADO PREMIUM -->
<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25px rgba(25, 135, 84, 0.25);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Script dinámico interactivo para actualizar el banner superior en tiempo real -->
    <script>
        // Escucha y actualiza el icono de previsualización
        document.getElementById("inputIcono").addEventListener("input", function(e) {
            const preview = document.getElementById("previewIcono");
            const valor = e.target.value.trim();

            if(valor === "") {
                preview.className = "fa-solid fa-wrench text-primary fs-3";
            } else {
                preview.className = valor + " text-primary fs-3";
            }
        });

        // Escucha y actualiza el título del banner superior
        document.getElementById("inputNombre").addEventListener("input", function(e) {
            const previewTxt = document.getElementById("previewNombre");
            const valor = e.target.value.trim();

            if(valor === "") {
                previewTxt.innerText = "Esperando nombre del servicio...";
            } else {
                previewTxt.innerText = valor;
            }
        });
    </script>
}