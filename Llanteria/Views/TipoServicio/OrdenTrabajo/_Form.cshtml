@model Llanteria.Models.OrdenTrabajo

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    @if (Model.Id != 0)
    {
        <p class="text-muted small">Orden <strong>@Model.Numero</strong> · estado actual: <strong>@Model.Estado</strong>. El estado se cambia desde el listado.</p>
    }

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="IdVehiculo" class="form-label"></label>
            <select asp-for="IdVehiculo" class="form-select" asp-items="ViewBag.IdVehiculo"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdVehiculo" class="text-danger small"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" class="form-select" asp-items="ViewBag.Tipos"></select>
            <span asp-validation-for="Tipo" class="text-danger small"></span>
        </div>
        <div class="col-md-7">
            <label asp-for="Descripcion" class="form-label"></label>
            <input asp-for="Descripcion" class="form-control" maxlength="150" placeholder="Ej.: Cambio de aceite 5W-30 y filtro" />
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Kilometraje" class="form-label"></label>
            <input asp-for="Kilometraje" type="number" min="0" class="form-control" />
            <span asp-validation-for="Kilometraje" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Total" class="form-label"></label>
            <input asp-for="Total" type="number" min="0" step="1000" class="form-control" />
            <span asp-validation-for="Total" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="IdEmpleado" class="form-label"></label>
            <select asp-for="IdEmpleado" class="form-select" asp-items="ViewBag.IdEmpleado"><option value="">Sin asignar</option></select>
            <span asp-validation-for="IdEmpleado" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Observaciones" class="form-label"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="500" placeholder="Estado en que llega el vehículo, hallazgos, repuestos usados…"></textarea>
            <span asp-validation-for="Observaciones" class="text-danger small"></span>
        </div>
        <div class="col-12"><hr class="my-1" /><div class="small text-muted">Próximo servicio. Si lo dejas vacío, se calcula al entregar según el tipo de trabajo.</div></div>
        <div class="col-md-6">
            <label asp-for="ProximaFecha" class="form-label"></label>
            <input asp-for="ProximaFecha" type="date" class="form-control" />
            <span asp-validation-for="ProximaFecha" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ProximoKm" class="form-label"></label>
            <input asp-for="ProximoKm" type="number" min="0" class="form-control" />
            <span asp-validation-for="ProximoKm" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
