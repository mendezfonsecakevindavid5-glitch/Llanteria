@model Llanteria.Models.Usuario

@{
    ViewData["Title"] = "Editar usuario";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Editar usuario", "Cambia el rol o el estado de la cuenta.", "Usuario", "Index"))

<div class="panel panel-narrow">
    <div class="panel-body">
        <dl class="detail-list mb-3">
            <dt>Usuario</dt><dd>@Model.Username</dd>
            <dt>Empleado</dt><dd>@Model.IdEmpleadoNavigation?.Nombres @Model.IdEmpleadoNavigation?.Apellidos</dd>
            <dt>Correo</dt><dd>@Model.Correo</dd>
        </dl>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div class="mb-3">
                <label class="form-label" for="idRol">Rol</label>
                <select id="idRol" name="idRol" class="form-select" asp-items="ViewBag.IdRol"></select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="estado">Estado</label>
                <select id="estado" name="estado" class="form-select" asp-items="ViewBag.Estados"></select>
                <span class="text-danger small">@Html.ValidationMessage("Estado")</span>
            </div>
            <div id="sancion" class="@(Model.Estado == "Baneado" ? "" : "d-none")">
                <div class="mb-3">
                    <label class="form-label" for="motivoSancion">Motivo de la sanción</label>
                    <input id="motivoSancion" name="motivoSancion" class="form-control" maxlength="255" value="@Model.MotivoSancion" />
                    <span class="text-danger small">@Html.ValidationMessage("MotivoSancion")</span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="fechaFinBaneo">Baneado hasta</label>
                    <input id="fechaFinBaneo" name="fechaFinBaneo" type="datetime-local" class="form-control"
                           value="@Model.FechaFinBaneo?.ToString("yyyy-MM-ddTHH:mm")" />
                    <div class="form-text">Déjalo vacío para un baneo sin fecha de fin.</div>
                </div>
            </div>
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-line">Cancelar</a>
                <button type="submit" class="btn btn-brand">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const estado = document.getElementById('estado');
        const sancion = document.getElementById('sancion');
        estado.addEventListener('change', () => sancion.classList.toggle('d-none', estado.value !== 'Baneado'));
    </script>
}
