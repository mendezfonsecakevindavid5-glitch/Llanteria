@model Llanteria.Models.Usuario

@{
    ViewData["Title"] = "Nuevo usuario";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Nuevo usuario", "Crea el acceso al sistema para un empleado.", "Usuario", "Index"))

<div class="panel panel-medium">
    <div class="panel-body">
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IdEmpleado" class="form-label">Empleado</label>
                    <select asp-for="IdEmpleado" class="form-select" asp-items="ViewBag.IdEmpleado"><option value="0">Seleccione…</option></select>
                    <span asp-validation-for="IdEmpleado" class="text-danger small"></span>
                    @if (!((SelectList)ViewBag.IdEmpleado).Any())
                    {
                        <div class="form-text">Todos los empleados ya tienen usuario. Registra uno nuevo en Empleados.</div>
                    }
                </div>
                <div class="col-md-6">
                    <label asp-for="IdRol" class="form-label">Rol</label>
                    <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol">
                        @if (!(bool)ViewBag.EsSecretario) { <option value="0">Seleccione…</option> }
                    </select>
                    @if ((bool)ViewBag.EsSecretario)
                    {
                        <div class="form-text">Como secretario, solo puedes crear usuarios con rol Empleado.</div>
                    }
                    <span asp-validation-for="IdRol" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label">Nombre de usuario</label>
                    <input asp-for="Username" class="form-control" maxlength="50" autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" type="email" class="form-control" maxlength="100" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PasswordHash" class="form-label">Contraseña</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-line">Cancelar</a>
                <button type="submit" class="btn btn-brand">Crear usuario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
