@model Llanteria.Models.Pqrs
@{
    ViewData["Title"] = "Solicitud " + Model.Radicado;
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Solicitud " + Model.Radicado, Model.Tipo + " · " + Model.Asunto, "Pqrs", "Index"))

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-head">Lo que escribió el cliente</div>
            <div class="panel-body">
                <dl class="row mb-3">
                    <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4">Correo</dt><dd class="col-sm-8"><a href="mailto:@Model.Correo">@Model.Correo</a></dd>
                    <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Telefono) ? "—" : Model.Telefono)</dd>
                    <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">@(string.IsNullOrEmpty(Model.NumeroDocumento) ? "—" : Model.NumeroDocumento)</dd>
                    <dt class="col-sm-4">Radicada</dt><dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-4">Fecha límite</dt><dd class="col-sm-8">@Model.FechaLimite.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Autorizó datos</dt><dd class="col-sm-8">@(Model.AutorizaDatos ? "Sí" : "No")</dd>
                </dl>
                <p class="mb-0" style="white-space:pre-line">@Model.Mensaje</p>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-head">Respuesta</div>
            <div class="panel-body">
                <form asp-action="Responder" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="estado">Estado</label>
                        <select name="estado" id="estado" class="form-select">
                            @foreach (var e in Llanteria.Models.Pqrs.Estados) { <option value="@e" selected="@(Model.Estado == e)">@e</option> }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="respuesta">Respuesta al cliente</label>
                        <textarea name="respuesta" id="respuesta" rows="7" maxlength="1500" class="form-control" placeholder="Al marcarla como resuelta, el cliente recibe este texto por correo.">@Model.Respuesta</textarea>
                    </div>
                    @if (Model.FechaRespuesta.HasValue)
                    {
                        <p class="small text-muted">Resuelta el @Model.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm").</p>
                    }
                    <div class="form-actions">
                        <button type="submit" class="btn btn-brand">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
