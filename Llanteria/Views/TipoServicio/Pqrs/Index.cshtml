@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Pqrs>

@{
    ViewData["Title"] = "PQRS";
    string estado = ViewBag.Estado ?? "";
    string tipo = ViewBag.Tipo ?? "";
    string Clase(string e) => e switch { "Recibida" => "tag-warn", "En trámite" => "tag-neutral", _ => "tag-ok" };
}

@await Html.PartialAsync("_PageHeader", new PageHeader("PQRS", "Peticiones, quejas, reclamos y sugerencias de clientes."))

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><div class="label">Abiertas</div><div class="value">@ViewBag.Pendientes</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><div class="label">Fuera de plazo</div><div class="value">@ViewBag.Vencidas</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:260px" placeholder="Buscar radicado, nombre o asunto" />
            <select name="tipo" class="form-select form-select-sm" style="max-width:160px">
                <option value="">Todos los tipos</option>
                @foreach (var t in Llanteria.Models.Pqrs.Tipos) { <option value="@t" selected="@(tipo == t)">@t</option> }
            </select>
            <select name="estado" class="form-select form-select-sm" style="max-width:170px">
                <option value="">Todos los estados</option>
                @foreach (var e in Llanteria.Models.Pqrs.Estados) { <option value="@e" selected="@(estado == e)">@e</option> }
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>Radicado</th><th>Fecha</th><th>Tipo</th><th>Cliente</th><th>Asunto</th><th>Límite</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    var vencida = p.Estado != "Resuelta" && p.FechaLimite < DateTime.Today;
                    <tr>
                        <td class="cell-title">@p.Radicado</td>
                        <td class="money">@p.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td>@p.Tipo</td>
                        <td>@p.Nombre<div class="cell-sub">@p.Correo</div></td>
                        <td>@p.Asunto</td>
                        <td class="money">@p.FechaLimite.ToString("dd/MM/yyyy")@if (vencida) { <div class="cell-sub text-danger">Vencida</div> }</td>
                        <td><span class="tag @Clase(p.Estado)">@p.Estado</span></td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a class="icon-btn" title="Ver y responder" asp-action="Detalle" asp-route-id="@p.Id"><i class="fa-solid fa-eye"></i></a>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="empty-state">No hay solicitudes con esos filtros.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>
