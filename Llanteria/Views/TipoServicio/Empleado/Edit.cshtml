@model Llanteria.Models.Empleado

@{
    ViewData["Title"] = "Editar empleado";
    ViewData["Accion"] = "Edit";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Editar empleado", "Actualiza los datos del empleado.", "Empleado", "Index"))

<div class="panel panel-medium">
    <div class="panel-body">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
