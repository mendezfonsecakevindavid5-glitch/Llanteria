@model Llanteria.Models.Empleado

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-12 d-flex align-items-center gap-3">
            <img id="previewFoto" class="file-preview" alt="Foto"
                 src="@(Model.Id > 0 && Model.Foto != null ? Url.Action("Foto", new { id = Model.Id }) : Url.Content("~/images/productoos/default-producto.png"))" />
            <div class="flex-grow-1">
                <label class="form-label" for="fotoArchivo">Foto</label>
                <input id="fotoArchivo" name="fotoArchivo" type="file" class="form-control" accept="image/*" data-preview="#previewFoto" />
                <span class="text-danger small">@Html.ValidationMessage("fotoArchivo")</span>
            </div>
        </div>

        <div class="col-12"><div class="form-section">Documentos (uso interno, no se muestran en el sitio)</div></div>
        <div class="col-md-6 d-flex align-items-center gap-3">
            <img id="previewDocumento" class="file-preview" alt="Documento"
                 src="@(Model.Id > 0 && Model.FotoDocumento != null ? Url.Action("FotoDocumento", new { id = Model.Id }) : Url.Content("~/images/productoos/default-producto.png"))" />
            <div class="flex-grow-1">
                <label class="form-label" for="documentoArchivo">Foto del documento (cédula)</label>
                <input id="documentoArchivo" name="documentoArchivo" type="file" class="form-control" accept="image/*" data-preview="#previewDocumento" />
                <span class="text-danger small">@Html.ValidationMessage("documentoArchivo")</span>
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-center gap-3">
            <img id="previewRostro" class="file-preview" alt="Rostro"
                 src="@(Model.Id > 0 && Model.FotoRostro != null ? Url.Action("FotoRostro", new { id = Model.Id }) : Url.Content("~/images/productoos/default-producto.png"))" />
            <div class="flex-grow-1">
                <label class="form-label" for="rostroArchivo">Foto del rostro</label>
                <input id="rostroArchivo" name="rostroArchivo" type="file" class="form-control" accept="image/*" data-preview="#previewRostro" />
                <span class="text-danger small">@Html.ValidationMessage("rostroArchivo")</span>
            </div>
        </div>

        <div class="col-12"><div class="form-section">Datos personales</div></div>
        <div class="col-md-6">
            <label asp-for="Nombres" class="form-label">Nombres</label>
            <input asp-for="Nombres" class="form-control" maxlength="100" />
            <span asp-validation-for="Nombres" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Apellidos" class="form-label">Apellidos</label>
            <input asp-for="Apellidos" class="form-control" maxlength="100" />
            <span asp-validation-for="Apellidos" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="IdDocumento" class="form-label">Tipo de documento</label>
            <select asp-for="IdDocumento" class="form-select" asp-items="ViewBag.IdDocumento"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdDocumento" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="NumeroDocumento" class="form-label">Número de documento</label>
            <input asp-for="NumeroDocumento" class="form-control" maxlength="20" />
            <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="IdSexo" class="form-label">Sexo</label>
            <select asp-for="IdSexo" class="form-select" asp-items="ViewBag.IdSexo"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdSexo" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
            <input asp-for="FechaNacimiento" type="date" class="form-control" />
            <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Telefono" class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label asp-for="Correo" class="form-label">Correo</label>
            <input asp-for="Correo" type="email" class="form-control" maxlength="100" />
            <span asp-validation-for="Correo" class="text-danger small"></span>
        </div>

        <div class="col-12"><div class="form-section">Cargo</div></div>
        <div class="col-md-4">
            <label asp-for="IdRol" class="form-label">Rol</label>
            <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdRol" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Salario" class="form-label">Salario</label>
            <input asp-for="Salario" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="Salario" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Horario" class="form-label">Horario</label>
            <input asp-for="Horario" class="form-control" maxlength="100" placeholder="Lun–Vie 7:30–17:30" />
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
