@model Llanteria.Models.Marca

@{
    ViewData["Title"] = "Nueva marca";
    ViewData["Accion"] = "Create";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Nueva marca", "Registra un fabricante para el catálogo de productos.", "Marca", "Index"))

<div class="panel panel-narrow">
    <div class="panel-body">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
