@model IEnumerable<Llanteria.Models.Marca>

@{
    ViewData["Title"] = "Marcas";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Marcas", "Fabricantes de llantas y aceites registrados.", BotonTexto: "Nueva marca", BotonAction: "Create", BotonController: "Marca"))

<div class="panel panel-narrow">
    <table class="data-table">
        <thead>
            <tr>
                <th>Marca</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.OrderBy(x => x.Nombre))
            {
                <tr>
                    <td class="cell-title">@m.Nombre</td>
                    <td class="text-end">
                        <span class="row-actions">
                            <a asp-action="Edit" asp-route-id="@m.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                            <button type="button" class="icon-btn danger" title="Eliminar"
                                    data-delete="@Url.Action("Delete", new { id = m.Id })" data-nombre="@m.Nombre"
                                    data-aviso="No se puede eliminar si hay productos con esta marca."><i class="fa-solid fa-trash"></i></button>
                        </span>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="2" class="empty-state">Aún no hay marcas registradas.</td></tr>
            }
        </tbody>
    </table>
</div>
