@model IEnumerable<Llanteria.Models.Bodega>

@{
    ViewData["Title"] = "Bodegas";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Bodegas", "Lugares donde se almacena el inventario.", BotonTexto: "Nueva bodega", BotonAction: "Create", BotonController: "Bodega"))

<div class="panel">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Bodega</th>
                    <th>Ubicación</th>
                    <th class="text-end">Capacidad</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="cell-title">@b.NombreBodega</td>
                        <td>@(string.IsNullOrWhiteSpace(b.Ubicacion) ? "—" : b.Ubicacion)</td>
                        <td class="text-end">@(b.CapacidadMaxima?.ToString("N0") ?? "—")</td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a asp-action="Edit" asp-route-id="@b.Id" class="icon-btn" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="icon-btn danger" title="Eliminar"
                                        data-delete="@Url.Action("Delete", new { id = b.Id })" data-nombre="@b.NombreBodega"
                                        data-aviso="No se puede eliminar si tiene productos o inventario asociado."><i class="fa-solid fa-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="empty-state">Aún no hay bodegas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
