@model Llanteria.Models.TipoServicio
@{
    var icono = string.IsNullOrEmpty(Model.IconoPath) || Model.IconoPath.StartsWith("fa-") ? "default-servicio.png" : Model.IconoPath;
}

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="NombreServicio" class="form-label">Nombre del servicio</label>
            <input asp-for="NombreServicio" class="form-control" maxlength="100" autofocus />
            <span asp-validation-for="NombreServicio" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ValorServicio" class="form-label">Valor</label>
            <input asp-for="ValorServicio" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="ValorServicio" class="text-danger small"></span>
        </div>
        <div class="col-12 d-flex align-items-center gap-3">
            <img id="previewServicio" class="file-preview" src="~/images/servicios/@icono" alt="Imagen" />
            <div class="flex-grow-1">
                <label asp-for="ImagenArchivo" class="form-label">Imagen</label>
                <input asp-for="ImagenArchivo" type="file" class="form-control" accept="image/*" data-preview="#previewServicio" />
                <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
