@model Llanteria.Models.Gasto

@{
    ViewData["Title"] = "Nuevo Gasto";
}

<div class="container py-5" style="max-width: 800px;">

    <!-- ENCABEZADO -->
    <div class="mb-4 animate__animated animate__fadeIn">
        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
            <i class="fa-solid fa-arrow-left"></i> Volver a la Lista
        </a>
        <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-plus-circle text-danger"></i> Registrar Egreso Operativo
        </h2>
        <p class="text-muted small m-0">Ingresa los detalles de un nuevo gasto, su vencimiento y adjunta el soporte correspondiente.</p>
    </div>

    <!-- TARJETA DEL FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="card-body p-4 p-md-5 bg-white">

            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">

                    <!-- Categoría y Monto -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.IdCategoria" required></select>
                            <label asp-for="IdCategoria" class="fw-semibold text-muted">Categoría del Gasto</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Monto" type="number" step="0.01" class="form-control text-end fw-bold text-danger" placeholder="0" required />
                            <label asp-for="Monto" class="fw-semibold text-danger">Monto Total ($)</label>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Descripcion" class="form-control" placeholder="Concepto" required />
                            <label asp-for="Descripcion" class="fw-semibold text-muted">Concepto o Descripción</label>
                        </div>
                    </div>

                    <!-- Fechas y Estado -->
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="FechaVencimiento" type="date" class="form-control" required />
                            <label asp-for="FechaVencimiento" class="fw-semibold text-danger">Vencimiento</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="FechaPago" type="date" class="form-control" />
                            <label asp-for="FechaPago" class="fw-semibold text-success">Fecha de Pago</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select asp-for="Estado" class="form-select">
                                <option value="Pendiente">Pendiente</option>
                                <option value="Pagado">Pagado</option>
                                <option value="Vencido">Vencido</option>
                            </select>
                            <label asp-for="Estado" class="fw-semibold text-muted">Estado</label>
                        </div>
                    </div>

                    <!-- Archivo -->
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted ps-1">Adjuntar Comprobante (PDF/Imagen)</label>
                        <input type="file" name="Archivo" class="form-control py-3" />
                    </div>

                    <!-- BOTONES -->
                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-3 border">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
                            <i class="fa-solid fa-floppy-disk"></i> Registrar Gasto
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: 0.2s;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .form-control:focus, .form-select:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25px rgba(220, 53, 69, 0.25);
    }
</style>