@model Llanteria.Models.Gasto

@{
    ViewData["Title"] = "Editar Gasto";
}

<div class="container-fluid formulario-container">

    <!-- Encabezado -->
    <div class="formulario-header">
        <div>
            <a asp-action="Index" class="volver-panel">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver a la lista
            </a>

            <div class="titulo-con-icono">
                <div class="icono-formulario">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>

                <div>
                    <h1>EDITAR GASTO</h1>
                    <p>Actualiza el monto, vencimiento, estado y soporte digital del gasto.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario -->
    <div class="row">
        <div class="col-12 col-xl-9">
            <div class="formulario-card">

                <div class="formulario-card-header">
                    <div class="header-icono">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </div>

                    <div>
                        <h5>Información del egreso</h5>
                        <span>Modifica los datos necesarios y guarda los cambios.</span>
                    </div>
                </div>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Datos necesarios para conservar el registro -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FechaRegistro" />
                    <input type="hidden" asp-for="ArchivoSupport" />

                    @if (!string.IsNullOrEmpty(Model.ArchivoSupport))
                    {
                        <div class="soporte-actual mb-4">
                            <div class="soporte-archivo">
                                <div class="soporte-icono">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </div>

                                <div>
                                    <span class="soporte-titulo">Soporte actual</span>
                                    <span class="soporte-nombre">@Model.ArchivoSupport</span>
                                </div>
                            </div>

                            <a href="~/uploads/gastos/@Model.ArchivoSupport"
                               target="_blank"
                               class="btn-ver-soporte">
                                <i class="fa-solid fa-eye me-2"></i>Ver archivo
                            </a>
                        </div>
                    }

                    <div class="row g-4">

                        <!-- Categoría -->
                        <div class="col-md-6">
                            <label asp-for="IdCategoria" class="form-label label-formulario">
                                Categoría
                            </label>

                            <div class="input-con-icono">
                                <i class="fa-solid fa-tags"></i>

                                <select asp-for="IdCategoria"
                                        class="form-select input-formulario input-select"
                                        asp-items="ViewBag.IdCategoria">
                                </select>
                            </div>

                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>

                        <!-- Monto -->
                        <div class="col-md-6">
                            <label asp-for="Monto" class="form-label label-formulario">
                                Monto
                            </label>

                            <div class="input-con-icono input-monto">
                                <i class="fa-solid fa-dollar-sign"></i>

                                <input asp-for="Monto"
                                       class="form-control input-formulario monto-input"
                                       placeholder="0"
                                       inputmode="decimal" />
                            </div>

                            <span asp-validation-for="Monto" class="text-danger small"></span>
                        </div>

                        <!-- Fecha de vencimiento -->
                        <div class="col-md-4">
                            <label asp-for="FechaVencimiento" class="form-label label-formulario">
                                Vencimiento
                            </label>

                            <div class="input-con-icono">
                                <i class="fa-regular fa-calendar-days"></i>

                                <input asp-for="FechaVencimiento"
                                       type="date"
                                       class="form-control input-formulario" />
                            </div>

                            <span asp-validation-for="FechaVencimiento" class="text-danger small"></span>
                        </div>

                        <!-- Fecha de pago -->
                        <div class="col-md-4">
                            <label asp-for="FechaPago" class="form-label label-formulario">
                                Fecha de pago
                            </label>

                            <div class="input-con-icono">
                                <i class="fa-solid fa-calendar-check"></i>

                                <input asp-for="FechaPago"
                                       type="date"
                                       class="form-control input-formulario" />
                            </div>

                            <span asp-validation-for="FechaPago" class="text-danger small"></span>
                        </div>

                        <!-- Estado -->
                        <div class="col-md-4">
                            <label asp-for="Estado" class="form-label label-formulario">
                                Estado
                            </label>

                            <div class="input-con-icono">
                                <i class="fa-solid fa-circle-check"></i>

                                <select asp-for="Estado" class="form-select input-formulario input-select">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Pagado">Pagado</option>
                                </select>
                            </div>

                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>

                        <!-- Archivo nuevo -->
                        <div class="col-12">
                            <div class="archivo-seccion">
                                <label for="Archivo" class="form-label label-formulario">
                                    Reemplazar archivo de soporte
                                </label>

                                <span class="archivo-ayuda">
                                    Puedes cargar un archivo nuevo si deseas reemplazar el soporte actual.
                                </span>

                                <div class="archivo-input-wrapper">
                                    <i class="fa-solid fa-cloud-arrow-up"></i>

                                    <input type="file"
                                           id="Archivo"
                                           name="Archivo"
                                           class="form-control archivo-input" />
                                </div>
                            </div>
                        </div>

                        <!-- Acciones -->
                        <div class="col-12">
                            <div class="formulario-acciones">
                                <a asp-action="Index" class="btn-cancelar">
                                    <i class="fa-solid fa-xmark me-2"></i>Cancelar
                                </a>

                                <button type="submit" class="btn-guardar">
                                    <i class="fa-solid fa-floppy-disk me-2"></i>Actualizar Cambios
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: #f7f8fa;
        color: #222;
    }

    .formulario-container {
        max-width: 1500px;
        margin: 0 auto;
        padding: 22px 28px 40px;
    }

    .formulario-header {
        margin-bottom: 27px;
    }

    .volver-panel {
        display: inline-block;
        margin-bottom: 10px;
        color: #555;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: color .2s ease;
    }

    .volver-panel:hover {
        color: #c9250c;
    }

    .titulo-con-icono {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .icono-formulario {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: #c9250c;
        font-size: 31px;
    }

    .titulo-con-icono h1 {
        margin: 0;
        color: #20252b;
        font-size: 31px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .titulo-con-icono p {
        margin: 2px 0 0;
        color: #777;
        font-size: 14px;
    }

    .formulario-card {
        overflow: hidden;
        border: 1px solid #d9d9d9;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 2px 9px rgba(0, 0, 0, .05);
    }

    .formulario-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 24px;
        border-bottom: 1px solid #e2e2e2;
        background: #fff;
    }

    .header-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 39px;
        height: 39px;
        border-radius: 9px;
        background: #fff1ed;
        color: #c9250c;
        font-size: 17px;
    }

    .formulario-card-header h5 {
        margin: 0;
        color: #252525;
        font-size: 16px;
        font-weight: 800;
    }

    .formulario-card-header span {
        display: block;
        margin-top: 2px;
        color: #808080;
        font-size: 13px;
    }

    .formulario-card form {
        padding: 25px 24px;
    }

    .label-formulario {
        margin-bottom: 8px;
        color: #30343a;
        font-size: 14px;
        font-weight: 800;
    }

    .input-con-icono {
        position: relative;
    }

    .input-con-icono > i {
        position: absolute;
        top: 50%;
        left: 15px;
        z-index: 2;
        color: #808890;
        font-size: 15px;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .input-formulario {
        height: 46px;
        padding-left: 43px;
        border: 1px solid #d4d8dc;
        border-radius: 8px;
        color: #292d32;
        font-size: 14px;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .input-formulario:focus {
        border-color: #c9250c;
        box-shadow: 0 0 0 .2rem rgba(201, 37, 12, .10);
    }

    .input-select {
        padding-right: 38px;
    }

    .monto-input {
        padding-right: 14px;
        color: #c9250c;
        font-size: 15px;
        font-weight: 800;
        text-align: right;
    }

    .input-monto > i {
        color: #c9250c;
    }

    .soporte-actual {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 13px 15px;
        border: 1px solid #d7e7eb;
        border-radius: 10px;
        background: #f5fcfd;
    }

    .soporte-archivo {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 11px;
    }

    .soporte-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 8px;
        background: #e1f5f8;
        color: #13879c;
        font-size: 17px;
    }

    .soporte-titulo,
    .soporte-nombre {
        display: block;
    }

    .soporte-titulo {
        color: #4e5960;
        font-size: 12px;
        font-weight: 800;
    }

    .soporte-nombre {
        max-width: 430px;
        overflow: hidden;
        color: #69747a;
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-ver-soporte {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        min-height: 36px;
        padding: 8px 13px;
        border: 1px solid #13879c;
        border-radius: 7px;
        background: #fff;
        color: #13879c;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

    .btn-ver-soporte:hover {
        background: #13879c;
        color: #fff;
    }

    .archivo-seccion {
        padding: 18px;
        border: 1px dashed #c8ced3;
        border-radius: 10px;
        background: #fafbfc;
    }

    .archivo-ayuda {
        display: block;
        margin: -3px 0 12px;
        color: #7c838a;
        font-size: 12px;
    }

    .archivo-input-wrapper {
        position: relative;
    }

    .archivo-input-wrapper > i {
        position: absolute;
        top: 50%;
        left: 15px;
        z-index: 2;
        color: #808890;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .archivo-input {
        min-height: 46px;
        padding: 10px 12px 10px 42px;
        border: 1px solid #d4d8dc;
        border-radius: 8px;
        font-size: 13px;
    }

    .archivo-input:focus {
        border-color: #c9250c;
        box-shadow: 0 0 0 .2rem rgba(201, 37, 12, .10);
    }

    .formulario-acciones {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid #e3e5e7;
    }

    .btn-cancelar,
    .btn-guardar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

    .btn-cancelar {
        border: 1px solid #b8bec4;
        background: #fff;
        color: #5e646a;
    }

    .btn-cancelar:hover {
        border-color: #80878e;
        background: #f4f5f6;
        color: #30343a;
    }

    .btn-guardar {
        border: 1px solid #c9250c;
        background: #c9250c;
        color: #fff;
        box-shadow: 0 3px 7px rgba(201, 37, 12, .18);
    }

    .btn-guardar:hover {
        border-color: #a91d09;
        background: #a91d09;
        color: #fff;
        transform: translateY(-1px);
    }

    @@media (max-width: 768px) {
        .formulario-container {
            padding: 18px 12px 30px;
        }

        .titulo-con-icono h1 {
            font-size: 25px;
        }

        .formulario-card-header,
        .formulario-card form {
            padding-right: 18px;
            padding-left: 18px;
        }

        .soporte-actual {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-ver-soporte {
            width: 100%;
        }

        .soporte-nombre {
            max-width: 230px;
        }

        .formulario-acciones {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-cancelar,
        .btn-guardar {
            width: 100%;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}