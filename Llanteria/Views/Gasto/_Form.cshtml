@model Llanteria.Models.Gasto

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="IdCategoria" class="form-label">Categoría</label>
            <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.IdCategoria">
                <option value="0">Seleccione…</option>
            </select>
            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Monto" class="form-label">Monto</label>
            <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Monto" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <input asp-for="Descripcion" class="form-control" maxlength="200" />
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="FechaVencimiento" class="form-label">Fecha de vencimiento</label>
            <input asp-for="FechaVencimiento" type="date" class="form-control" />
            <span asp-validation-for="FechaVencimiento" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="FechaPago" class="form-label">Fecha de pago</label>
            <input asp-for="FechaPago" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option value="Pendiente">Pendiente</option>
                <option value="Pagado">Pagado</option>
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="soporte">Soporte (PDF o imagen)</label>
            <input id="soporte" name="soporte" type="file" class="form-control" accept=".pdf,image/*" />
            <span class="text-danger small" data-valmsg-for="soporte">@Html.ValidationMessage("soporte")</span>
            @if (!string.IsNullOrEmpty(Model.ArchivoSupport))
            {
                <div class="form-text">Soporte actual: <a href="~/uploads/gastos/@Model.ArchivoSupport" target="_blank">ver archivo</a>. Si subes otro, lo reemplaza.</div>
            }
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
