@model IEnumerable<Llanteria.Models.Gasto>

@{
    ViewData["Title"] = "Control de Egresos";
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0">
                <i class="fa-solid fa-file-invoice-dollar text-danger"></i> Control de Egresos
            </h2>
            <p class="text-muted small m-0">Gestión de gastos operativos, vencimientos y soportes de pago.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
            <i class="fa-solid fa-plus-circle"></i> Nuevo Gasto
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">Categoría / Detalle</th>
                        <th class="py-3">Vencimiento</th>
                        <th class="text-end py-3">Monto</th>
                        <th class="text-center py-3">Estado</th>
                        <th class="text-center py-3">Soporte</th>
                        <th class="text-center py-3 pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var item in Model)
                    {
                        <tr style="height: 70px;">
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.IdCategoriaNavigation?.Nombre</div>
                                <div class="text-muted small" style="margin-top: 2px;">@item.Descripcion</div>
                            </td>
                            <td>
                                <span class="@(item.FechaVencimiento < DateOnly.FromDateTime(DateTime.Now) && item.Estado != "Pagado" ? "text-danger fw-bold" : "text-dark")">
                                    <i class="fa-regular fa-calendar-alt me-1"></i> @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td class="text-end fw-bold text-danger pe-3">
                                $ @item.Monto.ToString("N0")
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.Estado == "Pagado" ? "bg-success" : "bg-warning text-dark") px-3 py-2 rounded-pill">
                                    @item.Estado
                                </span>
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ArchivoSupport))
                                {
                                    <a href="~/uploads/gastos/@item.ArchivoSupport" target="_blank" class="btn btn-outline-info btn-sm rounded-2">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </a>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-2">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-2" onclick="confirmarEliminar(@item.Id, '@item.Descripcion')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* "Aire" para la tabla: aumenta la distancia entre filas */
    .table td {
        padding: 15px !important;
    }

    .rounded-xl {
        border-radius: 12px !important;
    }

    .transition-transform {
        transition: 0.2s;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }
</style>

@section Scripts {
    <script>
        function confirmarEliminar(id, desc) {
            Swal.fire({
                title: '¿Eliminar registro?',
                text: "Se borrará el gasto: " + desc,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Gasto/Delete/' + id;
                }
            })
        }
    </script>
}