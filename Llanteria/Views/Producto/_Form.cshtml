@model Llanteria.Models.Producto
@{
    var imagen = string.IsNullOrEmpty(Model.RutaImagen) ? "default-producto.png" : Model.RutaImagen;
    var categorias = new[] { "Llantas", "Aceites", "Baterías", "Accesorios", "Otros" };
}

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" maxlength="150" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Categoria" class="form-label">Categoría</label>
            <select asp-for="Categoria" class="form-select" asp-items="@(new SelectList(categorias, Model.Categoria ?? "Llantas"))"></select>
        </div>
        <div class="col-12">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="IdProveedor" class="form-label">Proveedor</label>
            <select asp-for="IdProveedor" class="form-select" asp-items="ViewBag.IdProveedor">
                <option value="0">Seleccione…</option>
            </select>
            <span asp-validation-for="IdProveedor" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="IdBodega" class="form-label">Bodega</label>
            <select asp-for="IdBodega" class="form-select" asp-items="ViewBag.IdBodega">
                <option value="0">Seleccione…</option>
            </select>
            <span asp-validation-for="IdBodega" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PrecioCompra" class="form-label">Precio de compra</label>
            <input asp-for="PrecioCompra" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="PrecioCompra" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PrecioVenta" class="form-label">Precio de venta</label>
            <input asp-for="PrecioVenta" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
        </div>

        <div class="col-12"><div class="form-section">Ficha técnica (opcional)</div></div>
        <div class="col-md-4">
            <label class="form-label" for="DetalleProducto_IdMarca">Marca</label>
            <select asp-for="DetalleProducto.IdMarca" class="form-select" asp-items="ViewBag.IdMarca">
                <option value="0">Sin marca</option>
            </select>
            <span asp-validation-for="DetalleProducto.IdMarca" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="DetalleProducto_TipoVehiculo">Vehículo</label>
            <select asp-for="DetalleProducto.TipoVehiculo" class="form-select" asp-items="@(new SelectList(Llanteria.Models.TiposVehiculo.Todos, Model.DetalleProducto?.TipoVehiculo ?? "Auto"))"></select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="DetalleProducto_Ancho">Ancho</label>
            <input asp-for="DetalleProducto.Ancho" class="form-control" placeholder="205" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="DetalleProducto_Perfil">Perfil</label>
            <input asp-for="DetalleProducto.Perfil" class="form-control" placeholder="55" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="DetalleProducto_Diametro">Rin</label>
            <input asp-for="DetalleProducto.Diametro" class="form-control" placeholder="16" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="DetalleProducto_GarantiaMeses">Garantía (meses)</label>
            <input asp-for="DetalleProducto.GarantiaMeses" type="number" min="0" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="DetalleProducto_Viscosidad">Viscosidad (aceites)</label>
            <input asp-for="DetalleProducto.Viscosidad" class="form-control" placeholder="5W-30" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="DetalleProducto_TipoAceite">Tipo de aceite</label>
            <input asp-for="DetalleProducto.TipoAceite" class="form-control" placeholder="Sintético" />
        </div>

        <div class="col-12"><div class="form-section">Imagen</div></div>
        <div class="col-12 d-flex align-items-center gap-3">
            <img id="previewImagen" class="file-preview" src="~/images/productoos/@imagen" alt="Vista previa" />
            <div class="flex-grow-1">
                <input asp-for="ImagenArchivo" type="file" class="form-control" accept="image/*" data-preview="#previewImagen" />
                <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                <div class="form-text">Se optimiza automáticamente. Déjalo vacío para conservar la imagen actual.</div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar</button>
    </div>
</form>
