@model IEnumerable<Llanteria.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-boxes-stacked text-primary"></i> Catálogo de Productos
            </h2>
            <p class="text-muted small m-0">Gestiona el inventario disponible, precios de compra, venta y visualización física.</p>
        </div>

        <a asp-controller="Producto" asp-action="Create" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
            <i class="fa-solid fa-plus"></i> Registrar Nuevo
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small tracking-wider" style="background-color: #1a1e21;">
                    <tr>
                        <th scope="col" class="ps-4" style="width: 100px;">Imagen</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col" class="text-end">P. Compra</th>
                        <th scope="col" class="text-end">P. Venta</th>
                        <th scope="col" class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="rounded-3 overflow-hidden border bg-light shadow-sm d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <img src="/images/llantas/@(item.Id).jpg"
                                             class="img-fluid"
                                             style="object-fit: cover; width: 100%; height: 100%;"
                                             alt="@item.Nombre"
                                             onerror="this.src='https://images.unsplash.com/photo-1578844251758-2f71da64c96f?q=80&w=150'">
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark">@item.Nombre</span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 small rounded-pill">
                                        @item.Categoria
                                    </span>
                                </td>

                                <td class="text-end fw-semibold text-muted">
                                    $@String.Format("{0:N0}", item.PrecioCompra)
                                </td>

                                <td class="text-end fw-bold text-success">
                                    $@String.Format("{0:N0}", item.PrecioVenta)
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-2" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-2" title="Detalles">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-2" title="Eliminar">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open display-4 mb-3 d-block text-secondary"></i>
                                <span class="fw-semibold">No hay productos registrados en este momento.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .table method th {
        border-bottom: none;
    }
</style>