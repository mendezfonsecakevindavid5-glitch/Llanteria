@model IEnumerable<Llanteria.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container py-5" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeIn">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-boxes-stacked" style="color: #C92B0A;"></i> Catálogo de Productos
            </h2>
            <p class="text-muted small m-0">Gestiona el inventario disponible, precios de compra, venta y visualización física.</p>
        </div>

        <a asp-controller="Producto" asp-action="Create" class="btn text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform" style="background-color: #C92B0A; border: none;">
            <i class="fa-solid fa-plus"></i> Registrar Nuevo
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden animate__animated animate__fadeInUp">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-white text-uppercase small tracking-wider" style="background-color: #000000;">
                    <tr>
                        <th scope="col" class="ps-4 text-center" style="width: 110px;">Imagen</th>
                        <th scope="col">Nombre del Artículo</th>
                        <th scope="col">Proveedor</th>
                        <th scope="col" class="text-end" style="width: 150px;">P. Compra</th>
                        <th scope="col" class="text-end" style="width: 150px;">P. Venta</th>
                        <th scope="col" class="text-center" style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-center">
                                    <div class="rounded-3 overflow-hidden border bg-light shadow-sm d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <img src="@Url.Content("~/images/productos/" + (string.IsNullOrEmpty(item.Categoria) || item.Categoria.Contains(" ") ? "default-producto.png" : item.Categoria))"
                                             class="w-100 h-100 object-fit-cover"
                                             alt="@item.Nombre"
                                             onerror="this.src='/images/productos/default-producto.png';" />
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark d-block fs-6">@item.Nombre</span>
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        <small class="text-muted text-truncate d-block" style="max-width: 320px;">@item.Descripcion</small>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 small fw-semibold">
                                        <i class="fa-solid fa-industry me-1 text-secondary"></i>
                                        @(item.IdProveedorNavigation?.NombreEmpresa ?? "Sin Asignar")
                                    </span>
                                </td>

                                <td class="text-end fw-semibold text-muted fs-6">
                                    $@item.PrecioCompra.ToString("N0")
                                </td>

                                <td class="text-end fw-bold fs-6" style="color: #C92B0A;">
                                    $@item.PrecioVenta.ToString("N0")
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-2" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-2" title="Detalles">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-2" title="Eliminar" onclick="confirmarEliminar(@item.Id, '@item.Nombre')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open display-4 mb-3 d-block text-secondary"></i>
                                <span class="fw-semibold">No hay productos registrados en este momento.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .rounded-xl {
        border-radius: 12px !important;
    }

    .hover-left:hover {
        transform: translateX(-4px);
    }

    .transition-transform {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }

    .object-fit-cover {
        object-fit: cover;
    }
</style>

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar producto?',
                text: "Se removerá del catálogo: \"" + nombre + "\". Esta acción quitará la imagen física del servidor y no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#C92B0A',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                customClass: {
                    popup: 'rounded-3'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Producto/Delete/' + id;
                }
            })
        }
    </script>
}