@model Llanteria.Models.Producto

@{
    ViewData["Title"] = "Nuevo producto";
    ViewData["Accion"] = "Create";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Nuevo producto", "Registra una llanta, aceite u otro artículo del inventario.", "Producto", "Index"))

<div class="panel panel-medium">
    <div class="panel-body">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
