@model Llanteria.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
            <i class="fa-solid fa-arrow-left"></i> Volver al Inventario
        </a>
        <h2 class="fw-black text-dark text-uppercase m-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-box-open" style="color: #C92B0A;"></i> Registrar Nuevo Producto
        </h2>
        <p class="text-muted small m-0">Ingresa las especificaciones del artículo, costos de compra, venta y carga su fotografía oficial.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4">
                    <div class="col-12 d-flex align-items-center gap-3 bg-light p-3 rounded-3 border mb-2">
                        <div class="rounded-3 border bg-white shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 80px; height: 80px; flex-shrink: 0;">
                            <img id="previewImagen" src="/images/productos/default-producto.png" class="w-100 h-100 object-fit-cover" alt="Previsualización" />
                        </div>
                        <div>
                            <span class="badge text-white text-uppercase px-2 py-1 mb-1" style="font-size: 0.7rem; background-color: #C92B0A;">Nuevo Artículo</span>
                            <h6 class="m-0 fw-bold text-dark" id="previewNombre">Esperando nombre del producto...</h6>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="form-floating">
                            <input asp-for="Nombre" id="inputNombre" class="form-control" placeholder="Nombre" required />
                            <label asp-for="Nombre" class="fw-semibold text-muted">Nombre del Producto / Llanta</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <select asp-for="IdProveedor" class="form-select" asp-items="ViewBag.IdProveedor" required></select>
                            <label asp-for="IdProveedor">Proveedor</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Descripcion" class="form-control" placeholder="Descripción" style="height: 100px;"></textarea>
                            <label asp-for="Descripcion" class="fw-semibold text-muted">Descripción Breve o Medidas</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="PrecioCompra" type="number" step="0.01" class="form-control text-end" placeholder="0" required />
                            <label asp-for="PrecioCompra" class="fw-semibold text-muted">Precio Compra ($)</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="PrecioVenta" type="number" step="0.01" class="form-control text-end fw-bold text-dark" placeholder="0" required />
                            <label asp-for="PrecioVenta" class="fw-semibold text-muted">Precio Venta Público ($)</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-2 bg-white h-100 d-flex flex-column justify-content-center">
                            <label asp-for="ImagenArchivo" class="form-label small fw-semibold text-muted mb-1">Imagen del Producto</label>
                            <input asp-for="ImagenArchivo" id="inputImagenFile" type="file" class="form-control form-control-sm" accept="image/*" />
                        </div>
                    </div>

                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-3 border">Cancelar</a>
                        <button type="submit" class="btn text-white fw-bold px-4 py-2 rounded-3 shadow-sm" style="background-color: #C92B0A; border: none;">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar Producto
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("inputImagenFile").addEventListener("change", function(e) {
            const preview = document.getElementById("previewImagen");
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) { preview.src = event.target.result; }
                reader.readAsDataURL(file);
            } else {
                preview.src = "/images/productos/default-producto.png";
            }
        });

        document.getElementById("inputNombre").addEventListener("input", function(e) {
            document.getElementById("previewNombre").innerText = e.target.value.trim() === "" ? "Esperando nombre..." : e.target.value;
        });
    </script>
}