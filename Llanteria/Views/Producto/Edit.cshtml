@model Llanteria.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
            <i class="fa-solid fa-arrow-left"></i> Volver al Catálogo
        </a>
        <h2 class="fw-black text-dark text-uppercase m-0">Modificar Producto</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-12 d-flex align-items-center gap-3 bg-light p-3 rounded-3 border">
                        <div class="rounded-3 border bg-white shadow-sm overflow-hidden" style="width: 75px; height: 75px;">
                            <img id="previewImagen" src="~/images/Productos/@(string.IsNullOrEmpty(Model.RutaImagen) ? "default-producto.png" : Model.RutaImagen)"
                                 class="w-100 h-100 object-fit-cover" onerror="this.src='/images/productos/default-producto.png';" />
                        </div>
                        <div>
                            <span class="badge bg-dark text-uppercase px-2 py-1">ID: #@Model.Id</span>
                            <h6 class="m-0 fw-bold text-dark" id="previewNombre">Modificando: @Model.Nombre</h6>
                        </div>
                    </div>

                    <div class="col-md-8"><div class="form-floating"><input asp-for="Nombre" id="inputNombre" class="form-control" required /><label>Nombre del Producto</label></div></div>
                    <div class="col-md-4"><div class="form-floating"><select asp-for="IdProveedor" class="form-select" asp-items="ViewBag.IdProveedor"></select><label>Proveedor</label></div></div>

                    <div class="col-12">
                        <div class="card bg-light border-0">
                            <div class="card-body p-3">
                                <h6 class="text-muted text-uppercase mb-3 small"><i class="fa-solid fa-gears"></i> Especificaciones Técnicas</h6>
                                <div class="row g-2">
                                    <div class="col-md-2"><div class="form-floating"><input asp-for="DetalleProducto.Ancho" class="form-control" placeholder="Ancho" /><label>Ancho</label></div></div>
                                    <div class="col-md-2"><div class="form-floating"><input asp-for="DetalleProducto.Perfil" class="form-control" placeholder="Perfil" /><label>Perfil</label></div></div>
                                    <div class="col-md-2"><div class="form-floating"><input asp-for="DetalleProducto.Diametro" class="form-control" placeholder="Diám" /><label>Diám</label></div></div>
                                    <div class="col-md-3"><div class="form-floating"><input asp-for="DetalleProducto.Viscosidad" class="form-control" placeholder="Visc" /><label>Viscosidad</label></div></div>
                                    <div class="col-md-3"><div class="form-floating"><input asp-for="DetalleProducto.GarantiaMeses" class="form-control" placeholder="Garantía" /><label>Garantía</label></div></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6"><div class="form-floating"><input asp-for="PrecioCompra" type="number" step="0.01" class="form-control" required /><label>Precio Compra ($)</label></div></div>
                    <div class="col-md-6"><div class="form-floating"><input asp-for="PrecioVenta" type="number" step="0.01" class="form-control" required /><label>Precio Venta ($)</label></div></div>

                    <div class="col-12">
                        <label class="small fw-semibold text-muted mb-1">Cambiar Imagen</label>
                        <input asp-for="ImagenArchivo" id="inputImagenFile" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                        <button type="submit" class="btn text-white px-4" style="background-color: #C92B0A;">Actualizar Cambios</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("inputImagenFile").addEventListener("change", function(e) {
            const preview = document.getElementById("previewImagen");
            if (e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) { preview.src = event.target.result; }
                reader.readAsDataURL(e.target.files[0]);
            }
        });
        document.getElementById("inputNombre").addEventListener("input", function(e) {
            document.getElementById("previewNombre").innerText = "Modificando: " + (e.target.value || "...");
        });
    </script>
}