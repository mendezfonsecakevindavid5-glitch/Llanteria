@{
    ViewData["Title"] = "Contacto - Llantería";
}

<section class="py-5" style="background-color: #f8f9fa; min-height: 80vh;">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="fw-black text-uppercase text-dark m-0">Ponte en Contacto</h2>
            <p class="text-muted">Escríbenos tus dudas o sugerencias y te responderemos al correo de inmediato.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow p-4 rounded-3 bg-white">
                    <form asp-controller="Contacto" asp-action="EnviarMensaje" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="formName" name="Nombre" placeholder="Tu nombre" required />
                                    <label for="formName">Nombre Completo</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="formEmail" name="Correo" placeholder="correo@ejemplo.com" required />
                                    <label for="formEmail">Correo Electrónico</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="formSubject" name="Asunto" placeholder="Asunto" required />
                                    <label for="formSubject">Asunto o Vehículo</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" id="formMessage" name="Mensaje" placeholder="Tu mensaje aquí" style="height: 150px;" required></textarea>
                                    <label for="formMessage">¿En qué podemos ayudarte?</label>
                                </div>
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-dark px-5 py-3 fw-bold text-uppercase shadow-sm" style="background-color: #C92B0A; border: none;">
                                    Enviar Mensaje Profesional
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["MensajeEnviado"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: '¡Mensaje Enviado!',
                    text: 'Tu consulta ha sido recibida con éxito. Revisa tu bandeja de entrada pronto.',
                    icon: 'success',
                    confirmButtonColor: '#C92B0A',
                    confirmButtonText: 'Entendido'
                });
            });
        </script>
    }

    @if (TempData["ErrorCorreo"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: 'Error al enviar',
                    text: 'No se pudo despachar el correo. Verifica tu configuración SMTP.',
                    icon: 'error',
                    confirmButtonColor: '#000000',
                    confirmButtonText: 'Reintentar'
                });
            });
        </script>
    }
}