@model Llanteria.Models.Articulo
@{
    var portada = string.IsNullOrEmpty(Model.Imagen) ? Llanteria.Models.Articulo.ImagenPorDefecto : Model.Imagen;
}

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Titulo" class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" maxlength="200" />
            <span asp-validation-for="Titulo" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Resumen" class="form-label">Resumen</label>
            <textarea asp-for="Resumen" class="form-control" rows="2" maxlength="400"></textarea>
            <div class="form-text">Se muestra en la lista del blog y en Google. Máximo 400 caracteres.</div>
            <span asp-validation-for="Resumen" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Categoria" class="form-label">Categoría</label>
            <select asp-for="Categoria" class="form-select" asp-items="ViewBag.Categorias"><option value="">Elige…</option></select>
            <span asp-validation-for="Categoria" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Fecha" class="form-label">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Fecha" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Autor" class="form-label">Autor</label>
            <input asp-for="Autor" class="form-control" maxlength="100" />
            <span asp-validation-for="Autor" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Slug" class="form-label">Dirección del artículo</label>
            <div class="input-group">
                <span class="input-group-text">/Blog/</span>
                <input asp-for="Slug" class="form-control" maxlength="120" placeholder="Se genera sola a partir del título" />
            </div>
            <span asp-validation-for="Slug" class="text-danger small"></span>
        </div>

        <div class="col-12"><div class="form-section">Portada</div></div>
        <div class="col-12 d-flex align-items-center gap-3">
            <img id="previewPortada" class="file-preview" style="width:120px" src="~/images/blog/@portada" alt="Vista previa de la portada" />
            <div class="flex-grow-1">
                <input asp-for="ImagenArchivo" type="file" class="form-control" accept="image/*" data-preview="#previewPortada" />
                <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
                <div class="form-text">Mejor horizontal (por ejemplo 1200 × 630). Déjalo vacío para conservar la portada actual.</div>
            </div>
        </div>

        <div class="col-12"><div class="form-section">Contenido</div></div>
        <div class="col-12">
            <textarea asp-for="Contenido" class="form-control" rows="16" aria-label="Contenido del artículo"></textarea>
            <span asp-validation-for="Contenido" class="text-danger small"></span>
            <div class="form-text">
                Una línea en blanco separa los párrafos. Marcas: <code>## Título de sección</code> · <code>- Viñeta</code> · <code>&gt; Recuadro destacado</code> · <code>**negrita**</code>.
            </div>
        </div>
        <div class="col-12">
            <div class="form-check form-switch">
                <input asp-for="Publicado" class="form-check-input" role="switch" />
                <label asp-for="Publicado" class="form-check-label">Publicado en el sitio</label>
            </div>
            <div class="form-text">Si lo desactivas, queda como borrador y solo tú lo ves.</div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar artículo</button>
    </div>
</form>
