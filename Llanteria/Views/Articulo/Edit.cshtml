@model Llanteria.Models.Articulo

@{
    ViewData["Title"] = "Editar artículo";
    ViewData["Accion"] = "Edit";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Editar artículo", "Cambia el texto, la portada o el estado de publicación.", "Articulo", "Index"))

<div class="panel panel-medium">
    <div class="panel-body">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
