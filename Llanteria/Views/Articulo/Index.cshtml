@using Llanteria.Infrastructure
@model Paginado<Llanteria.Models.Articulo>

@{
    ViewData["Title"] = "Blog";
    string estado = ViewBag.Estado ?? "";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Blog", "Escribe y edita los artículos que se muestran en el sitio.", BotonTexto: "Nuevo artículo", BotonAction: "Create", BotonController: "Articulo"))

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3"><div class="stat accent"><span class="stat-icon"><i class="fa-solid fa-newspaper"></i></span><div class="label">Publicados</div><div class="value">@ViewBag.Publicados</div></div></div>
    <div class="col-sm-6 col-lg-3"><div class="stat"><span class="stat-icon"><i class="fa-solid fa-pen-ruler"></i></span><div class="label">Borradores</div><div class="value">@ViewBag.Borradores</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <form method="get" class="d-flex gap-2 flex-wrap w-100">
            <input name="buscar" value="@ViewBag.Buscar" type="search" class="form-control form-control-sm" style="max-width:280px" placeholder="Buscar por título, categoría o autor" />
            <select name="estado" class="form-select form-select-sm" style="max-width:170px">
                <option value="">Todos</option>
                <option value="publicados" selected="@(estado == "publicados")">Publicados</option>
                <option value="borradores" selected="@(estado == "borradores")">Borradores</option>
            </select>
            <button class="btn btn-line btn-sm">Filtrar</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th></th><th>Artículo</th><th>Categoría</th><th>Fecha</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td><img class="thumb" src="~/images/blog/@(string.IsNullOrEmpty(a.Imagen) ? Llanteria.Models.Articulo.ImagenPorDefecto : a.Imagen)" alt="" /></td>
                        <td>
                            <div class="cell-title">@a.Titulo</div>
                            <div class="cell-sub">/Blog/@a.Slug · @a.Autor</div>
                        </td>
                        <td>@a.Categoria</td>
                        <td class="money">@a.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><span class="tag @(a.Publicado ? "tag-ok" : "tag-neutral")">@(a.Publicado ? "Publicado" : "Borrador")</span></td>
                        <td class="text-end">
                            <span class="row-actions">
                                <a class="icon-btn" title="Ver en el sitio" target="_blank" rel="noopener" asp-controller="Blog" asp-action="Detalle" asp-route-slug="@a.Slug"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                                <a class="icon-btn" title="Editar" asp-action="Edit" asp-route-id="@a.Id"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="CambiarPublicacion" asp-route-id="@a.Id" method="post" class="d-inline">
                                    <button class="icon-btn" type="submit" title="@(a.Publicado ? "Pasar a borrador" : "Publicar")"><i class="fa-solid @(a.Publicado ? "fa-eye-slash" : "fa-eye")"></i></button>
                                </form>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <button type="button" class="icon-btn danger" title="Eliminar" data-delete="@Url.Action("Delete", new { id = a.Id })" data-nombre="@a.Titulo"><i class="fa-solid fa-trash"></i></button>
                                }
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="empty-state">No hay artículos con esos filtros. Crea el primero con «Nuevo artículo».</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Paginacion", (Model.Pagina, Model.TotalPaginas, Model.Total))
</div>
