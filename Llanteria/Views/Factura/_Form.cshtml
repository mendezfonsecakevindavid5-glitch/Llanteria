@model Llanteria.Models.FacturaFormViewModel

<form asp-action="@ViewData["Accion"]" asp-route-id="@(Model.Id == 0 ? null : Model.Id.ToString())" method="post" id="formFactura">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="IdCliente" class="form-label">Cliente</label>
            <select asp-for="IdCliente" class="form-select" asp-items="ViewBag.IdCliente"><option value="0">Seleccione…</option></select>
            <span asp-validation-for="IdCliente" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Fecha" class="form-label">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control" />
            <span asp-validation-for="Fecha" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-section mt-3">Productos y servicios</div>
    <div class="table-responsive">
        <table class="data-table" id="tablaLineas">
            <thead>
                <tr>
                    <th style="width:120px">Tipo</th>
                    <th>Ítem</th>
                    <th style="width:90px">Cant.</th>
                    <th style="width:150px">Valor unitario</th>
                    <th class="text-end" style="width:140px">Subtotal</th>
                    <th style="width:44px"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <button type="button" id="btnLinea" class="btn btn-line btn-sm mt-2"><i class="fa-solid fa-plus me-1"></i>Agregar línea</button>

    <div class="row justify-content-end mt-3">
        <div class="col-md-5">
            <dl class="detail-list" style="grid-template-columns:1fr auto">
                <dt>Subtotal</dt><dd class="money text-end" id="tBruto">$0</dd>
                <dt class="align-self-center">IVA <button type="button" class="btn btn-line btn-sm py-0 ms-1" id="btnIva" title="Calcular 19 % del subtotal">19 %</button></dt>
                <dd><input asp-for="Iva" id="iva" type="number" step="0.01" min="0" class="form-control form-control-sm text-end" /></dd>
                <dt class="align-self-center">Retención en la fuente</dt>
                <dd><input asp-for="RteFte" id="rte" type="number" step="0.01" min="0" class="form-control form-control-sm text-end" /></dd>
                <dt class="fw-bold">Total a pagar</dt><dd class="money text-end fw-bold fs-5" id="tTotal">$0</dd>
            </dl>
        </div>
    </div>

    <div class="mt-2">
        <label asp-for="Observaciones" class="form-label">Observaciones</label>
        <textarea asp-for="Observaciones" class="form-control" rows="2" maxlength="500"></textarea>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-line">Cancelar</a>
        <button type="submit" class="btn btn-brand">Guardar factura</button>
    </div>
</form>

<script>
    (function () {
        const productos = @Json.Serialize(ViewBag.Productos);
        const servicios = @Json.Serialize(ViewBag.Servicios);
        const iniciales = @Json.Serialize(Model.Lineas);
        const tbody = document.querySelector('#tablaLineas tbody');
        const fmt = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
        const num = el => parseFloat(el.value) || 0;

        function opciones(tipo, sel) {
            const lista = tipo === 'S' ? servicios : productos;
            return '<option value="0">Seleccione…</option>' + lista.map(function (x) {
                const extra = tipo === 'P' && x.stock !== null ? ' (stock ' + x.stock + ')' : '';
                const t = document.createElement('div'); t.textContent = x.nombre + extra;
                return '<option value="' + x.id + '"' + (x.id === sel ? ' selected' : '') + '>' + t.innerHTML + '</option>';
            }).join('');
        }

        function agregar(l) {
            l = l || { tipo: 'P', idItem: 0, cantidad: 1, valorUnitario: 0 };
            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td><select class="form-select form-select-sm l-tipo"><option value="P">Producto</option><option value="S">Servicio</option></select></td>' +
                '<td><select class="form-select form-select-sm l-item"></select></td>' +
                '<td><input type="number" min="1" step="1" class="form-control form-control-sm l-cant" /></td>' +
                '<td><input type="number" min="0" step="0.01" class="form-control form-control-sm l-valor" /></td>' +
                '<td class="text-end money l-sub">$0</td>' +
                '<td><button type="button" class="icon-btn danger l-quitar" title="Quitar"><i class="fa-solid fa-xmark"></i></button></td>';
            tbody.appendChild(tr);
            tr.querySelector('.l-tipo').value = l.tipo;
            tr.querySelector('.l-item').innerHTML = opciones(l.tipo, l.idItem);
            tr.querySelector('.l-cant').value = l.cantidad;
            tr.querySelector('.l-valor').value = l.valorUnitario;
            calcular();
        }

        function calcular() {
            let bruto = 0;
            tbody.querySelectorAll('tr').forEach(function (tr) {
                const sub = num(tr.querySelector('.l-cant')) * num(tr.querySelector('.l-valor'));
                tr.querySelector('.l-sub').textContent = fmt.format(sub);
                bruto += sub;
            });
            document.getElementById('tBruto').textContent = fmt.format(bruto);
            document.getElementById('tTotal').textContent = fmt.format(bruto + num(document.getElementById('iva')) - num(document.getElementById('rte')));
            return bruto;
        }

        tbody.addEventListener('change', function (e) {
            const tr = e.target.closest('tr');
            if (e.target.classList.contains('l-tipo')) {
                tr.querySelector('.l-item').innerHTML = opciones(e.target.value, 0);
                tr.querySelector('.l-valor').value = 0;
            } else if (e.target.classList.contains('l-item')) {
                const lista = tr.querySelector('.l-tipo').value === 'S' ? servicios : productos;
                const x = lista.find(i => i.id === parseInt(e.target.value, 10));
                tr.querySelector('.l-valor').value = x ? x.precio : 0;
            }
            calcular();
        });
        tbody.addEventListener('input', calcular);
        tbody.addEventListener('click', function (e) {
            if (!e.target.closest('.l-quitar')) return;
            e.target.closest('tr').remove();
            if (!tbody.children.length) agregar();
            calcular();
        });
        document.getElementById('btnLinea').addEventListener('click', () => agregar());
        document.getElementById('iva').addEventListener('input', calcular);
        document.getElementById('rte').addEventListener('input', calcular);
        document.getElementById('btnIva').addEventListener('click', function () {
            document.getElementById('iva').value = (calcular() * 0.19).toFixed(2);
            calcular();
        });

        // Los nombres Lineas[n].campo se asignan al enviar, así quitar filas no deja huecos en el índice.
        document.getElementById('formFactura').addEventListener('submit', function () {
            tbody.querySelectorAll('tr').forEach(function (tr, i) {
                tr.querySelector('.l-tipo').name = 'Lineas[' + i + '].Tipo';
                tr.querySelector('.l-item').name = 'Lineas[' + i + '].IdItem';
                tr.querySelector('.l-cant').name = 'Lineas[' + i + '].Cantidad';
                tr.querySelector('.l-valor').name = 'Lineas[' + i + '].ValorUnitario';
            });
        });

        (iniciales.length ? iniciales : [null]).forEach(l => agregar(l));
    })();
</script>
