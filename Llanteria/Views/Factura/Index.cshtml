@model IEnumerable<Llanteria.Models.Factura>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="container py-5" style="max-width: 1200px;">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none small fw-bold d-inline-flex align-items-center gap-2 mb-2 transition-transform hover-left">
                <i class="fa-solid fa-arrow-left"></i> Volver al Panel
            </a>
            <h2 class="fw-black text-dark text-uppercase m-0">
                <i class="fa-solid fa-file-invoice-dollar text-success"></i> Facturas de Ventas
            </h2>
            <p class="text-muted small m-0">Historial de transacciones, clientes atendidos y totales generados.</p>
        </div>
        <a asp-action="Create" class="btn btn-success fw-bold px-4 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 transition-transform">
            <i class="fa-solid fa-plus"></i> Nueva Venta
        </a>
    </div>

    <!-- TABLA CON ESPACIADO PROFESIONAL -->
    <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">Nro. Factura</th>
                        <th class="py-3">Fecha</th>
                        <th class="py-3">Cliente</th>
                        <th class="text-end py-3">Subtotal</th>
                        <th class="text-end py-3">IVA</th>
                        <th class="text-end py-3">Total a Pagar</th>
                        <th class="text-center py-3 pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var item in Model)
                    {
                        <tr style="height: 70px;">
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border font-monospace px-2"># @item.Id</span>
                            </td>
                            <td class="text-muted small">
                                <i class="fa-regular fa-calendar me-1"></i> @(item.Fecha?.ToString("dd/MM/yyyy") ?? "N/A")
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.IdClienteNavigation?.Nombres @item.IdClienteNavigation?.Apellidos</div>
                            </td>
                            <td class="text-end text-muted">$ @item.TotalBruto.ToString("N0")</td>
                            <td class="text-end text-muted">$ @item.Iva.ToString("N0")</td>
                            <td class="text-end fw-bold text-success pe-3 fs-6">$ @item.TotalPagar.ToString("N0")</td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-2" title="Detalles">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-2" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table td {
        padding: 15px !important;
    }

    .rounded-xl {
        border-radius: 12px !important;
    }

    .transition-transform {
        transition: 0.2s;
    }

        .transition-transform:hover {
            transform: translateY(-2px);
        }
</style>