@model Llanteria.Models.Factura

@{
    ViewData["Title"] = $"Factura #{Model.Id}";
}

@await Html.PartialAsync("_PageHeader", new PageHeader($"Factura #{Model.Id}", Model.Fecha?.ToString("dd 'de' MMMM 'de' yyyy") ?? "", "Factura", "Index"))

<div class="panel panel-medium">
    <div class="panel-body">
        <dl class="detail-list">
            <dt>Cliente</dt><dd>@Model.IdClienteNavigation?.Nombres @Model.IdClienteNavigation?.Apellidos</dd>
            <dt>Subtotal</dt><dd class="money">@Model.TotalBruto.ToString("C0")</dd>
            <dt>IVA</dt><dd class="money">@Model.Iva.ToString("C0")</dd>
            <dt>Retención</dt><dd class="money">@((Model.RteFte ?? 0).ToString("C0"))</dd>
            <dt>Total pagado</dt><dd class="money fw-bold">@Model.TotalPagar.ToString("C0")</dd>
            <dt>Puntos</dt><dd>@((int)(Model.TotalPagar / 1000)) puntos</dd>
            <dt>Observaciones</dt><dd>@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</dd>
        </dl>
    </div>
    @if (Model.DetalleFacturas.Any())
    {
        <table class="data-table">
            <thead><tr><th>Descripción</th><th class="text-end">Cant.</th><th class="text-end">Unitario</th><th class="text-end">Subtotal</th></tr></thead>
            <tbody>
                @foreach (var d in Model.DetalleFacturas)
                {
                    <tr>
                        <td>@d.Descripción</td>
                        <td class="text-end">@d.Cantidad</td>
                        <td class="text-end money">@d.ValorUnitario.ToString("C0")</td>
                        <td class="text-end money">@d.Subtotal.ToString("C0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div class="panel-body border-top d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-line">Editar</a>
    </div>
</div>
