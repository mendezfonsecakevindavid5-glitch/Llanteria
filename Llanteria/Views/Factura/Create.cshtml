@model Llanteria.Models.FacturaFormViewModel

@{
    ViewData["Title"] = "Nueva factura";
    ViewData["Accion"] = "Create";
}

@await Html.PartialAsync("_PageHeader", new PageHeader("Nueva factura", "Agrega los productos y servicios vendidos. El stock y los puntos se actualizan solos.", "Factura", "Index"))

@if (ViewBag.SinDetalle == true)
{
    <div class="alert alert-warning small">Esta factura se registró solo con totales (total anterior: @(((decimal)ViewBag.TotalAnterior).ToString("C0"))). Agrega las líneas para reemplazarlos.</div>
}

<div class="panel">
    <div class="panel-body">
        <partial name="_Form" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
